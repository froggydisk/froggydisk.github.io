---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import StarBackground from '../components/StarBackground.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/editorial.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  isPost?: boolean;
  showStars?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | null;
  /** 본문 폭 제한(--measure)을 풀어 다단 레이아웃을 허용한다 (책) */
  wide?: boolean;
  /** 이 페이지에서 나가는 이동을 뷰 트랜지션으로 처리한다 (책 섹션 전용) */
  transitions?: boolean;
}

const SITE_NAME = 'froggydisk';
const DEFAULT_DESCRIPTION =
  'Frontend, DevOps, ML/DL 관련 기술 블로그. 개발 과정에서의 문제 해결과 새로운 기술을 기록합니다.';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image = '/img/profile.png',
  isPost = false,
  showStars = true,
  publishedTime,
  modifiedTime,
  noindex = false,
  jsonLd = null,
  wide = false,
  transitions = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const isDefaultImage = image === '/img/profile.png';
const pageTitle = `${title} - ${SITE_NAME}`;
// JSON.stringify는 '<'를 그대로 두므로 제목 등에 </script>가 들어오면 스크립트를 탈출할 수 있다
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : null;
---

<!DOCTYPE html>
<html lang="ko-KR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  {noindex
    ? <meta name="robots" content="noindex, follow" />
    : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
  <meta name="author" content={SITE_NAME} />

  <!-- Open Graph -->
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="ko_KR" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={imageURL} />
  <meta property="og:image:alt" content={title} />
  {isDefaultImage && (
    <>
      <meta property="og:image:width" content="640" />
      <meta property="og:image:height" content="640" />
    </>
  )}
  <meta property="og:type" content={isPost ? 'article' : 'website'} />
  {isPost && publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {isPost && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
  {isPost && <meta property="article:author" content={SITE_NAME} />}

  <!-- Twitter -->
  <meta name="twitter:card" content={isDefaultImage ? 'summary' : 'summary_large_image'} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageURL} />

  <!-- Favicons -->
  <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png" />
  <link rel="icon" href="/favicons/favicon.ico" sizes="any" />
  <link rel="manifest" href="/favicons/site.webmanifest" />
  <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={new URL('/rss.xml', Astro.site)} />
  <meta name="theme-color" content="#faf9f5" id="theme-color-meta" />
  <script is:inline>
    (function() {
      var t = localStorage.getItem('theme');
      var m = document.getElementById('theme-color-meta');
      if (t === 'dark') m.setAttribute('content', '#191816');
    })();
  </script>

  <!-- Fonts -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link
    rel="stylesheet"
    crossorigin="anonymous"
    integrity="sha384-GIdEBaqGN9mNkDkMkzMHW8EKUqtpPIe/sLj1X7DIrnc9uPtLROJgmuDlh+3rBw0j"
    href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
  />

  <!-- AdSense -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4715878791193779" crossorigin="anonymous"></script>

  {jsonLdText && <script type="application/ld+json" set:html={jsonLdText} />}

  {transitions && <ClientRouter />}
</head>

<body>
  {showStars && <StarBackground />}
  <script is:inline>
    const theme = localStorage.getItem('theme');
    var themeColorMeta = document.getElementById('theme-color-meta');
    if (theme === 'dark') {
      document.body.setAttribute('data-theme', 'dark');
      themeColorMeta.setAttribute('content', '#191816');
    } else {
      themeColorMeta.setAttribute('content', '#faf9f5');
    }
  </script>
  {transitions && (
    <script is:inline>
      // 뷰 트랜지션 스왑은 body 속성까지 새 문서 것으로 바꾼다.
      // data-theme이 날아가 라이트로 번쩍이므로 페인트 전에 다시 씌운다.
      document.addEventListener('astro:after-swap', function () {
        if (localStorage.getItem('theme') === 'dark') {
          document.body.setAttribute('data-theme', 'dark');
        } else {
          document.body.removeAttribute('data-theme');
        }
      });
    </script>
  )}
  <Navbar currentPath={Astro.url.pathname} />
  <div class:list={['wrapper', { post: isPost, 'wrapper-wide': wide }]}>
    <main class:list={[wide ? 'wide-main' : 'page-content']} aria-label="Content">
      <slot />
    </main>
    <Footer />
  </div>
  <script is:inline>
    // 본문 그림이 화면에 들어오면 그 자리에서 등장 애니메이션을 한 번 재생한다.
    // 초기 상태(opacity:0)를 CSS 가 아니라 여기서 붙이는 이유: JS 나 IntersectionObserver 가
    // 없으면 그림이 영구히 안 보이게 된다. 클래스를 못 붙이면 그냥 정적으로 보이는 편이 낫다.
    (function () {
      // 뷰 트랜지션 스왑 때 이 인라인 스크립트가 다시 실행돼도 리스너를 겹치지 않는다.
      if (window.__dgReveal) return;
      window.__dgReveal = true;
      if (!('IntersectionObserver' in window)) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      // rootMargin 으로 화면 아래를 18% 잘라내, 그림이 화면 맨 아래에 걸친 순간이 아니라
      // 읽는 자리로 올라왔을 때 시작하게 한다.
      var io = new IntersectionObserver(function (entries) {
        for (var i = 0; i < entries.length; i++) {
          if (!entries[i].isIntersecting) continue;
          entries[i].target.classList.add('dg-in');
          io.unobserve(entries[i].target);
        }
      }, { threshold: 0.25, rootMargin: '0px 0px -18% 0px' });

      function scan() {
        var els = document.querySelectorAll(
          '.page-content div:has(> svg):not(.diagram-zoom__zoomed)'
        );
        for (var i = 0; i < els.length; i++) {
          if (els[i].dataset.dgReveal) continue;   // 멱등
          els[i].dataset.dgReveal = '1';
          els[i].classList.add('dg-reveal');
          io.observe(els[i]);
        }
      }
      scan();
      // ClientRouter 가 없는 페이지에서는 astro:page-load 가 안 오므로 위에서 이미 한 번 돌았다.
      document.addEventListener('astro:page-load', scan);
    })();
  </script>
</body>
</html>
