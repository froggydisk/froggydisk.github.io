---
import BaseLayout from '../layouts/BaseLayout.astro';
import MoodySplitView from '../components/diagrams/MoodySplitView.astro';
import { pageJsonLd } from '../utils/seo';

// 카드는 영상만 보여주고, 설명은 누르면 뜨는 dialog 안에 있다.
// dialog 내용도 서버에서 렌더링하므로 HTML에 그대로 들어가 pagefind가 색인한다.
interface Project {
  slug: string;
  title: string;
  category: string;
  year: string;
  icon: string;
  /** 카드 영상. 없으면 poster만 보인다 */
  video?: string;
  poster?: string;
  body: string;
  note?: string;
  link?: { href: string; label: string };
  duties: string[];
  /** 팀 작업이면 true. 목록 제목이 '담당'이 되고, 아니면 '1인 제작'이다 */
  team?: boolean;
  tags: string[];
  /** 영상 대신 쓸 인터랙티브 그림. 카드에는 제품 뷰만 꽉 채우고, 모달에는 두 패널을 모두 넣는다 */
  figure?: 'moody';
}

const projects: Project[] = [
  {
    slug: 'look-up-lens',
    title: 'Look Up Lens',
    category: 'Interaction',
    year: '2026',
    icon: '/img/look-up-lens-icon.webp',
    video: '/img/projects/look-up-lens.mp4',
    poster: '/img/projects/look-up-lens.webp',
    body: '커서가 지나가는 자리에만 AR 렌즈의 홀로그램 HUD가 드러나는 제품 히어로.',
    note: '인물 이미지는 AI 생성',
    link: { href: 'https://gallery-lime-chi.vercel.app/augmented-hero.html', label: '데모' },
    duties: [
      '맨 얼굴 · HUD 두 장을 겹치고 radial-gradient 마스크로 커서 아래만 드러내기',
      '버튼 하나로 마스크를 뒤집어 커서 아래만 홀로그램이 꺼지게',
      '동심원 호 위에 스펙 수치를 그리고 눈금이 도는 SVG',
    ],
    tags: ['CSS Mask', 'SVG', 'JavaScript', 'HTML Video'],
  },
  {
    slug: 'flight-quest',
    title: 'Isle of Embers',
    category: 'Scroll Experience',
    year: '2026',
    icon: '/img/flight-quest-icon.webp',
    video: '/img/projects/flight-quest.mp4',
    poster: '/img/projects/flight-quest.webp',
    body: '스크롤로 해안 마을에서 화산 분화구까지 한 번에 날아가는 판타지 비행 랜딩 페이지.',
    link: { href: 'https://gallery-lime-chi.vercel.app/flight-quest.html', label: '데모' },
    duties: [
      '스크롤 한 번에 다음 지점으로 미끄러지는 정거장 스크롤',
      '비행 영상을 그대로 재생하고 스크롤이 따라가게 해 끊김 제거',
      '퀘스트 · 나침반 · 미니맵 · 고도와 속도를 담은 게임 HUD',
    ],
    tags: ['HTML Video', 'JavaScript', 'CSS'],
  },
  {
    slug: 'i-see-you',
    title: 'I SEE YOU',
    category: 'Interaction',
    year: '2026',
    icon: '/img/gaze-footer-icon.webp',
    video: '/img/projects/i-see-you.mp4',
    poster: '/img/projects/i-see-you.webp',
    body: '커서 방향에 맞는 영상 프레임을 골라, 캐릭터가 커서를 바라보게 하는 푸터.',
    note: '캐릭터 영상은 AI 생성',
    link: { href: 'https://gallery-lime-chi.vercel.app/footer-gaze.html', label: '데모' },
    duties: [
      '각도 → 영상 시간 표로 시선 스크러빙',
      '프레임을 건너뛰지 않는 이징 · seek 게이트',
      '한 바퀴 구간 추출 · 선명화 · 인코딩',
    ],
    tags: ['HTML Video', 'JavaScript', 'ffmpeg', 'NumPy'],
  },
  {
    slug: 'gc-symbol',
    title: 'GC Symbol Study',
    category: 'WebGL',
    year: '2026',
    icon: '/img/gc-icon.webp',
    video: '/img/projects/gc-symbol.mp4',
    poster: '/img/projects/gc-symbol.webp',
    body: 'SVG 로고를 3D로 압출하고, 커서·스크롤에 반응하는 이리데선트 셰이더를 입힌 심볼.',
    note: '모션 참고: <a href="https://oryzo.ai/" target="_blank" rel="noopener noreferrer">oryzo.ai</a>',
    link: { href: 'https://gallery-lime-chi.vercel.app/gc-logo-intro.html', label: '데모' },
    duties: [
      'SVG → ExtrudeGeometry 3D 변환',
      '박막 간섭 컬러 + 이중 스페큘러 셰이더',
      '3프레임 주기 큐브맵 갱신으로 120fps',
    ],
    tags: ['Three.js', 'GLSL', 'WebGL'],
  },
  {
    slug: 'moody',
    title: 'Moody',
    category: 'Hardware · App',
    year: '2025',
    icon: '/img/moody-icon.webp',
    body: '지금 듣는 Spotify 곡의 앨범 아트를 띄우는 10.1인치 디지털 액자.',
    duties: [
      'BLE 기기 탐색 · WiFi 설정',
      'Spotify OAuth 2.0 (PKCE)',
      '기기 상태 실시간 모니터링',
    ],
    tags: ['Flutter', 'Riverpod', 'BLE', 'Spotify API'],
    figure: 'moody',
    team: true,
  },
  {
    slug: 'econix',
    title: 'econix',
    category: 'Data Platform',
    year: '2025',
    icon: '/img/econix-icon.png',
    video: '/img/projects/econix.mp4',
    poster: '/img/projects/econix.webp',
    body: '경제 데이터를 모아 LLM으로 분석하고, 8개 언어 대시보드와 리포트로 내는 플랫폼.',
    link: { href: 'https://econix.ai.kr', label: '사이트' },
    duties: [
      'Next.js 14 다국어 대시보드',
      'Fed · 매크로 · 시장 · 뉴스 수집 파이프라인',
      'LLM 리포트 생성 · Threads 자동 발행',
    ],
    tags: ['Next.js', 'TypeScript', 'Supabase', 'Python', 'LLM'],
  },
];

const description =
  'froggydisk가 직접 만든 사이드 프로젝트 모음 — WebGL 심볼 실험, 데이터 시각화, 사내 도구까지 구현 과정과 담당 범위를 정리했습니다.';
// 프로젝트마다 고유 URL이 없어(dialog로 열린다) ItemList는 달지 않는다
const jsonLd = pageJsonLd({ type: 'CollectionPage', path: '/projects/', name: 'Projects', description });
---

<BaseLayout
  title="Projects"
  description={description}
  jsonLd={jsonLd}
  showStars={false}
  transitions
  wide
>
  <div class="pj-shell">
    <header class="pj-head">
      <h1 class="pj-title">Projects</h1>
    </header>

    <ul class="pj-grid">
      {projects.map((p, i) => (
        <li class="pj-item">
          <button
            class="pj-card"
            type="button"
            data-pj-open={p.slug}
            aria-haspopup="dialog"
          >
            <span class:list={['pj-media', { 'pj-media--figure': p.figure }]}>
              {p.figure === 'moody' ? (
                <MoodySplitView />
              ) : p.video ? (
                <video
                  class="pj-video"
                  muted
                  loop
                  playsinline
                  preload="none"
                  poster={p.poster}
                  data-pj-video
                >
                  <source src={p.video} type="video/mp4" />
                </video>
              ) : (
                <img class="pj-video" src={p.poster} alt="" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
              )}
              <span class="pj-more" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
              </span>
            </span>
            <span class="pj-caption">
              <img class="pj-icon" src={p.icon} alt="" width="36" height="36" loading="lazy" decoding="async" />
              <span class="pj-names">
                <span class="pj-name">{p.title}</span>
                <span class="pj-cat">{p.category}</span>
              </span>
              <span class="pj-year">{p.year}</span>
            </span>
          </button>
        </li>
      ))}
    </ul>
  </div>

  {projects.map((p) => (
    <dialog class="pj-dialog" id={`pj-${p.slug}`} aria-labelledby={`pj-${p.slug}-title`}>
      <div class="pj-sheet">
        <button class="pj-close" type="button" data-pj-close aria-label="닫기">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
        </button>

        {p.figure === 'moody' ? (
          <div class="pj-sheet-media pj-sheet-media--figure">
            <MoodySplitView />
          </div>
        ) : (
          <div class="pj-sheet-media">
            {p.video ? (
              <video class="pj-sheet-video" muted loop playsinline preload="none" poster={p.poster} data-pj-video>
                <source src={p.video} type="video/mp4" />
              </video>
            ) : (
              <img class="pj-sheet-video" src={p.poster} alt="" loading="lazy" decoding="async" />
            )}
          </div>
        )}

        <div class="pj-sheet-body">
          <div class="pj-sheet-head">
            <img class="pj-sheet-icon" src={p.icon} alt={`${p.title} 아이콘`} width="56" height="56" loading="lazy" decoding="async" />
            <div>
              <p class="pj-sheet-cat">{p.category} · {p.year}</p>
              <h2 class="pj-sheet-title" id={`pj-${p.slug}-title`}>{p.title}</h2>
            </div>
          </div>

          <p class="pj-sheet-text">{p.body}</p>
          {p.note && <p class="pj-sheet-note" set:html={p.note} />}

          <div class="pj-sheet-grid">
            <div>
              <h3 class="pj-sheet-label">{p.team ? '담당' : '1인 제작'}</h3>
              <ul class="pj-duties">
                {p.duties.map((d) => <li>{d}</li>)}
              </ul>
            </div>
            <div>
              <h3 class="pj-sheet-label">스택</h3>
              <div class="pj-tags">
                {p.tags.map((t) => <span class="pj-tag">{t}</span>)}
              </div>
            </div>
          </div>

          {p.link && (
            <a class="pj-cta" href={p.link.href} target="_blank" rel="noopener noreferrer">
              {p.link.label}
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
            </a>
          )}
        </div>
      </div>
    </dialog>
  ))}
</BaseLayout>

<script>
  // ClientRouter가 걸린 페이지다. 모듈 스크립트는 스왑 뒤 다시 돌지 않으므로
  // 클릭은 document에 위임하고, 영상 관찰은 astro:page-load마다 멱등하게 다시 건다.
  const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let io: IntersectionObserver | null = null;

  function play(v: HTMLVideoElement) {
    if (reduced()) return;
    if (v.preload === 'none') v.preload = 'auto';
    v.play().catch(() => {});
  }

  function watch() {
    io?.disconnect();
    const cards = document.querySelectorAll<HTMLVideoElement>('.pj-grid video[data-pj-video]');
    if (!cards.length) return;
    io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) play(v);
          else v.pause();
        }
      },
      { threshold: 0.25 },
    );
    cards.forEach((v) => io!.observe(v));
  }

  function open(slug: string) {
    const d = document.getElementById(`pj-${slug}`) as HTMLDialogElement | null;
    if (!d || d.open) return;
    d.showModal();
    document.documentElement.classList.add('pj-lock');
    // 시트가 화면을 덮는 동안 뒤의 카드 영상은 쉬게 한다
    document.querySelectorAll<HTMLVideoElement>('.pj-grid video').forEach((v) => v.pause());
    io?.disconnect();
    const v = d.querySelector<HTMLVideoElement>('video[data-pj-video]');
    if (v) play(v);
  }

  if (!(window as any).__pjBound) {
    (window as any).__pjBound = true;

    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const opener = t.closest<HTMLElement>('[data-pj-open]');
      if (opener) {
        open(opener.dataset.pjOpen!);
        return;
      }
      const d = t.closest<HTMLDialogElement>('dialog.pj-dialog');
      if (!d) return;
      // 시트 바깥(backdrop)을 누르면 이벤트 대상이 dialog 자신이다
      if (t === d || t.closest('[data-pj-close]')) d.close();
    });

    // Esc로 닫혀도 close 이벤트는 온다. 영상 정지와 스크롤 잠금 해제를 여기서 한 번에 한다
    document.addEventListener(
      'close',
      (e) => {
        const d = e.target as HTMLElement;
        if (!d.matches?.('dialog.pj-dialog')) return;
        d.querySelector<HTMLVideoElement>('video')?.pause();
        document.documentElement.classList.remove('pj-lock');
        watch();
      },
      true,
    );

    document.addEventListener('astro:before-swap', () => {
      document.documentElement.classList.remove('pj-lock');
    });
    document.addEventListener('astro:page-load', watch);
  }
  watch();
</script>

<style>
/* 기본 .wrapper는 본문 폭(672px)이다. 이 페이지만 카드 두 열이 들어가도록 넓힌다.
   book.css의 .wrapper-wide 규칙은 책 페이지에서만 로드되므로 여기서 따로 준다. */
:global(.wrapper.wrapper-wide) {
  max-width: 1120px;
}
:global(html.pj-lock) {
  overflow: hidden;
}

.pj-shell {
  padding-bottom: 5rem;
}

.pj-head {
  margin: 5rem 0 2.5rem;
}
.pj-title {
  font-size: clamp(2.2rem, 1.4rem + 3vw, 3.4rem);
  font-weight: 600;
  letter-spacing: -0.03em;
  line-height: 1.05;
  margin: 0;
  color: var(--ink);
}

.pj-grid {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 44px 28px;
}
.pj-item {
  margin: 0;
  padding: 0;
}
.pj-item::before {
  content: none !important;
}

.pj-card {
  all: unset;
  display: block;
  width: 100%;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}
.pj-card:focus-visible .pj-media {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
}

.pj-media {
  position: relative;
  display: block;
  aspect-ratio: 16 / 10;
  border-radius: 14px;
  overflow: hidden;
  background: #0e0d0c;
  /* 사파리가 border-radius + overflow 안에서 transform 중인 video 모서리를 잘못 자르는 것을 막는다 */
  isolation: isolate;
  box-shadow: 0 0 0 1px var(--rule);
}
.pj-media--figure {
  background: var(--bg);
}
/* Moody는 영상 대신 원래의 두 패널(제품 뷰 · 도면)을 나란히 돌린다.
   컴포넌트는 좁은 화면에서 패널을 세로로 쌓지만 카드 안에서는 넘치므로 항상 가로로 둔다 */
.pj-media--figure :global(.moody-split) {
  position: absolute;
  inset: 0;
  margin: 0;
  padding: 0 14px;
  flex-direction: row;
  align-items: center;
  /* 그림은 매 프레임 SVG를 새로 그린다. 누르는 사이 커서 밑 도형이 바뀌면 click이 성립하지 않아
     카드 가운데(액자 위)를 눌러도 모달이 안 떴다. 클릭은 그림을 통과해 카드 버튼이 받게 한다 */
  pointer-events: none;
}
.pj-media--figure :global(.moody-split__panel) {
  border: 0;
  border-radius: 0;
  background: transparent;
}
/* 액자 뒤 조명은 위·왼쪽 끝에서도 0이 아니라 SVG 경계에서 직선으로 끊긴다.
   테두리가 있는 모달에서는 묻히지만 테두리 없는 카드에서는 모서리가 드러나므로 끈다 */
.pj-media--figure :global(.pv-glow) {
  display: none;
}
.pj-media--figure :global(.moody-split text) {
  font-size: 30px;
}
.pj-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  margin: 0;
  border-radius: 0;
  transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
}
.pj-card:hover .pj-video {
  transform: scale(1.035);
}

.pj-more {
  position: absolute;
  right: 14px;
  bottom: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  color: #141413;
  background: rgba(250, 249, 245, 0.92);
  -webkit-backdrop-filter: blur(8px);
  backdrop-filter: blur(8px);
  opacity: 0;
  transform: translateY(6px);
  transition: opacity 0.3s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}
.pj-card:hover .pj-more,
.pj-card:focus-visible .pj-more {
  opacity: 1;
  transform: none;
}

.pj-caption {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 16px;
}
.pj-icon {
  width: 36px;
  height: 36px;
  border-radius: 9px;
  object-fit: cover;
  margin: 0;
  flex: none;
}
.pj-names {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}
.pj-name {
  font-size: 17px;
  font-weight: 600;
  letter-spacing: -0.01em;
  color: var(--ink);
  line-height: 1.3;
}
.pj-cat {
  font-size: 13px;
  color: var(--muted);
  line-height: 1.4;
}
.pj-year {
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--muted);
}

/* ---------- dialog ---------- */

.pj-dialog {
  margin: auto;
  padding: 0;
  border: 0;
  width: min(920px, calc(100vw - 32px));
  max-width: none;
  max-height: calc(100dvh - 48px);
  border-radius: 18px;
  background: var(--bg);
  color: var(--body);
  overflow: hidden;
  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
}
.pj-dialog[open] {
  animation: pj-in 0.42s cubic-bezier(0.16, 1, 0.3, 1);
}
.pj-dialog::backdrop {
  background: rgba(10, 9, 8, 0.72);
  -webkit-backdrop-filter: blur(6px);
  backdrop-filter: blur(6px);
}
.pj-dialog[open]::backdrop {
  animation: pj-fade 0.3s ease;
}
@keyframes pj-in {
  from { opacity: 0; transform: translateY(18px) scale(0.97); }
}
@keyframes pj-fade {
  from { opacity: 0; }
}
@media (prefers-reduced-motion: reduce) {
  .pj-dialog[open],
  .pj-dialog[open]::backdrop { animation: none; }
  .pj-video { transition: none; }
}

.pj-sheet {
  position: relative;
  max-height: calc(100dvh - 48px);
  overflow-y: auto;
  overscroll-behavior: contain;
}

.pj-close {
  position: sticky;
  top: 14px;
  float: right;
  margin: 14px 14px -58px 0;
  z-index: 2;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 0;
  color: #fff;
  background: rgba(20, 20, 19, 0.55);
  -webkit-backdrop-filter: blur(8px);
  backdrop-filter: blur(8px);
  cursor: pointer;
}
