---
import { getCollection, render } from 'astro:content';
import PostLayout from '../layouts/PostLayout.astro';
import { postSlug, postDate, parseTags, modifiedDate, excerpt } from '../utils/seo';

export async function getStaticPaths() {
  const posts = (await getCollection('blog'))
    .sort((a, b) => a.id.slice(0, 10).localeCompare(b.id.slice(0, 10)));

  return posts.map((post, i) => {
    const prevPost = i > 0 ? posts[i - 1] : null;
    const nextPost = i < posts.length - 1 ? posts[i + 1] : null;

    return {
      params: { slug: postSlug(post.id) },
      props: {
        post,
        prev: prevPost ? { title: prevPost.data.title, slug: postSlug(prevPost.id) } : null,
        next: nextPost ? { title: nextPost.data.title, slug: postSlug(nextPost.id) } : null,
      },
    };
  });
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);

const slug = postSlug(post.id);
const date = postDate(post.id);
const modified = modifiedDate(post.id, post.data.last_modified_at);
const tags = parseTags(post.data.tags);
const description = post.data.description?.trim() || excerpt(post.body ?? '');
---

<PostLayout
  title={post.data.title}
  description={description}
  date={date}
  modified={modified}
  canonicalPath={`/${slug}/`}
  image={post.data.image}
  tags={tags}
  comments={post.data.comments}
  toc={post.data.toc}
  use_math={post.data.use_math}
  prev={prev}
  next={next}
>
  <Content />
</PostLayout>
