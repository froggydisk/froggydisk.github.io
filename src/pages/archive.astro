---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import PostItem from '../components/PostItem.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => {
    const dateA = a.id.slice(0, 10);
    const dateB = b.id.slice(0, 10);
    return dateB.localeCompare(dateA);
  });
---

<BaseLayout
  title="Archive"
  description={`froggydisk 기술 블로그의 전체 글 ${posts.length}편 목록. 프론트엔드, 쿠버네티스·DevOps, ML/DL 문제 해결 기록을 검색하고 연도순으로 훑어볼 수 있습니다.`}
  showStars={false}
  transitions
>
  <header class="header" style="margin-bottom: 2em;">
    <h1 class="header-title">Archive</h1>
  </header>

  <div class="search-article">
    <div id="search">
      <label for="search-fallback">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position:absolute; left:12px; top:12px; opacity:0.5;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </label>
      <input type="search" id="search-fallback" placeholder="Search posts..." />
    </div>
  </div>

  {posts.map((post) => <PostItem post={post} showTag />)}
</BaseLayout>

{import.meta.env.PROD && <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />}

<script is:inline define:vars={{ isProd: import.meta.env.PROD }}>
  function attachFallback() {
    var fallback = document.getElementById('search-fallback');
    if (!fallback || fallback.dataset.ready) return;
    fallback.dataset.ready = '1';
    fallback.addEventListener('input', function() {
      var query = this.value.toLowerCase().trim();
      document.querySelectorAll('.post-item').forEach(function(item) {
        var title = item.querySelector('.post-item-title').textContent.toLowerCase();
        var tags = (item.getAttribute('data-tags') || '').toLowerCase();
        var hit = !query || title.includes(query) || tags.includes(query);
        item.style.display = hit ? '' : 'none';
      });
    });
  }

  async function initSearch() {
    var el = document.getElementById('search');
    if (!el || el.dataset.ready) return;
    el.dataset.ready = '1';
    if (!isProd) {
      attachFallback();
      return;
    }
    try {
      await import('/pagefind/pagefind-ui.js');
      el.innerHTML = '';
      new PagefindUI({ element: '#search', showSubResults: true, showImages: false });
    } catch (e) {
      attachFallback();
    }
  }
  // 뷰 트랜지션 스왑 뒤에도 새 노드에 다시 붙여야 한다.
  // dataset.ready 플래그는 노드에 붙으므로 스왑되면 자연히 초기화된다.
  initSearch();
  document.addEventListener('astro:page-load', initSearch);
</script>

<style>
  :global(.pagefind-ui) {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: #6b6a63;
    --pagefind-ui-text: #2b2a26;
    --pagefind-ui-background: #faf9f5;
    --pagefind-ui-border: #e3e0d8;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 5px;
    --pagefind-ui-font: 'Pretendard Variable', Pretendard, Roboto, sans-serif;
  }

  :global(body[data-theme="dark"] .pagefind-ui) {
    --pagefind-ui-primary: #918e84;
    --pagefind-ui-text: #dedbd0;
    --pagefind-ui-background: #191816;
    --pagefind-ui-border: #2d2b26;
  }
</style>
