---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const firstYear = posts.map((p) => p.id.slice(0, 4)).sort()[0];

const description =
  'froggydisk를 쓰는 소프트웨어 엔지니어 소개와 연락처. 개발하다 막힌 문제와 해결 과정을 기록합니다.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: 'froggydisk',
    alternateName: 'Dr.frog',
    jobTitle: 'Software Engineer',
    description: '서버 인프라 구축과 AI 모델 개발을 해온 소프트웨어 엔지니어',
    url: 'https://froggydisk.github.io/about/',
    email: 'mailto:sewoomkim93@gmail.com',
    sameAs: ['https://github.com/froggydisk', 'https://velog.io/@frog'],
    knowsAbout: ['React Native', 'Next.js', 'Kubernetes', 'DevOps', 'PyTorch', 'Machine Learning'],
  },
};
---

<BaseLayout title="About" description={description} showStars={false} jsonLd={jsonLd}>
  <header class="header">
    <h1 class="header-title">About</h1>
  </header>

  <div class="page-content">
    <p>
      커브컴퍼니의 소프트웨어 엔지니어로서 QA에서 시작해 현재는 서버 인프라 구축과 AI 모델 개발을 맡아서 하고 있습니다. {firstYear}년부터 현재까지 총 {posts.length}편의 글에 걸쳐 개발 중 마주친 문제와 그 해결 과정을 기록하고 있습니다. 
    </p>

    <h2>연락처</h2>
    <ul>
      <li><a href="mailto:sewoomkim93@gmail.com">sewoomkim93@gmail.com</a></li>
      <li><a href="https://github.com/froggydisk" target="_blank" rel="noopener noreferrer">github.com/froggydisk</a></li>
      <li><a href="https://velog.io/@frog" target="_blank" rel="noopener noreferrer">velog.io/@frog</a></li>
    </ul>
  </div>
</BaseLayout>
