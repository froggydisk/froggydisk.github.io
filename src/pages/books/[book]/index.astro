---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BookLayout from '../../../layouts/BookLayout.astro';
import BookArchitectureMap from '../../../components/diagrams/BookArchitectureMap.astro';
import { buildToc, bookModified, bookOf, sortChapters } from '../../../utils/book';

export async function getStaticPaths() {
  const metas = await getCollection('bookMeta');
  const all = (await getCollection('book')).filter((c) => !c.data.draft);

  return metas
    .map((meta) => {
      const chapters = sortChapters(all.filter((c) => bookOf(c.id) === meta.id));
      return { params: { book: meta.id }, props: { meta, chapters } };
    })
    .filter((p) => p.props.chapters.length > 0);
}

/*
 * 목차 앞에 붙는 지도. 그림이 그 책의 내용에 묶여 있어 일반화할 수 없으므로
 * 책 슬러그로 고른다. 새 책에 지도를 붙일 때 여기 한 줄을 더한다.
 */
const CONTENTS_MAPS: Record<string, typeof BookArchitectureMap> = {
  'computer-architecture': BookArchitectureMap,
};

const { meta, chapters } = Astro.props;
const ContentsMap = CONTENTS_MAPS[meta.id];
const toc = buildToc(chapters, meta);
const modified = bookModified(chapters, meta);
---

<BookLayout
  bookSlug={meta.id}
  bookTitle={meta.data.title}
  bookAuthor={meta.data.author}
  sample={meta.data.sample}
  writing={meta.data.status === 'writing'}
  toc={toc}
  chapter={null}
  title={meta.data.title}
  description={meta.data.description}
  canonicalPath={`/books/${meta.id}/`}
  image={meta.data.cover}
  modified={modified}
  showToc={false}
>
  <div class:list={['book-front', meta.data.cover && 'book-front-covered']}>
    {meta.data.cover && (
      <img
        class="book-front-cover"
        src={meta.data.cover}
        alt={`${meta.data.title} 표지`}
        decoding="async"
      />
    )}
    <div class="book-front-text">
      {meta.data.subtitle && <p class="book-lede">{meta.data.subtitle}</p>}
      <p>{meta.data.description}</p>
    </div>
  </div>

  <Fragment slot="contents">
    {ContentsMap && <ContentsMap />}

    <nav class="book-contents" aria-label="전체 목차">
    {toc.map((part, pi) => (
      <div class="book-part" id={`part-${pi + 1}`}>
        <div class="book-part-head">
          <span class="book-part-no">Part {pi + 1}</span>
          {part.title && (
            <h2 class="book-part-name">
              {part.title}
              {part.icon && <Icon class="book-part-icon" name={part.icon} />}
            </h2>
          )}
          <span class="book-part-count">{part.chapters.length}장</span>
        </div>
        <ul class="book-part-list">
          {part.chapters.map((ch, ci) => (
            <li>
              <a class="book-ch" href={ch.href}>
                <span class="book-ch-num">{pi + 1}.{String(ci + 1).padStart(2, '0')}</span>
                <span class="book-ch-title">{ch.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      ))}
    </nav>
  </Fragment>
</BookLayout>
