---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { postSlug, parseTags } from '../../utils/seo';

const posts = await getCollection('blog');

const tagMap = new Map<string, typeof posts>();
posts.forEach((post) => {
  parseTags(post.data.tags).forEach((tag) => {
    if (!tagMap.has(tag)) tagMap.set(tag, []);
    tagMap.get(tag)!.push(post);
  });
});

const sortedTags = [...tagMap.entries()].sort((a, b) => b[1].length - a[1].length);

function toSlug(tag: string) {
  return tag.toLowerCase().replace(/\s+/g, '-');
}

const topTags = sortedTags.slice(0, 12).map(([tag]) => tag).join(', ');
const description = `froggydisk 기술 블로그의 주제별 글 목록. ${sortedTags.length}개 태그, ${posts.length}개 글 — ${topTags} 등.`;
---

<BaseLayout title="Tags" description={description}>
  <header class="header" style="margin-bottom: 2em;">
    <h1 class="header-title">Tags</h1>
  </header>

  <nav class="archive-tags" aria-label="태그 목록">
    {sortedTags.map(([tag, tagPosts]) => (
      <a class="tag-item" href={`#tag-${toSlug(tag)}`}>
        {tag} ({tagPosts.length})
      </a>
    ))}
  </nav>

  {sortedTags.map(([tag, tagPosts]) => (
    <section style="margin-top: 2em;">
      <h2 id={`tag-${toSlug(tag)}`}>{tag}</h2>
      {tagPosts
        .sort((a, b) => b.id.slice(0, 10).localeCompare(a.id.slice(0, 10)))
        .map((post) => (
          <div class="post-item">
            <h3 class="post-item-title">
              <a href={`/${postSlug(post.id)}/`}>{post.data.title}</a>
            </h3>
          </div>
        ))}
    </section>
  ))}
</BaseLayout>
