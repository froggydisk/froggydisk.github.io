---
// 단계별 유도. data-s = 이 줄이 나타나는 단계
const LX = 24;    // 좌변
const EQ = 116;   // = 위치
const RX = 134;   // 우변 시작
---

<div class="xr" data-xr>
<svg width="100%" viewBox="0 0 672 292" xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="암호문 두 개를 XOR 하면 같은 키스트림이 두 번 들어가 지워지고 평문끼리의 XOR만 남는다. 평문 하나를 알면 나머지 평문이 복원된다.">

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">IV를 고정하면 KS가 지워진다</text>
<text class="cap" x="336" y="38" text-anchor="middle" fill="var(--muted)">p 평문 · c 암호문 · KS 키스트림 (키와 IV로만 정해진다)</text>

<g class="s" data-s="1">
  <text class="m eq" x={LX} y="70">c1</text>
  <text class="m eq" x={EQ} y="70" fill="var(--muted)">=</text>
  <text class="m eq" x={RX} y="70">p1</text>
  <text class="m eq" x={RX + 34} y="70" fill="var(--muted)">⊕</text>
  <text class="m eq ks" x={RX + 58} y="70" fill="var(--accent-strong)">KS</text>

  <text class="m eq" x={LX} y="104">c2</text>
  <text class="m eq" x={EQ} y="104" fill="var(--muted)">=</text>
  <text class="m eq" x={RX} y="104">p2</text>
  <text class="m eq" x={RX + 34} y="104" fill="var(--muted)">⊕</text>
  <text class="m eq ks" x={RX + 58} y="104" fill="var(--accent-strong)">KS</text>
  <text class="cap" x={RX + 108} y="88" fill="var(--accent-strong)">IV가 같으니 같은 값</text>
</g>

<line x1="24" y1="126" x2="648" y2="126" stroke="var(--rule)" stroke-width="1"/>

<g class="s" data-s="2">
  <text class="m eq" x={LX} y="156">c1 ⊕ c2</text>
  <text class="m eq" x={EQ} y="156" fill="var(--muted)">=</text>
  <text class="m eq" x={RX} y="156">(p1 ⊕ KS) ⊕ (p2 ⊕ KS)</text>
</g>

<g class="s" data-s="3">
  <text class="m eq" x={EQ} y="190" fill="var(--muted)">=</text>
  <text class="m eq" x={RX} y="190">p1 ⊕ p2</text>
  <g class="cancel">
    <text class="m eq" x={RX + 70} y="190" fill="var(--muted)">⊕</text>
    <text class="m eq" x={RX + 94} y="190" fill="var(--accent-strong)">KS ⊕ KS</text>
    <line class="strike" x1={RX + 64} y1="185" x2={RX + 162} y2="185" stroke="var(--accent)" stroke-width="1.6"/>
  </g>
  <text class="cap note" x={RX + 180} y="190" fill="var(--accent-strong)">KS가 두 번</text>
</g>

<g class="s" data-s="4">
  <text class="m eq" x={EQ} y="224" fill="var(--muted)">=</text>
  <text class="m eq" x={RX} y="224" fill="var(--ink)" font-weight="700">p1 ⊕ p2</text>
  <text class="cap" x={RX + 96} y="224" fill="var(--muted)">키를 쓰지 않았다</text>
</g>

<line x1="24" y1="246" x2="648" y2="246" stroke="var(--rule)" stroke-width="1"/>

<g class="s" data-s="5">
  <text class="m eq" x={LX} y="276">(p1 ⊕ p2) ⊕ p1</text>
  <text class="m eq" x={EQ + 100} y="276" fill="var(--muted)">=</text>
  <text class="m eq" x={RX + 106} y="276" fill="var(--ink)" font-weight="700">p2</text>
  <text class="cap" x={RX + 150} y="276" fill="var(--accent-strong)">p1이 두 번 → 지워진다</text>
</g>

</svg>
</div>

<style>
.xr { margin: 2.4rem 0; }
.xr svg { display: block; width: 100%; height: auto; }
.xr text { font-family: var(--font-sans); }
.xr .m { font-family: var(--font-mono); }
.xr .eq { font-size: 13px; }
.xr .cap { font-size: 11px; }
.xr .ttl { font-size: 11.5px; letter-spacing: 0.09em; }

/* JS가 없으면 전부 보인다 = 정적 유도식 */
.xr .strike { opacity: 0; }
.xr .note { opacity: 0; }

/* JS가 붙으면 단계별로 드러난다 */
.xr[data-on] .s { opacity: 0; transition: opacity .34s ease; }
.xr[data-on] .s.show { opacity: 1; }
.xr[data-on] .cancel { transition: opacity .34s ease .1s; }
.xr[data-on][data-cut] .cancel { opacity: .4; }
.xr[data-on][data-cut] .strike { opacity: 1; transition: opacity .34s ease .1s; }
.xr[data-on][data-cut] .note { opacity: 1; }

@media (prefers-reduced-motion: reduce) {
  .xr[data-on] .s, .xr[data-on] .cancel, .xr[data-on] .strike { transition: none; }
}
@media (max-width: 700px) {
  .xr { overflow-x: auto; }
  .xr svg { min-width: 600px; }
}
</style>

<script>
  function wireXor() {
    document.querySelectorAll('[data-xr]').forEach((root) => {
      if (root.hasAttribute('data-on')) return;
      const steps = [...root.querySelectorAll('.s')];
      if (!steps.length) return;

      const max = steps.length;
      // 각 단계를 보여주고 다음으로 넘어가기까지의 대기. 3단계(KS가 두 번)를 가장 길게 준다
      const DELAY = [0, 1200, 1200, 1700, 1400];
      const HOLD = 2400;   // 마지막 상태를 유지했다가 처음으로 돌아간다
      let cur = 1;
      let timer = null;

      const render = () => {
        steps.forEach((g) => g.classList.toggle('show', Number(g.dataset.s) <= cur));
        root.toggleAttribute('data-cut', cur >= 4);
      };

      const stop = () => { clearTimeout(timer); timer = null; };

      const tick = () => {
        if (cur >= max) {
          timer = setTimeout(() => { cur = 1; render(); tick(); }, HOLD);
          return;
        }
        timer = setTimeout(() => { cur++; render(); tick(); }, DELAY[cur]);
      };

      const start = () => { stop(); cur = 1; render(); tick(); };

      root.setAttribute('data-on', '');

      // 모션을 줄이는 설정이면 재생하지 않고 최종 상태로 둔다
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        cur = max;
        render();
        return;
      }

      render();
      new IntersectionObserver((entries) => {
        entries.forEach((e) => { e.isIntersecting ? start() : stop(); });
      }, { threshold: 0.35 }).observe(root);
    });
  }
  wireXor();
  document.addEventListener('astro:page-load', wireXor);
</script>
