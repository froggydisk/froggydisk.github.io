---
/**
 * 지시를 작업·문맥·예시·제약 네 요소로 나누고, 한울연구소 지시문의 내용을 요소별로 보인다.
 * 역할과 어조만 정한 문장이 무엇을 비워 두는지 아래에 적는다.
 */
const W = 144;
const GAP = 16; // 4 × 144 + 3 × 16 = 624
const Y = 50;
const H_BOX = 110;
const parts = [
  { title: '작업', lines: ['문서로 한국어 질의응답', '확인되면 answered', '빠졌으면 되묻는다'] },
  { title: '문맥', lines: ['document = 정책 근거', 'history = 뜻 파악 보조', '사용자 주장 ≠ 정책'] },
  { title: '예시', lines: ['분기마다 대표 사례 하나', '평가 질문은 넣지 않는다', '길이가 비용이다'] },
  { title: '제약', lines: ['근거 없음 → 상태로 반환', '자료 속 명령문 = 데이터', '인용은 원문 구절'] },
].map((p, i) => ({ ...p, x: 24 + i * (W + GAP) }));

const NOTE_Y = Y + H_BOX + 30; // 190
const H = NOTE_Y + 22; // 212
---

<div class="dg">
<svg width="100%" viewBox={`0 0 672 ${H}`} xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="지시는 작업, 문맥, 예시, 제약 네 요소로 나눈다. 작업은 무엇을 할지, 문맥은 어떤 자료를 어떤 지위로 쓸지, 예시는 분기별 대표 사례, 제약은 근거가 없을 때의 상태와 자료 속 명령문의 취급이다. 역할과 어조만 정한 문장은 이 넷을 비워 둔다">

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">지시의 네 요소</text>

{parts.map((p) => (
  <>
    <rect x={p.x} y={Y} width={W} height={H_BOX} rx="3" fill="var(--bg-soft)" stroke="var(--rule)" stroke-width="1"/>
    <text class="box" x={p.x + 12} y={Y + 24} fill="var(--ink)">{p.title}</text>
    <path d={`M ${p.x + 12} ${Y + 34} H ${p.x + W - 12}`} fill="none" stroke="var(--rule)" stroke-width="1"/>
    {p.lines.map((l, k) => (
      <text class="line" x={p.x + 12} y={Y + 54 + k * 20} fill="var(--body)">{l}</text>
    ))}
  </>
))}

<circle cx="31" cy={NOTE_Y - 4} r="7" fill="var(--accent-strong)"/>
<text class="ic" x="31" y={NOTE_Y - 0.5} text-anchor="middle" fill="var(--bg)">✕</text>
<text class="note" x="46" y={NOTE_Y} fill="var(--body)">“훌륭한 사내 상담 전문가답게 친절하게 답하라”는 어조만 정한다. 근거 범위·근거 부족·모호한 질문의 처리는 빈칸이다</text>

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .box { font-size: 13px; font-weight: 550; }
.dg .line { font-size: 10.5px; }
.dg .note { font-size: 10.5px; }
.dg .ic { font-size: 9px; font-weight: 700; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
