---
/**
 * 에이전트 루프 한 단계의 순서. 계획기의 제안은 행동·인자 검증과 실행 허용 검사를 지나야
 * 도구에 닿고, 도구 결과도 검증을 거쳐야 다음 관찰이 된다.
 */
const W = 140;
const GAP = 21; // 4 × 140 + 3 × 21 = 623
const H_BOX = 46;
const row1 = [
  { lines: ['질문 + 관찰'] },
  { lines: ['다음 행동 제안', 'JSON'] },
  { lines: ['행동 · 인자 검증', 'Action 스키마'], strong: true },
  { lines: ['실행 허용 검사', '한도 · 반복 · 마감'], strong: true },
].map((s, i) => ({ ...s, x: 24 + i * (W + GAP), y: 50 }));
const row2 = [
  { lines: ['도구 호출'] },
  { lines: ['결과 검증', '구조 · 크기'], strong: true },
  { lines: ['종료 또는', '다음 관찰'] },
].map((s, i) => ({ ...s, x: 24 + i * (W + GAP), y: 136 }));
const H = 232;
---

<div class="dg">
<svg width="100%" viewBox={`0 0 672 ${H}`} xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="한 단계는 질문과 관찰을 계획기에 주고 JSON으로 다음 행동 제안을 받아, Action 스키마로 행동과 인자를 검증하고, 한도와 반복과 마감을 보는 실행 허용 검사를 지나 도구를 부른다. 도구 결과는 구조와 크기를 검증한 뒤 종료하거나 다음 관찰이 되어 첫 칸으로 돌아간다">

<defs>
  <marker id="astEnd" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
    <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--muted)"/>
  </marker>
</defs>

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">루프 한 단계의 순서</text>

{[...row1, ...row2].map((s) => (
  <>
    <rect x={s.x} y={s.y} width={W} height={H_BOX} rx="3" fill="var(--bg-soft)"
          stroke={s.strong ? 'var(--ink)' : 'var(--rule)'} stroke-width={s.strong ? 1.6 : 1}/>
    {s.lines.map((l, k) => (
      <text class={k === 0 ? 'box' : 'sub'} x={s.x + W / 2} y={s.lines.length === 1 ? s.y + 28 : s.y + 20 + k * 16} text-anchor="middle" fill={k === 0 ? 'var(--ink)' : 'var(--muted)'}>{l}</text>
    ))}
  </>
))}
{row1.slice(0, -1).map((s, i) => (
  <path d={`M ${s.x + W + 2} ${s.y + H_BOX / 2} H ${row1[i + 1].x - 3}`} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#astEnd)"/>
))}
{row2.slice(0, -1).map((s, i) => (
  <path d={`M ${s.x + W + 2} ${s.y + H_BOX / 2} H ${row2[i + 1].x - 3}`} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#astEnd)"/>
))}
<path d={`M ${row1[3].x + W / 2} ${row1[3].y + H_BOX + 2} V ${row1[3].y + H_BOX + 22} H ${row2[0].x + W / 2} V ${row2[0].y - 3}`}
      fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#astEnd)"/>
<path d={`M ${row2[2].x + W + 2} ${row2[2].y + H_BOX / 2} H ${row2[2].x + W + 16} V ${row1[0].y + H_BOX + 20} H ${row1[0].x + W / 2} V ${row1[0].y + H_BOX + 3}`}
      fill="none" stroke="var(--muted)" stroke-width="1.2" stroke-dasharray="3 3" marker-end="url(#astEnd)"/>

<text class="cap" x="336" y={H - 12} text-anchor="middle" fill="var(--muted)">관찰은 복사해서 넘긴다 · finish는 자유 문장을 받지 않고 마지막으로 검증한 도구 결과를 돌려준다</text>

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .box { font-size: 12px; font-weight: 550; }
.dg .sub { font-size: 10px; }
.dg .cap { font-size: 10.5px; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
