---
/**
 * 의미 검색과 키워드 검색이 무엇으로 점수를 내고, 무엇을 잘 찾고 무엇을 놓치는지 나란히 놓는다.
 * 아래 두 질문은 실측에서 둘의 차이가 드러난 사례다.
 */
const W = 300;
const Y = 50;
const H_BOX = 112;
const cols = [
  { x: 24, title: '의미 검색', lines: ['임베딩 · 코사인 (큰 값이 앞)', '표현이 달라도 찾는다', '식별자·숫자는 약하다'] },
  { x: 348, title: '키워드 검색 · FTS5 BM25', lines: ['검색어의 등장과 분포 (작은 값이 앞)', '식별자·정확한 단어에 강하다', '어휘가 다르면 놓친다'] },
];
const EX_Y = 190;
const examples = [
  { q: '“강의 결제 지원”', sem: 'ok', kw: 'bad', note: '문서에 ‘강의’·‘결제’가 없다 → 키워드 결과 없음' },
  { q: '“IT-1042”', sem: 'ok', kw: 'fix', note: '“IT-1042는”에 조사가 붙어 처음엔 못 찾음 → 숫자·한글 경계에 공백' },
].map((e, i) => ({ ...e, y: EX_Y + i * 30 }));
const mark = { ok: { f: 'var(--ink)', c: '✓' }, bad: { f: 'var(--accent-strong)', c: '✕' }, fix: { f: 'var(--accent-strong)', c: '△' } };
const H = 262;
---

<div class="dg">
<svg width="100%" viewBox={`0 0 672 ${H}`} xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="의미 검색은 임베딩과 코사인으로 점수를 내서 표현이 달라도 찾지만 식별자와 숫자에 약하고, 키워드 검색은 검색어의 등장과 분포로 점수를 내서 식별자에 강하지만 어휘가 다르면 놓친다. 강의 결제 지원 질문은 키워드 검색이 놓쳤고, IT-1042 질문은 조사가 붙은 토큰 때문에 처음엔 못 찾다가 숫자와 한글 경계에 공백을 넣어 해결했다">

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">두 검색기가 보는 것</text>

{cols.map((c) => (
  <>
    <rect x={c.x} y={Y} width={W} height={H_BOX} rx="3" fill="var(--bg-soft)" stroke="var(--rule)" stroke-width="1"/>
    <text class="box" x={c.x + 14} y={Y + 24} fill="var(--ink)">{c.title}</text>
    <path d={`M ${c.x + 14} ${Y + 34} H ${c.x + W - 14}`} fill="none" stroke="var(--rule)" stroke-width="1"/>
    {c.lines.map((l, k) => (
      <text class="line" x={c.x + 14} y={Y + 56 + k * 22} fill={k === 2 ? 'var(--accent-strong)' : 'var(--body)'}>{l}</text>
    ))}
  </>
))}

<text class="cap" x="24" y={EX_Y - 10} fill="var(--muted)">질문</text>
<text class="cap" x="180" y={EX_Y - 10} text-anchor="middle" fill="var(--muted)">의미</text>
<text class="cap" x="240" y={EX_Y - 10} text-anchor="middle" fill="var(--muted)">키워드</text>
{examples.map((e) => (
  <>
    <text class="q" x="24" y={e.y + 12} fill="var(--ink)">{e.q}</text>
    <circle cx="180" cy={e.y + 8} r="7" fill={mark[e.sem].f}/>
    <text class="ic" x="180" y={e.y + 11.5} text-anchor="middle" fill="var(--bg)">{mark[e.sem].c}</text>
    <circle cx="240" cy={e.y + 8} r="7" fill={mark[e.kw].f}/>
    <text class="ic" x="240" y={e.y + 11.5} text-anchor="middle" fill="var(--bg)">{mark[e.kw].c}</text>
    <text class="note" x="270" y={e.y + 12} fill="var(--muted)">{e.note}</text>
  </>
))}

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .box { font-size: 12.5px; font-weight: 550; }
.dg .line { font-size: 11px; }
.dg .q { font-size: 11.5px; font-weight: 550; }
.dg .note { font-size: 10px; }
.dg .ic { font-size: 9px; font-weight: 700; }
.dg .cap { font-size: 10.5px; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
