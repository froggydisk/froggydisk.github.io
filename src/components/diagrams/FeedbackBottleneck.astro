---
// 1~2는 돌지만 3부터는 실행 자체가 안 되는 구간을 보여준다.
const steps = [
  { x: 24,  w: 112, t: '1. 코드 작성',   s: 'TDD 기반',    state: 'ok' },
  { x: 150, w: 112, t: '2. 테스트 생성', s: 'QA 에이전트', state: 'ok' },
  { x: 408, w: 84,  t: '3. 실행',        s: '도달 못함',   state: 'dead' },
  { x: 506, w: 72,  t: '4. 수정',        s: null,          state: 'dead' },
  { x: 592, w: 56,  t: '5. 통과',        s: null,          state: 'dead' },
];
// 화살표: [시작, 끝, 살아있는 구간인지]
const arrows = [
  [136, 150, true],
  [262, 276, false],
  [394, 408, false],
  [492, 506, false],
  [578, 592, false],
];
const BN = { x: 276, w: 118, y: 44, h: 74 };
---

<div class="dg">
<svg width="100%" viewBox="0 0 672 176" xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="코드 작성과 테스트 생성까지는 돌아가지만 그 다음 실행 단계에 도달하지 못하고 멈춘다">

<defs>
  <marker id="fbLive" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
    <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--dg-5)"/>
  </marker>
  <marker id="fbDead" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
    <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--rule)"/>
  </marker>
</defs>

<text class="ttl" x="336" y="20" text-anchor="middle" fill="var(--muted)">TDD 피드백 루프가 멈추는 지점</text>

{arrows.map(([x1, x2, live]) => (
  <line x1={x1} y1={78} x2={x2} y2={78} stroke={live ? 'var(--dg-5)' : 'var(--rule)'} stroke-width="1"
        marker-end={live ? 'url(#fbLive)' : 'url(#fbDead)'}/>
))}

{steps.map((s) => (
  <g>
    <rect x={s.x} y={56} width={s.w} height={44} rx={3}
          fill={s.state === 'ok' ? 'var(--bg-soft)' : 'none'}
          stroke={s.state === 'ok' ? 'var(--dg-5)' : 'var(--rule)'} stroke-width="1"
          stroke-dasharray={s.state === 'ok' ? undefined : '4 3'}/>
    <text class="m step" x={s.x + s.w / 2} y={s.s ? 76 : 82} text-anchor="middle"
          fill={s.state === 'ok' ? 'var(--dg-5-ink)' : 'var(--muted)'}>{s.t}</text>
    {s.s && (
      <text class="cap" x={s.x + s.w / 2} y={90} text-anchor="middle" fill="var(--muted)">{s.s}</text>
    )}
  </g>
))}

<!-- 병목 구간 -->
<rect x={BN.x} y={BN.y} width={BN.w} height={BN.h} rx={3}
      fill="var(--dg-1)" fill-opacity="0.08" stroke="var(--dg-1)" stroke-width="1.5" stroke-dasharray="5 3"/>
<text class="bn" x={BN.x + BN.w / 2} y={64} text-anchor="middle" fill="var(--dg-1-ink)">BOTTLENECK</text>
<line x1={327} y1={76} x2={343} y2={92} stroke="var(--dg-1)" stroke-width="2" stroke-linecap="round"/>
<line x1={343} y1={76} x2={327} y2={92} stroke="var(--dg-1)" stroke-width="2" stroke-linecap="round"/>
<text class="cap" x={BN.x + BN.w / 2} y={111} text-anchor="middle" fill="var(--dg-1-ink)">전제 상태 없음</text>

<line x1="24" y1="140" x2="648" y2="140" stroke="var(--rule)" stroke-width="1"/>
<text class="cap" x="336" y="159" text-anchor="middle" fill="var(--muted)">1~2는 자동화됐지만, 3부터는 실행 자체가 안 된다</text>

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .m { font-family: var(--font-mono); }
.dg .step { font-size: 11.5px; font-weight: 600; }
.dg .bn { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; }
.dg .cap { font-size: 10.5px; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
