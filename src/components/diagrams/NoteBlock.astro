---
interface Props {
  label?: string;
  text: string;
}
const { label, text } = Astro.props;
---

<figure class="note-block">
  {label && <figcaption class="note-block-label">{label}</figcaption>}
  <pre class="note-block-content">{text}</pre>
</figure>

<style>
.note-block {
  margin: 2.4rem 0;
  padding: 0;
  border: 1px solid var(--rule);
  border-radius: 3px;
  background: var(--bg-soft);
}

.note-block-label {
  padding: 9px 18px;
  border-bottom: 1px solid var(--rule);
  font-family: var(--font-mono);
  font-size: 0.72em;
  letter-spacing: 0.09em;
  color: var(--muted);
  user-select: none;
}

.note-block-content {
  margin: 0;
  padding: 16px 18px 18px;
  background: transparent !important;
  border: none;
  font-family: var(--font-mono);
  font-size: 0.82em;
  line-height: 1.7;
  color: var(--body);
  white-space: pre;
  overflow-x: auto;
}
</style>
