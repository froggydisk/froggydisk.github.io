---
/**
 * 언어 모델이 지금까지의 토큰을 보고 다음 토큰 하나의 분포를 계산하고, 고른 토큰을
 * 뒤에 붙여 같은 계산을 반복한다는 것을 한 단계로 보인다. 확률은 설명용 예시 값이다.
 */
const CTX = { x: 24, y: 60, w: 200, h: 60 };
const MODEL = { x: 258, y: 60, w: 88, h: 60 };
const DIST = { x: 380, y: 48, w: 268 };
const LABEL_X = DIST.x + 8;
const BAR_X = DIST.x + 58;
const BAR_MAX = 150;
const BAR_H = 12;
const ROW = 20;

const cands = [
  { tok: '30만', p: 0.52, pick: true },
  { tok: '20만', p: 0.31 },
  { tok: '50만', p: 0.09 },
  { tok: '확인', p: 0.08 },
].map((c, i) => ({ ...c, y: DIST.y + 14 + i * ROW }));

const DIST_BOTTOM = cands[3].y + BAR_H + 10; // 144
const LOOP_Y = 178;
const H = 214;
---

<div class="dg">
<svg width="100%" viewBox={`0 0 672 ${H}`} xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="언어 모델은 지금까지의 토큰을 입력받아 다음 토큰 후보마다 확률을 계산하고, 그중 하나를 골라 뒤에 붙인 뒤 같은 계산을 반복한다">

<defs>
  <marker id="ntsEnd" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
    <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--muted)"/>
  </marker>
</defs>

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">한 번에 토큰 하나를 고른다</text>

<!-- 지금까지의 토큰 -->
<text class="cap" x={CTX.x} y={CTX.y - 9} fill="var(--muted)">지금까지의 토큰</text>
<rect x={CTX.x} y={CTX.y} width={CTX.w} height={CTX.h} rx="3" fill="var(--bg-soft)" stroke="var(--rule)" stroke-width="1"/>
<text class="box" x={CTX.x + CTX.w / 2} y={CTX.y + 26} text-anchor="middle" fill="var(--ink)">한울연구소의 교육비</text>
<text class="box" x={CTX.x + CTX.w / 2} y={CTX.y + 44} text-anchor="middle" fill="var(--ink)">한도는 분기당</text>

<path d={`M ${CTX.x + CTX.w + 2} ${CTX.y + CTX.h / 2} H ${MODEL.x - 3}`} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#ntsEnd)"/>

<!-- 모델 -->
<rect x={MODEL.x} y={MODEL.y} width={MODEL.w} height={MODEL.h} rx="3" fill="var(--bg-soft)" stroke="var(--ink)" stroke-width="1.6"/>
<text class="box" x={MODEL.x + MODEL.w / 2} y={MODEL.y + 35} text-anchor="middle" fill="var(--ink)">모델</text>

<path d={`M ${MODEL.x + MODEL.w + 2} ${MODEL.y + MODEL.h / 2} H ${DIST.x - 3}`} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#ntsEnd)"/>

<!-- 다음 토큰 후보의 분포 -->
<text class="cap" x={DIST.x} y={DIST.y - 9} fill="var(--muted)">다음 토큰 후보와 확률 (예시 값)</text>
{cands.map((c) => (
  <>
    <text class="m" x={LABEL_X} y={c.y + 10} fill={c.pick ? 'var(--ink)' : 'var(--body)'}>{c.tok}</text>
    <rect x={BAR_X} y={c.y} width={BAR_MAX * c.p} height={BAR_H} rx="2"
          fill={c.pick ? 'var(--ink)' : 'var(--bg-soft)'} stroke={c.pick ? 'var(--ink)' : 'var(--rule)'} stroke-width="1"/>
    <text class="val" x={BAR_X + BAR_MAX * c.p + 6} y={c.y + 10} fill={c.pick ? 'var(--ink)' : 'var(--muted)'}>{c.p.toFixed(2)}</text>
  </>
))}

<!-- 고른 토큰을 뒤에 붙이고 반복 -->
<path d={`M ${BAR_X + 20} ${DIST_BOTTOM} V ${LOOP_Y} H ${CTX.x + CTX.w / 2} V ${CTX.y + CTX.h + 3}`}
      fill="none" stroke="var(--muted)" stroke-width="1.2" stroke-dasharray="4 3" marker-end="url(#ntsEnd)"/>
<text class="cap" x={(CTX.x + CTX.w / 2 + BAR_X + 20) / 2} y={LOOP_Y + 18} text-anchor="middle" fill="var(--muted)">고른 토큰을 뒤에 붙이고 같은 계산을 반복한다</text>

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .box { font-size: 12.5px; font-weight: 550; }
.dg .m { font-family: var(--font-mono); font-size: 11px; font-weight: 600; }
.dg .val { font-family: var(--font-mono); font-size: 10.5px; }
.dg .cap { font-size: 11px; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
