---
/**
 * 문맥 구성기가 후보 자료를 최종 입력으로 만드는 순서. 권한 검사가 토큰 세기보다 앞에 있고,
 * 후보를 하나씩 더해 전체를 다시 세며, 센 입력을 그대로 생성에 보낸다.
 */
const BX = 24;
const BW = 300;
const BH = 40;
const TOP = 44;
const STEP = 58;
const steps = [
  { label: '사용자 범위 + 후보 자료', note: '인증을 거친 Principal과 문서·이력 블록' },
  { label: '조직 · 문서 권한 · 대화 범위 검사', note: '다른 조직·다른 세션 자료는 여기서 사라진다', strong: true },
  { label: '허용한 자료의 우선순위 정렬', note: '정책 문서 > 긴 대화. 같은 순위는 식별자순' },
  { label: '질문 · 지시문 세기, 출력 공간 확보', note: '질문이 안 들어가면 자르지 않고 중단' },
  { label: '후보 추가 → 전체 세기 → 채택 / 제외', note: '안 맞으면 건너뛰고 다음 후보', loop: true },
  { label: '같은 입력으로 생성 요청', note: '센 입력과 보낸 입력이 같다', strong: true },
].map((s, i) => ({ ...s, y: TOP + i * STEP }));
const MIDX = BX + BW / 2;
const NOTE_X = BX + BW + 24;
const H = steps[5].y + BH + 24; // 398
---

<div class="dg">
<svg width="100%" viewBox={`0 0 672 ${H}`} xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="문맥 구성은 인증된 사용자 범위와 후보 자료에서 시작해, 조직·문서 권한·대화 범위를 검사하고, 허용한 자료를 우선순위로 정렬하고, 질문과 지시문을 세어 출력 공간을 확보한 뒤, 후보를 하나씩 더해 전체를 다시 세며 채택하거나 제외하고, 그 입력을 그대로 생성 요청에 보낸다">

<defs>
  <marker id="cpiEnd" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
    <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--muted)"/>
  </marker>
</defs>

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">문맥 구성기의 순서</text>

{steps.map((s, i) => (
  <>
    <rect x={BX} y={s.y} width={BW} height={BH} rx="3" fill="var(--bg-soft)"
          stroke={s.strong ? 'var(--ink)' : 'var(--rule)'} stroke-width={s.strong ? 1.6 : 1}/>
    <text class="box" x={MIDX} y={s.y + 25} text-anchor="middle" fill="var(--ink)">{s.label}</text>
    <text class="note" x={NOTE_X} y={s.y + 25} fill="var(--muted)">{s.note}</text>
    {i < steps.length - 1 && (
      <path d={`M ${MIDX} ${s.y + BH + 2} V ${s.y + STEP - 3}`} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#cpiEnd)"/>
    )}
    {s.loop && (
      <path d={`M ${BX + BW + 2} ${s.y + 12} H ${BX + BW + 12} V ${s.y + BH - 12} H ${BX + BW + 3}`}
            fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#cpiEnd)"/>
    )}
  </>
))}

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .box { font-size: 12px; font-weight: 550; }
.dg .note { font-size: 10.5px; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
