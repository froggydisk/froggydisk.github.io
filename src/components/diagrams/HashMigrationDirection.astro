---
const R1 = 50, R2 = 144, BH = 38;
---

<div class="dg">
<svg width="100%" viewBox="0 0 672 226" xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="양방향 컬럼은 키로 원문을 꺼내 어떤 방식으로든 다시 계산할 수 있지만, 단방향 컬럼은 원문으로 되돌아가는 경로가 없어 전환할 수 없다">

<defs>
  <marker id="mdOk" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
    <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--ink)"/>
  </marker>
</defs>

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">바꿀 수 있는가</text>

<text class="lbl" x="24" y="42" fill="var(--ink)">양방향</text>
<line x1="176" y1={R1 + 19} x2="222" y2={R1 + 19} stroke="var(--ink)" stroke-width="1" marker-end="url(#mdOk)"/>
<line x1="354" y1={R1 + 19} x2="400" y2={R1 + 19} stroke="var(--ink)" stroke-width="1" marker-end="url(#mdOk)"/>
<rect x="24" y={R1} width="150" height={BH} rx="3" fill="var(--bg-soft)" stroke="var(--ink)" stroke-width="1.6"/>
<text class="m val" x="99" y={R1 + 24} text-anchor="middle" fill="var(--ink)">AES 컬럼</text>
<rect x="232" y={R1} width="120" height={BH} rx="3" fill="var(--bg-soft)" stroke="var(--ink)" stroke-width="1.6"/>
<text class="val" x="292" y={R1 + 24} text-anchor="middle" fill="var(--ink)" font-weight="700">원문</text>
<rect x="410" y={R1} width="238" height={BH} rx="3" fill="none" stroke="var(--rule)" stroke-width="1"/>
<text class="m val" x="529" y={R1 + 24} text-anchor="middle">HMAC · bcrypt · 다른 키</text>
<text class="cap" x="199" y={R1 + 15} text-anchor="middle" fill="var(--muted)">복호화</text>
<text class="cap" x="377" y={R1 + 15} text-anchor="middle" fill="var(--muted)">재계산</text>

<line x1="24" y1="112" x2="648" y2="112" stroke="var(--rule)" stroke-width="1"/>

<text class="lbl" x="24" y="136" fill="var(--accent-strong)">단방향</text>
<rect x="24" y={R2} width="150" height={BH} rx="3" fill="var(--accent)" fill-opacity="0.12" stroke="var(--accent)" stroke-width="1.5"/>
<text class="m val" x="99" y={R2 + 24} text-anchor="middle" fill="var(--accent-strong)">SHA-256 컬럼</text>
<line x1="182" y1={R2 + 19} x2="226" y2={R2 + 19} stroke="var(--accent)" stroke-width="1" stroke-dasharray="4 4"/>
<line x1="196" y1={R2 + 9} x2="212" y2={R2 + 29} stroke="var(--accent)" stroke-width="1.8"/>
<line x1="212" y1={R2 + 9} x2="196" y2={R2 + 29} stroke="var(--accent)" stroke-width="1.8"/>
<rect x="232" y={R2} width="120" height={BH} rx="3" fill="none" stroke="var(--rule)" stroke-width="1" stroke-dasharray="4 4"/>
<text class="val" x="292" y={R2 + 24} text-anchor="middle" fill="var(--muted)">원문</text>
<text class="cap" x="374" y={R2 + 24} fill="var(--accent-strong)">되돌아가는 경로가 없다</text>

<text class="cap" x="336" y="208" text-anchor="middle" fill="var(--muted)">단방향을 고르는 것은 알고리즘 선택이 아니라 원문을 버리는 결정이다</text>

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .m { font-family: var(--font-mono); }
.dg .val { font-size: 12.5px; }
.dg .cap { font-size: 11px; }
.dg .lbl { font-size: 12px; font-weight: 700; letter-spacing: 0.06em; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
