---
const stages = [
  { n: 1, name: 'Harbor 기동', symptom: 'Redis ping 실패', fix: 'coredns 재시작' },
  { n: 2, name: 'docker login', symptom: 'credentials 에러', fix: 'credsStore 비우기' },
  { n: 3, name: 'docker push', symptom: 'Retrying in 5s', fix: 'relativeurls: true' },
  { n: 4, name: '파드 pull', symptom: '401 Unauthorized', fix: 'Secret 네임스페이스' },
];

const BOX_W = 141;
const GAP = 20;
const x = (i) => 24 + i * (BOX_W + GAP);
const cx = (i) => x(i) + BOX_W / 2;
---

<div class="dg">
<svg width="100%" viewBox="0 0 672 160" xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="Harbor 기동, docker login, docker push, 파드 pull 네 단계에서 각각 다른 지점이 막힌다">

<defs>
  <marker id="hbArrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto">
    <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--rule)"/>
  </marker>
</defs>

<text class="m ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">Harbor 기동부터 이미지 pull까지</text>

{stages.slice(0, 3).map((_, i) => (
  <line x1={x(i) + BOX_W + 3} y1="61" x2={x(i + 1) - 3} y2="61"
        stroke="var(--rule)" stroke-width="1" marker-end="url(#hbArrow)"/>
))}

{stages.map((s, i) => (
  <>
    <rect x={x(i)} y="44" width={BOX_W} height="34" rx="3"
          fill="var(--bg-soft)" stroke="var(--rule)" stroke-width="1"/>
    <text class="m nm" x={cx(i)} y="65" text-anchor="middle" fill="var(--ink)">{s.n} · {s.name}</text>
    <text class="sym" x={cx(i)} y="100" text-anchor="middle" fill="var(--accent-strong)">{s.symptom}</text>
    <text class="m fix" x={cx(i)} y="118" text-anchor="middle" fill="var(--ink)">{s.fix}</text>
  </>
))}

<text class="cap" x="336" y="146" text-anchor="middle" fill="var(--muted)">앞 단계가 해결되어야 다음 단계로 넘어갈 수 있다</text>

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .m { font-family: var(--font-mono); }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
.dg .nm { font-size: 12px; }
.dg .sym { font-size: 11px; }
.dg .fix { font-size: 10.5px; }
.dg .cap { font-size: 11px; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 620px; }
}
</style>
