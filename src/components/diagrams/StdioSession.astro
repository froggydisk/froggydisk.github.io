---
/**
 * stdio로 연결한 로컬 MCP 시연의 두 프로세스. 호스트 쪽 클라이언트 세션의 순서와
 * 서버 쪽의 FastMCP → Tickets → SQLite 경로, stdout이 프로토콜 전용이라는 규칙을 보인다.
 */
const HOST = { x: 24, y: 50, w: 250, h: 176 };
const SRV = { x: 398, y: 50, w: 250, h: 176 };
const hostSteps = ['stdio_client(params) · 하위 프로세스 시작', 'ClientSession', 'initialize', 'list_tools', 'call_tool("create_ticket", {draft_id})'];
const srvSteps = ['FastMCP · @server.tool(...)', 'Tickets 클래스 · 초안·권한·멱등성 검사', 'SQLite'];
const NOTE_Y = 258;
const H = 280;
---

<div class="dg">
<svg width="100%" viewBox={`0 0 672 ${H}`} xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="호스트 프로세스의 클라이언트는 stdio_client로 서버 하위 프로세스를 시작하고 ClientSession에서 initialize, list_tools, call_tool 순으로 진행한다. 서버 프로세스는 FastMCP가 등록한 도구가 같은 Tickets 클래스를 불러 초안·권한·멱등성 검사를 거쳐 SQLite에 쓴다. 요청은 stdin으로, 응답은 stdout으로 오가며 stdout은 프로토콜 전용이라 로그는 stderr로 보낸다">

<defs>
  <marker id="ssnEnd" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
    <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--muted)"/>
  </marker>
  <marker id="ssnStart" viewBox="0 0 10 10" refX="1" refY="5" markerWidth="6" markerHeight="6" orient="auto">
    <path d="M 10 0 L 0 5 L 10 10 z" fill="var(--muted)"/>
  </marker>
</defs>

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">로컬 stdio 시연의 두 프로세스</text>

<rect x={HOST.x} y={HOST.y} width={HOST.w} height={HOST.h} rx="3" fill="none" stroke="var(--rule)" stroke-width="1"/>
<text class="box" x={HOST.x + 12} y={HOST.y + 20} fill="var(--ink)">호스트 프로세스 · 클라이언트</text>
{hostSteps.map((s, i) => (
  <>
    <text class="m" x={HOST.x + 24} y={HOST.y + 46 + i * 26} fill="var(--body)">{s}</text>
    {i < hostSteps.length - 1 && <path d={`M ${HOST.x + 14} ${HOST.y + 50 + i * 26} V ${HOST.y + 36 + (i + 1) * 26}`} fill="none" stroke="var(--muted)" stroke-width="1" marker-end="url(#ssnEnd)"/>}
  </>
))}

<rect x={SRV.x} y={SRV.y} width={SRV.w} height={SRV.h} rx="3" fill="none" stroke="var(--ink)" stroke-width="1.4"/>
<text class="box" x={SRV.x + 12} y={SRV.y + 20} fill="var(--ink)">서버 프로세스 · mcp_ticket_server.py</text>
{srvSteps.map((s, i) => (
  <>
    <rect x={SRV.x + 14} y={SRV.y + 34 + i * 44} width={SRV.w - 28} height="30" rx="3" fill="var(--bg-soft)" stroke="var(--rule)" stroke-width="1"/>
    <text class={i === 2 ? 'line' : 'm'} x={SRV.x + SRV.w / 2} y={SRV.y + 34 + i * 44 + 19} text-anchor="middle" fill="var(--ink)">{s}</text>
    {i < 2 && <path d={`M ${SRV.x + SRV.w / 2} ${SRV.y + 64 + i * 44 + 2} V ${SRV.y + 34 + (i + 1) * 44 - 3}`} fill="none" stroke="var(--muted)" stroke-width="1" marker-end="url(#ssnEnd)"/>}
  </>
))}

<!-- 파이프 -->
<path d={`M ${HOST.x + HOST.w + 3} 118 H ${SRV.x - 3}`} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#ssnEnd)"/>
<text class="cap" x="336" y="112" text-anchor="middle" fill="var(--muted)">stdin · 요청</text>
<path d={`M ${SRV.x - 3} 160 H ${HOST.x + HOST.w + 3}`} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#ssnEnd)"/>
<text class="cap" x="336" y="154" text-anchor="middle" fill="var(--muted)">stdout · 응답</text>
<text class="cap" x="336" y="196" text-anchor="middle" fill="var(--accent-strong)">stdout은 프로토콜 전용 · 로그는 stderr로</text>

<circle cx="31" cy={NOTE_Y - 4} r="7" fill="var(--accent-strong)"/>
<text class="ic" x="31" y={NOTE_Y - 0.5} text-anchor="middle" fill="var(--bg)">✕</text>
<text class="note" x="46" y={NOTE_Y} fill="var(--body)">첫 실행에서 반환 타입을 dict로 두자 structuredContent가 없었다 → dict[str, Any]와 structured_output=True를 명시해 해결</text>

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .box { font-size: 12px; font-weight: 550; }
.dg .line { font-size: 11.5px; font-weight: 550; }
.dg .m { font-family: var(--font-mono); font-size: 9.5px; }
.dg .note { font-size: 10.5px; }
.dg .ic { font-size: 9px; font-weight: 700; }
.dg .cap { font-size: 10.5px; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
