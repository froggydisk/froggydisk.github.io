---
/**
 * operations_demo.py의 부하 모양. 요청 20개가 한꺼번에 들어와 크기 4의 큐에 4개만 들어가고
 * 16개는 즉시 거부된다. 마감은 워커가 시작한 시점이 아니라 접수 시점부터 잰다.
 */
const SRC = { x: 24, y: 60, w: 130, h: 60 };
const Q = { x: 210, y: 60, w: 172, h: 60 };
const WK = [{ x: 440, y: 46 }, { x: 440, y: 94 }].map((w) => ({ ...w, w: 100, h: 34 }));
const REJ = { x: 210, y: 140, w: 172, h: 30 };
const TL_Y = 226;
const T0 = 60;
const T1 = 640;
const H = 284;
---

<div class="dg">
<svg width="100%" viewBox={`0 0 672 ${H}`} xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="요청 20개가 양보 없이 한꺼번에 들어오면 크기 4의 asyncio.Queue에 4개가 들어가고 16개는 즉시 거부된다. 워커 둘이 큐에서 꺼내 처리한다. 각 요청의 마감은 접수 시점부터 timeout_at으로 잰다. 워커가 일을 시작할 때 새 타이머를 주면 대기한 시간을 놓친다">

<defs>
  <marker id="qdEnd" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
    <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--muted)"/>
  </marker>
</defs>

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">큐 · 역압 · 접수 기준 마감</text>

<rect x={SRC.x} y={SRC.y} width={SRC.w} height={SRC.h} rx="3" fill="var(--bg-soft)" stroke="var(--rule)" stroke-width="1"/>
<text class="box" x={SRC.x + SRC.w / 2} y={SRC.y + 26} text-anchor="middle" fill="var(--ink)">요청 20개</text>
<text class="sub" x={SRC.x + SRC.w / 2} y={SRC.y + 44} text-anchor="middle" fill="var(--muted)">양보 없이 한꺼번에</text>
<path d={`M ${SRC.x + SRC.w + 2} ${SRC.y + SRC.h / 2} H ${Q.x - 3}`} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#qdEnd)"/>

<rect x={Q.x} y={Q.y} width={Q.w} height={Q.h} rx="3" fill="none" stroke="var(--ink)" stroke-width="1.4"/>
<text class="m" x={Q.x + Q.w / 2} y={Q.y + 18} text-anchor="middle" fill="var(--ink)">asyncio.Queue(4)</text>
{[0, 1, 2, 3].map((k) => (
  <rect x={Q.x + 14 + k * 38} y={Q.y + 28} width="30" height="22" rx="2" fill="var(--ink)"/>
))}

{WK.map((w, i) => (
  <>
    <path d={`M ${Q.x + Q.w + 2} ${Q.y + Q.h / 2} H ${w.x - 20} V ${w.y + w.h / 2} H ${w.x - 3}`} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#qdEnd)"/>
    <rect x={w.x} y={w.y} width={w.w} height={w.h} rx="3" fill="var(--bg-soft)" stroke="var(--rule)" stroke-width="1"/>
    <text class="box" x={w.x + w.w / 2} y={w.y + 22} text-anchor="middle" fill="var(--ink)">{`워커 ${i + 1}`}</text>
  </>
))}

<path d={`M ${Q.x + Q.w / 2} ${Q.y + Q.h + 2} V ${REJ.y - 3}`} fill="none" stroke="var(--accent-strong)" stroke-width="1.2" stroke-dasharray="3 3" marker-end="url(#qdEnd)"/>
<rect x={REJ.x} y={REJ.y} width={REJ.w} height={REJ.h} rx="3" fill="none" stroke="var(--accent-strong)" stroke-width="1.2" stroke-dasharray="4 3"/>
<text class="box" x={REJ.x + REJ.w / 2} y={REJ.y + 20} text-anchor="middle" fill="var(--accent-strong)">즉시 거부 16 · 역압</text>
<text class="sub" x={REJ.x + REJ.w + 12} y={REJ.y + 20} fill="var(--muted)">처리할 수 없는 요청을 성공할 것처럼 받아 두지 않는다</text>

<!-- 한 요청의 시간축 -->
<text class="cap" x="24" y={TL_Y - 22} fill="var(--muted)">받아들인 요청 하나 · 마감은 접수부터</text>
<path d={`M ${T0} ${TL_Y} H ${T1}`} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#qdEnd)"/>
<rect x={T0} y={TL_Y - 8} width="200" height="16" fill="var(--bg-soft)" stroke="var(--rule)" stroke-width="1"/>
<text class="sub" x={T0 + 100} y={TL_Y + 4} text-anchor="middle" fill="var(--muted)">대기</text>
<rect x={T0 + 200} y={TL_Y - 8} width="220" height="16" fill="var(--bg-soft)" stroke="var(--ink)" stroke-width="1.2"/>
<text class="sub" x={T0 + 310} y={TL_Y + 4} text-anchor="middle" fill="var(--ink)">실행</text>
<path d={`M ${T0} ${TL_Y - 16} V ${TL_Y + 16}`} fill="none" stroke="var(--ink)" stroke-width="1.2"/>
<text class="cap" x={T0} y={TL_Y + 30} text-anchor="middle" fill="var(--ink)">접수</text>
<path d={`M ${T0 + 470} ${TL_Y - 16} V ${TL_Y + 16}`} fill="none" stroke="var(--accent-strong)" stroke-width="1.4"/>
<text class="cap" x={T0 + 470} y={TL_Y + 30} text-anchor="middle" fill="var(--accent-strong)">timeout_at(deadline)</text>
<text class="sub" x="648" y={TL_Y + 46} text-anchor="end" fill="var(--muted)">워커 시작 시점에 새 타이머를 주면 대기한 시간을 놓친다</text>

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .box { font-size: 11.5px; font-weight: 550; }
.dg .m { font-family: var(--font-mono); font-size: 11px; font-weight: 600; }
.dg .sub { font-size: 10px; }
.dg .cap { font-size: 10.5px; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
