---
/**
 * 티켓 등록의 여섯 단계. 확인 이벤트와 권한 재검사는 호스트·서버의 일이고, 모델이 만든
 * '확인했습니다' 문장은 확인 이벤트가 아니다.
 */
const W = 92;
const GAP = 14; // 6 × 92 + 5 × 14 = 622
const Y = 60;
const H_BOX = 52;
const steps = [
  { lines: ['초안 작성'], tool: 'prepare_ticket' },
  { lines: ['미리보기', '표시'] },
  { lines: ['확인 이벤트', '(호스트)'], tool: 'approve · 도구 아님', strong: true },
  { lines: ['현재 권한', '재검사'], strong: true },
  { lines: ['등록'], tool: 'create_ticket(draft_id)' },
  { lines: ['received'], mono: true },
].map((s, i) => ({ ...s, x: 24 + i * (W + GAP) }));
const MID = Y + H_BOX / 2;
const NOTE_Y = Y + H_BOX + 34;
const notes = [
  '모델이 “확인했습니다”라고 써도 확인 이벤트가 아니다. approve는 MCP 도구로 노출하지 않는다',
  'create_ticket은 제목·본문을 다시 받지 않고 draft_id만 받는다. 내용을 바꾸려면 새 초안과 새 확인이 필요하다',
].map((t, i) => ({ t, y: NOTE_Y + i * 24 }));
const H = notes[1].y + 22; // 216
---

<div class="dg">
<svg width="100%" viewBox={`0 0 672 ${H}`} xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="티켓 등록은 prepare_ticket으로 초안을 만들고, 사용자에게 미리보기를 보이고, 호스트가 확인 이벤트를 넣고, 현재 권한을 다시 검사한 뒤, create_ticket이 draft_id만 받아 등록하고 received가 된다. 모델의 확인했다는 문장은 확인 이벤트가 아니고 approve는 MCP 도구로 노출하지 않는다">

<defs>
  <marker id="ttsEnd" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
    <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--muted)"/>
  </marker>
</defs>

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">초안 · 확인 · 등록</text>

{steps.map((s) => (
  <>
    {s.tool && <text class="m" x={s.x + W / 2} y={Y - 10} text-anchor="middle" fill="var(--muted)">{s.tool}</text>}
    <rect x={s.x} y={Y} width={W} height={H_BOX} rx="3" fill="var(--bg-soft)"
          stroke={s.strong ? 'var(--ink)' : 'var(--rule)'} stroke-width={s.strong ? 1.6 : 1}/>
    {s.lines.map((l, k) => (
      <text class={s.mono ? 'mb' : 'box'} x={s.x + W / 2} y={s.lines.length === 1 ? Y + 31 : Y + 22 + k * 17} text-anchor="middle" fill="var(--ink)">{l}</text>
    ))}
  </>
))}
{steps.slice(0, -1).map((s, i) => (
  <path d={`M ${s.x + W + 2} ${MID} H ${steps[i + 1].x - 3}`} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#ttsEnd)"/>
))}

{notes.map((n) => (
  <>
    <circle cx="31" cy={n.y - 4} r="7" fill="var(--accent-strong)"/>
    <text class="ic" x="31" y={n.y - 0.5} text-anchor="middle" fill="var(--bg)">✕</text>
    <text class="note" x="46" y={n.y} fill="var(--body)">{n.t}</text>
  </>
))}

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .box { font-size: 11.5px; font-weight: 550; }
.dg .mb { font-family: var(--font-mono); font-size: 11.5px; font-weight: 600; }
.dg .m { font-family: var(--font-mono); font-size: 9.5px; }
.dg .note { font-size: 10.5px; }
.dg .ic { font-size: 9px; font-weight: 700; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
