---
/**
 * Computer System을 사용자·응용 프로그램·운영체제·펌웨어·하드웨어 다섯 층으로 나누고,
 * 그중 어디까지가 S/W이고 F/W이고 H/W인지 묶음 표시로 보인다.
 */
const BOX_X = 132;
const BOX_W = 296;
const BOX_H = 46;
const GAP = 12;
const TOP = 44;

const layers = [
  { ko: '사용자', en: ' (End-User)', outside: true },
  { ko: '응용 프로그램', en: ' (Application S/W)' },
  { ko: '운영체제', en: ' (Operating System)' },
  { ko: '펌웨어', en: ' (Firmware)' },
  { ko: '하드웨어', en: ' (Hardware)' },
].map((l, i) => ({ ...l, y: TOP + i * (BOX_H + GAP) }));

const BOTTOM = layers[4].y + BOX_H; // 322
const MID = BOX_X + BOX_W / 2; // 280

const BR_X = 448; // 묶음 표시가 서는 자리
const BR_W = 12;
const LB_X = BR_X + BR_W + 12; // 472

const groups = [
  { label: 'S/W · 소프트웨어', from: 1, to: 2 },
  { label: 'F/W · 펌웨어', from: 3, to: 3 },
  { label: 'H/W · 하드웨어', from: 4, to: 4 },
].map((g) => {
  const top = layers[g.from].y;
  const bot = layers[g.to].y + BOX_H;
  return { ...g, top, bot, mid: (top + bot) / 2 };
});

const H = BOTTOM + 28; // 350
---

<div class="dg">
<svg width="100%" viewBox={`0 0 672 ${H}`} xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="컴퓨터 시스템은 사용자·응용 프로그램·운영체제·펌웨어·하드웨어 다섯 층으로 나뉜다. 응용 프로그램과 운영체제가 소프트웨어, 펌웨어와 하드웨어가 각각 한 층이고, 사용자는 세 이름 어디에도 들어가지 않는다">

<defs>
  <marker id="cssUp" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
    <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--muted)"/>
  </marker>
</defs>

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">Computer System의 다섯 층과 H/W · S/W · F/W</text>

<!-- 위로 갈수록 상위 레벨 -->
<text class="cap" x="92" y={TOP - 8} text-anchor="middle" fill="var(--muted)">상위 레벨</text>
<path d={`M 92 ${BOTTOM} V ${TOP + 2}`} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#cssUp)"/>
<text class="cap" x="92" y={BOTTOM + 18} text-anchor="middle" fill="var(--muted)">하위 레벨</text>

<!-- 다섯 층 -->
{layers.map((l) => (
  <>
    <rect x={BOX_X} y={l.y} width={BOX_W} height={BOX_H} rx="3"
          fill="var(--bg-soft)" stroke="var(--rule)" stroke-width="1"
          stroke-dasharray={l.outside ? '4 3' : undefined}/>
    <text class="box" x={MID} y={l.y + 29} text-anchor="middle"
          fill={l.outside ? 'var(--muted)' : 'var(--ink)'}>{l.ko}<tspan class="en" fill="var(--muted)">{l.en}</tspan></text>
  </>
))}

<!-- 세 이름으로 묶이는 범위 -->
{groups.map((g) => (
  <>
    <path d={`M ${BR_X} ${g.top} H ${BR_X + BR_W} V ${g.bot} H ${BR_X}`} fill="none" stroke="var(--rule)" stroke-width="1"/>
    <text class="grp" x={LB_X} y={g.mid + 4} fill="var(--ink)">{g.label}</text>
  </>
))}

<text class="cap" x={LB_X} y={layers[0].y + 29} fill="var(--muted)">세 이름에 들어가지 않는다</text>

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .box { font-size: 13px; font-weight: 550; }
.dg .en { font-size: 11.5px; font-weight: 400; }
.dg .grp { font-size: 12px; font-weight: 500; }
.dg .cap { font-size: 11px; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
