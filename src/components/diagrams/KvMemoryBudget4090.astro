---
// RTX 4090 24GiB에 Llama 3.1 8B(BF16)를 올렸을 때의 계산값. gpu_memory_utilization=0.9
const X0 = 24;
const PX = 26;                 // 1GiB당 픽셀 (24GiB = 624px)
const g = (v) => X0 + v * PX;
const BY = 60, BH = 36;
const kvTicks = [18, 19, 20, 21].map(g);
const R2 = 186, R3 = 222, RH = 24;
---

<div class="dg">
<svg width="100%" viewBox="0 0 672 268" xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="24GiB 가운데 가중치가 15GiB, 활성화 버퍼가 1~2GiB, 남겨 두는 여유분이 2.4GiB라 KV 캐시에는 4.6~5.6GiB가 남는다. 128K 토큰 요청 하나에 필요한 16GiB의 3분의 1 정도다">

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">RTX 4090 24GiB · Llama 3.1 8B · gpu_memory_utilization=0.9</text>

<!-- 막대 위 라벨 -->
<text class="cap" x={g(16)} y={BY - 10} text-anchor="middle" fill="var(--muted)">활성화 버퍼 1~2GiB</text>
<text class="cap" x="648" y={BY - 10} text-anchor="end" fill="var(--muted)">여유분 2.4GiB</text>

<!-- 24GiB 막대 -->
<rect x={g(0)} y={BY} width={15 * PX} height={BH} rx={3} fill="var(--bg-soft)" stroke="var(--rule)" stroke-width="1"/>
<text class="hd" x={g(7.5)} y={BY + 23} text-anchor="middle" fill="var(--ink)">가중치 약 15GiB</text>
<rect x={g(15)} y={BY} width={PX} height={BH} fill="var(--muted)" fill-opacity="0.35"/>
<rect x={g(16)} y={BY} width={PX} height={BH} fill="var(--muted)" fill-opacity="0.15"/>
<rect x={g(17)} y={BY} width={4.6 * PX} height={BH} fill="var(--accent)" fill-opacity="0.18" stroke="var(--accent)" stroke-width="1.5"/>
{kvTicks.map((x) => <line x1={x} y1={BY + 6} x2={x} y2={BY + BH - 6} stroke="var(--accent)" stroke-width="1" stroke-opacity="0.6"/>)}
<rect x={g(21.6)} y={BY} width={2.4 * PX} height={BH} rx={3} fill="none" stroke="var(--rule)" stroke-width="1" stroke-dasharray="3 3"/>

<!-- 막대 아래 라벨 -->
<text class="cap" x={g(7.5)} y={BY + BH + 18} text-anchor="middle" fill="var(--muted)">BF16 · 80.3억 파라미터</text>
<text class="hd" x={g(19.3)} y={BY + BH + 18} text-anchor="middle" fill="var(--accent-strong)">KV 캐시 4.6~5.6GiB</text>
<text class="cap" x={g(19.3)} y={BY + BH + 34} text-anchor="middle" fill="var(--muted)">칸 하나 = 8K 토큰 대화 하나</text>
<text class="cap" x={g(19.3)} y={BY + BH + 50} text-anchor="middle" fill="var(--muted)">모두 합쳐 3만 8천~4만 6천 토큰</text>

<!-- 요청 하나와 비교 -->
<line x1="24" y1="164" x2="648" y2="164" stroke="var(--rule)" stroke-width="1"/>
<text class="cap" x="24" y="180" fill="var(--muted)">같은 축척으로 놓고 비교</text>
<rect x={g(0)} y={R2} width={16 * PX} height={RH} rx={3} fill="var(--accent)" fill-opacity="0.12" stroke="var(--accent)" stroke-width="1.5"/>
<text class="val" x={g(0) + 10} y={R2 + 16} fill="var(--accent-strong)">128K 토큰 요청 하나에 필요한 KV 캐시 16GiB</text>
<rect x={g(0)} y={R3} width={4.6 * PX} height={RH} rx={3} fill="var(--accent)" fill-opacity="0.18" stroke="var(--accent)" stroke-width="1.5"/>
<rect x={g(4.6)} y={R3} width={PX} height={RH} fill="var(--accent)" fill-opacity="0.08" stroke="var(--accent)" stroke-width="1" stroke-dasharray="3 3"/>
<text class="val" x={g(5.6) + 12} y={R3 + 16} fill="var(--ink)">이 카드에서 KV 캐시에 쓸 수 있는 메모리 4.6~5.6GiB</text>

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .val { font-size: 11.5px; }
.dg .cap { font-size: 11px; }
.dg .hd { font-size: 12px; font-weight: 600; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
