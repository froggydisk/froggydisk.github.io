---
/**
 * 공격자가 통제할 수 있는 표면, 서버의 신뢰 영역, 보호할 자산을 세 열로 놓는다.
 * 표면에서 온 것은 무엇이든 서버의 검사를 지나야 자산에 닿는다.
 */
const W = 190;
const GAP = 27;
const Y = 50;
const H_BOX = 150;
const cols = [
  { title: '공격자가 통제하는 표면', items: ['질문', '업로드 문서 · 문서 안의 링크', 'OCR 텍스트 · 음성 전사', '도구가 돌려준 설명'], tone: 'bad' },
  { title: '서버 · 신뢰 영역', items: ['인증된 Actor', '권한 행 (ACL · grants)', '스키마 · 인용 검증기', '도구 허용 목록 · 멱등성'], tone: 'strong' },
  { title: '보호할 자산', items: ['비공개 문서', '다른 사용자의 대화 · 티켓', '등록 권한', 'API 자격 증명 · 감사 기록'], tone: 'asset' },
].map((c, i) => ({ ...c, x: 24 + i * (W + GAP) }));
const MID = Y + H_BOX / 2;
const H = 262;
---

<div class="dg">
<svg width="100%" viewBox={`0 0 672 ${H}`} xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="공격자가 통제하는 표면은 질문, 업로드 문서와 그 안의 링크, OCR 텍스트와 음성 전사, 도구가 돌려준 설명이다. 서버의 신뢰 영역에는 인증된 Actor, 권한 행, 스키마와 인용 검증기, 도구 허용 목록과 멱등성이 있다. 보호할 자산은 비공개 문서, 다른 사용자의 대화와 티켓, 등록 권한, API 자격 증명과 감사 기록이다. 표면에서 온 것은 서버의 검사를 지나야 자산에 닿는다">

<defs>
  <marker id="tzEnd" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
    <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--muted)"/>
  </marker>
</defs>

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">표면 · 신뢰 영역 · 자산</text>

{cols.map((c) => (
  <>
    <rect x={c.x} y={Y} width={W} height={H_BOX} rx="3" fill={c.tone === 'strong' ? 'var(--bg-soft)' : 'none'}
          stroke={c.tone === 'strong' ? 'var(--ink)' : c.tone === 'bad' ? 'var(--accent-strong)' : 'var(--rule)'} stroke-width={c.tone === 'strong' ? 1.6 : 1.2}
          stroke-dasharray={c.tone === 'bad' ? '4 3' : undefined}/>
    <text class="box" x={c.x + 12} y={Y + 22} fill={c.tone === 'bad' ? 'var(--accent-strong)' : 'var(--ink)'}>{c.title}</text>
    <path d={`M ${c.x + 12} ${Y + 32} H ${c.x + W - 12}`} fill="none" stroke="var(--rule)" stroke-width="1"/>
    {c.items.map((it, k) => (
      <text class="line" x={c.x + 12} y={Y + 54 + k * 24} fill="var(--body)">{it}</text>
    ))}
  </>
))}
{cols.slice(0, -1).map((c, i) => (
  <path d={`M ${c.x + W + 2} ${MID} H ${cols[i + 1].x - 3}`} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#tzEnd)"/>
))}

<text class="cap" x="24" y={H - 30} fill="var(--body)">질문의 tenant 문자열이나 모델이 만든 user_id는 인증의 결과가 아니다. Actor는 신뢰된 호스트가 넘기고 도구 인자에는 신원 필드가 없다</text>
<text class="cap" x="24" y={H - 12} fill="var(--muted)">입력 경로를 더할 때마다 어느 자산에 닿는지 갱신한다. 문서 다운로드 도구를 붙이면 도구가 갈 수 있는 네트워크 주소도 검토 대상이다</text>

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .box { font-size: 12px; font-weight: 550; }
.dg .line { font-size: 11px; }
.dg .cap { font-size: 10.5px; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
