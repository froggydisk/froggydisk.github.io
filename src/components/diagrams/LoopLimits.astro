---
/**
 * 루프를 멈추는 네 가지 한도와, 크레딧 12단위가 실제 실행에서 어떻게 소모되는지 두 예로 보인다.
 * 계획 1단위, 도구 실행 2단위. 실행 전에 잔액을 검사한다.
 */
const W = 144;
const GAP = 16;
const Y = 50;
const cards = [
  { title: '단계 한도', val: '4', sub: '계획 제안 횟수' },
  { title: '크레딧', val: '12', sub: '계획 1 · 도구 실행 2' },
  { title: '시간', val: '30초', sub: '단조 증가 시계 · 마감' },
  { title: '반복 지문', val: '=', sub: '같은 도구 · 같은 인자' },
].map((c, i) => ({ ...c, x: 24 + i * (W + GAP) }));

const CELL = 20;
const CGAP = 4;
const METER_X = 200;
const runs = [
  { label: '조회 후 종료', y: 160, used: [{ n: 1, t: '계획' }, { n: 2, t: 'get_ticket' }, { n: 1, t: '계획' }], end: 'completed · 2단계 · 4크레딧' },
  { label: '크레딧 1만 남음', y: 200, used: [{ n: 1, t: '계획' }], end: 'budget · 도구 호출 없음', short: true },
];
const H = 250;
---

<div class="dg">
<svg width="100%" viewBox={`0 0 672 ${H}`} xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="루프는 단계 한도 4, 크레딧 12, 시간 30초, 같은 도구와 인자의 반복 지문 네 가지로 멈춘다. 계획은 1단위, 도구 실행은 2단위다. 조회 후 종료는 계획, 조회, 계획으로 2단계 4크레딧을 썼고, 크레딧이 1만 남은 초안 요청은 계획은 했지만 도구를 부르지 않고 budget으로 끝났다">

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">루프를 멈추는 네 가지 한도</text>

{cards.map((c) => (
  <>
    <rect x={c.x} y={Y} width={W} height="70" rx="3" fill="var(--bg-soft)" stroke="var(--rule)" stroke-width="1"/>
    <text class="cap" x={c.x + 12} y={Y + 18} fill="var(--muted)">{c.title}</text>
    <text class="val" x={c.x + 12} y={Y + 44} fill="var(--ink)">{c.val}</text>
    <text class="sub" x={c.x + 12} y={Y + 60} fill="var(--muted)">{c.sub}</text>
  </>
))}

<text class="cap" x="24" y="146" fill="var(--muted)">크레딧 12단위가 소모되는 두 예 (experiments/agent-control.json)</text>
{runs.map((r) => {
  let i = 0;
  const cells = [];
  r.used.forEach((u) => { for (let k = 0; k < u.n; k++) cells.push({ idx: i++, t: u.t }); });
  return (
    <>
      <text class="line" x="24" y={r.y + 15} fill="var(--ink)">{r.label}</text>
      {Array.from({ length: 12 }).map((_, k) => {
        const used = cells.find((c) => c.idx === k);
        const avail = r.short ? k < 1 : true;
        return (
          <rect x={METER_X + k * (CELL + CGAP)} y={r.y} width={CELL} height={CELL} rx="2"
                fill={used ? (used.t === '계획' ? 'var(--muted)' : 'var(--ink)') : avail ? 'var(--bg-soft)' : 'none'}
                stroke={avail ? 'var(--rule)' : 'var(--rule)'} stroke-width="1" stroke-dasharray={avail ? undefined : '2 2'}/>
        );
      })}
      <text class="sub" x={METER_X + 12 * (CELL + CGAP) + 8} y={r.y + 15} fill={r.short ? 'var(--accent-strong)' : 'var(--ink)'}>{r.end}</text>
    </>
  );
})}
<rect x="200" y="226" width="12" height="10" fill="var(--muted)"/><text class="sub" x="216" y="235" fill="var(--muted)">계획 1</text>
<rect x="270" y="226" width="12" height="10" fill="var(--ink)"/><text class="sub" x="286" y="235" fill="var(--muted)">도구 실행 2</text>
<rect x="360" y="226" width="12" height="10" fill="none" stroke="var(--rule)" stroke-dasharray="2 2"/><text class="sub" x="376" y="235" fill="var(--muted)">없는 예산 · 실행 전에 검사하므로 도구를 부르지 않는다</text>

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .val { font-family: var(--font-mono); font-size: 18px; font-weight: 600; }
.dg .line { font-size: 11.5px; font-weight: 550; }
.dg .sub { font-size: 10.5px; }
.dg .cap { font-size: 10.5px; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
