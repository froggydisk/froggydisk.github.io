---
/**
 * 설명용 2차원 임베딩 공간. 문서 다섯 개와 질문 하나를 점으로 놓고, 단어가 겹치지 않는
 * 질문이 교육비 문서 가까이에 오는 것을 보인다. 좌표는 설명용이고 실제 모델은 384차원이다.
 */
const points = [
  { label: '교육비 안내', x: 300, y: 100 },
  { label: '휴가 신청', x: 130, y: 120 },
  { label: '출장 교통비', x: 330, y: 215 },
  { label: '계정 비밀번호', x: 110, y: 235 },
  { label: '노트북 고장', x: 215, y: 248 },
];
const query = { label: '강의 결제 지원액?', x: 262, y: 130 };
const target = points[0];

const NX = 432;
const notes = [
  ['좌표 하나에 ‘교육비’ 같은', '이름은 없다'],
  ['실제 모델은 384차원을', '돌려준다'],
  ['해시와 다르다. 비슷한 뜻이', '가까이 오도록 학습된 결과다'],
  ['IT-1042 같은 식별자는', '정확 일치로 찾는다'],
];
const H = 300;
---

<div class="dg">
<svg width="100%" viewBox={`0 0 672 ${H}`} xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="설명용 2차원 그림에서 문서 다섯 개가 점으로 흩어져 있고, 겹치는 단어가 없는 질문 강의 결제 지원액이 교육비 안내 문서 가까이에 놓인다. 좌표에는 이름이 없고 실제 모델은 384차원이며, 식별자는 정확 일치로 찾는다">

<defs>
  <marker id="esEnd" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
    <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--rule)"/>
  </marker>
</defs>

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">임베딩 공간 · 설명용 2차원</text>

<!-- 축 -->
<path d="M 50 270 H 392" fill="none" stroke="var(--rule)" stroke-width="1.2" marker-end="url(#esEnd)"/>
<path d="M 50 270 V 48" fill="none" stroke="var(--rule)" stroke-width="1.2" marker-end="url(#esEnd)"/>

<!-- 질문과 가까운 문서를 잇는 점선 -->
<path d={`M ${query.x} ${query.y} L ${target.x} ${target.y}`} fill="none" stroke="var(--accent-strong)" stroke-width="1.2" stroke-dasharray="3 3"/>
<text class="cap" x={target.x + 40} y={target.y + 52} text-anchor="middle" fill="var(--accent-strong)">가깝다 · cos 0.875</text>

{points.map((p) => (
  <>
    <circle cx={p.x} cy={p.y} r="5" fill="var(--ink)"/>
    <text class="pt" x={p.x + 10} y={p.y + 4} fill="var(--ink)">{p.label}</text>
  </>
))}
<circle cx={query.x} cy={query.y} r="6" fill="var(--accent-strong)"/>
<text class="pt" x={query.x - 10} y={query.y + 4} text-anchor="end" fill="var(--accent-strong)">{query.label}</text>

<!-- 오른쏙 설명 -->
{notes.map((n, i) => (
  <>
    <circle cx={NX + 5} cy={64 + i * 54} r="2.5" fill="var(--muted)"/>
    {n.map((l, k) => (
      <text class="note" x={NX + 16} y={68 + i * 54 + k * 16} fill="var(--body)">{l}</text>
    ))}
  </>
))}

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .pt { font-size: 11.5px; font-weight: 550; }
.dg .note { font-size: 11px; }
.dg .cap { font-size: 10.5px; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
