---
/**
 * 로컬 HTTP 서버의 읽기 요청 경로 여덟 단계와, 그와 분리된 두 경로(색인 갱신·티켓 등록).
 * 서버는 127.0.0.1에만 붙고 로컬 토큰을 요구하며 question 하나만 받는다.
 */
const W = 68;
const GAP = 11; // 8 × 68 + 7 × 11 = 621
const Y = 56;
const H_BOX = 46;
const steps = [['수신'], ['인증', '토큰'], ['입력', '검사'], ['검색'], ['문맥'], ['생성'], ['응답', '검증'], ['전송']].map((l, i) => ({ lines: l, x: 24 + i * (W + GAP), strong: i === 1 || i === 6 }));
const MID = Y + H_BOX / 2;
const LANES = [
  { x: 24, label: '색인 갱신 · 관리 경로', sub: '읽기 요청과 다른 작업 · 순번 규칙' },
  { x: 348, label: '티켓 등록 · 확인된 쓰기 경로', sub: '초안 → 확인 → 등록 · 멱등성' },
].map((l) => ({ ...l, y: 140, w: 300, h: 50 }));
const H = 258;
---

<div class="dg">
<svg width="100%" viewBox={`0 0 672 ${H}`} xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="읽기 요청은 수신, 토큰 인증, 입력 검사, 검색, 문맥, 생성, 응답 검증, 전송 여덟 단계를 지난다. 색인 갱신은 관리 경로, 티켓 등록은 확인된 쓰기 경로로 분리한다. 서버는 127.0.0.1에만 붙고 로컬 토큰을 요구하며 요청 본문은 question 하나만 받고 tenant를 추가하면 거부한다">

<defs>
  <marker id="srpEnd" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
    <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--muted)"/>
  </marker>
</defs>

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">book_service.py의 요청 경로</text>
<text class="cap" x="24" y={Y - 10} fill="var(--muted)">읽기 요청 · /ask · 같은 프로세스</text>

{steps.map((s) => (
  <>
    <rect x={s.x} y={Y} width={W} height={H_BOX} rx="3" fill="var(--bg-soft)" stroke={s.strong ? 'var(--ink)' : 'var(--rule)'} stroke-width={s.strong ? 1.6 : 1}/>
    {s.lines.map((l, k) => (
      <text class="box" x={s.x + W / 2} y={s.lines.length === 1 ? Y + 28 : Y + 20 + k * 16} text-anchor="middle" fill="var(--ink)">{l}</text>
    ))}
  </>
))}
{steps.slice(0, -1).map((s, i) => (
  <path d={`M ${s.x + W + 2} ${MID} H ${steps[i + 1].x - 3}`} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#srpEnd)"/>
))}

<text class="cap" x="24" y={LANES[0].y - 10} fill="var(--muted)">분리된 경로 · 데이터와 권한의 책임이 다르다</text>
{LANES.map((l) => (
  <>
    <rect x={l.x} y={l.y} width={l.w} height={l.h} rx="3" fill="none" stroke="var(--rule)" stroke-width="1" stroke-dasharray="4 3"/>
    <text class="box" x={l.x + 12} y={l.y + 21} fill="var(--ink)">{l.label}</text>
    <text class="sub" x={l.x + 12} y={l.y + 38} fill="var(--muted)">{l.sub}</text>
  </>
))}

<text class="cap" x="24" y={H - 30} fill="var(--body)">127.0.0.1에만 바인딩 + 로컬 토큰. 루프백 주소가 신원을 증명하지 않으니 토큰 검사를 빼지 않는다</text>
<text class="cap" x="24" y={H - 12} fill="var(--muted)">본문은 question 하나 · tenant를 붙이면 거부 · HTTP 200 안에도 contract_failed가 있을 수 있다 · http.server는 교육용</text>

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .box { font-size: 11.5px; font-weight: 550; }
.dg .sub { font-size: 10.5px; }
.dg .cap { font-size: 10.5px; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
