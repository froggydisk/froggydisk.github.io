---
const MAIN = 96, DEV = 228, HOTFIX = 162;

const nodes = {
  branch: { x: 112, y: MAIN,   r: 6,  hue: 5 },
  hotfix: { x: 176, y: HOTFIX, r: 8,  hue: 5 },
  fMain:  { x: 264, y: MAIN,   r: 13, hue: 5 },
  fDev:   { x: 352, y: DEV,    r: 13, hue: 5 },
  revert: { x: 456, y: MAIN,   r: 13, hue: 4 },
  sync:   { x: 560, y: DEV,    r: 14, hue: 1 },
};

// 연결선 끝을 원 반지름만큼 잘라내 노드를 파고들지 않게 한다.
function link(a, b, cx, cy, gap = 3) {
  const trim = (p, tx, ty, r) => {
    const dx = tx - p.x, dy = ty - p.y;
    const d = Math.hypot(dx, dy) || 1;
    const k = (r + gap) / d;
    return [(p.x + dx * k).toFixed(1), (p.y + dy * k).toFixed(1)];
  };
  const [sx, sy] = trim(a, cx, cy, a.r);
  const [ex, ey] = trim(b, cx, cy, b.r);
  return `M ${sx} ${sy} Q ${cx} ${cy} ${ex} ${ey}`;
}

const links = [
  { d: link(nodes.branch, nodes.hotfix, 144, 128), hue: 5, w: 1.5, dash: null },
  { d: link(nodes.hotfix, nodes.fMain,  220, 128), hue: 5, w: 1.5, dash: null },
  { d: link(nodes.hotfix, nodes.fDev,   264, 196), hue: 5, w: 1.5, dash: '4 3' },
  { d: link(nodes.revert, nodes.sync,   516, 162), hue: 1, w: 2,   dash: null },
];

const badges = [
  { x: 112, t: '① 분기' },
  { x: 264, t: '② main 머지' },
  { x: 352, t: '③ develop 동기화' },
  { x: 456, t: '④ revert' },
  { x: 560, t: '⑤ 정기 동기화' },
];
---

<div class="dg">
<svg width="100%" viewBox="0 0 672 330" xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="main에서 revert한 뒤 정기 동기화를 하면 develop의 코드가 사라지는 다섯 단계">

<text class="ttl" x="336" y="20" text-anchor="middle" fill="var(--muted)">핫픽스 함정이 터지기까지 다섯 단계</text>

<!-- 브랜치 -->
<text class="m branch" x="64" y={MAIN + 5} text-anchor="end" fill="var(--ink)">main</text>
<text class="m branch" x="64" y={DEV + 5} text-anchor="end" fill="var(--ink)">develop</text>
<line x1="76" y1={MAIN} x2="640" y2={MAIN} stroke="var(--rule)" stroke-width="1.5"/>
<line x1="76" y1={DEV} x2="640" y2={DEV} stroke="var(--rule)" stroke-width="1.5"/>

<!-- 연결선을 노드보다 먼저 그린다 -->
{links.map((l) => (
  <path d={l.d} fill="none" stroke={`var(--dg-${l.hue})`} stroke-width={l.w} stroke-dasharray={l.dash ?? undefined}/>
))}

<!-- 노드 -->
<circle cx={nodes.branch.x} cy={nodes.branch.y} r={nodes.branch.r} fill="var(--rule)"/>

<circle cx={nodes.hotfix.x} cy={nodes.hotfix.y} r={nodes.hotfix.r} fill="var(--dg-5-soft)" stroke="var(--dg-5)" stroke-width="1.5"/>
<text class="m lbl" x={nodes.hotfix.x} y={nodes.hotfix.y + 26} text-anchor="middle" fill="var(--dg-5-ink)">hotfix</text>

<circle cx={nodes.fMain.x} cy={nodes.fMain.y} r={nodes.fMain.r} fill="var(--dg-5-soft)" stroke="var(--dg-5)" stroke-width="1.5"/>
<text class="m mark" x={nodes.fMain.x} y={nodes.fMain.y + 4} text-anchor="middle" fill="var(--dg-5-ink)">F</text>
<text class="lbl" x={nodes.fMain.x} y={nodes.fMain.y - 24} text-anchor="middle" fill="var(--body)">feature 머지</text>

<circle cx={nodes.fDev.x} cy={nodes.fDev.y} r={nodes.fDev.r} fill="var(--dg-5-soft)" stroke="var(--dg-5)" stroke-width="1.5"/>
<text class="m mark" x={nodes.fDev.x} y={nodes.fDev.y + 4} text-anchor="middle" fill="var(--dg-5-ink)">F</text>
<text class="lbl" x={nodes.fDev.x} y={nodes.fDev.y + 30} text-anchor="middle" fill="var(--body)">feature 동기화</text>

<circle cx={nodes.revert.x} cy={nodes.revert.y} r={nodes.revert.r} fill="var(--dg-4-soft)" stroke="var(--dg-4)" stroke-width="1.5"/>
<text class="m mark" x={nodes.revert.x} y={nodes.revert.y + 4} text-anchor="middle" fill="var(--dg-4-ink)">R</text>
<text class="lbl" x={nodes.revert.x} y={nodes.revert.y - 24} text-anchor="middle" fill="var(--dg-4-ink)">revert</text>

<circle cx={nodes.sync.x} cy={nodes.sync.y} r={nodes.sync.r} fill="var(--dg-1-soft)" stroke="var(--dg-1)" stroke-width="1.8"/>
<text class="m mark" x={nodes.sync.x} y={nodes.sync.y + 4} text-anchor="middle" fill="var(--dg-1-ink)">M</text>
<text class="lbl" x={nodes.sync.x} y={nodes.sync.y + 32} text-anchor="middle" fill="var(--dg-1-ink)">정기 동기화</text>

<!-- 폭발 -->
<g transform={`translate(612, ${DEV})`}>
  <path d="M 0 -16 L 4.5 -4.5 L 16 0 L 4.5 4.5 L 0 16 L -4.5 4.5 L -16 0 L -4.5 -4.5 z" fill="var(--dg-1)"/>
</g>
<text class="cap" x="612" y={DEV - 24} text-anchor="middle" fill="var(--dg-1-ink)">코드 사라짐</text>

<!-- 단계 -->
<line x1="76" y1="284" x2="600" y2="284" stroke="var(--rule)" stroke-width="1" stroke-dasharray="3 3"/>
<text class="m cap" x="640" y="288" text-anchor="end" fill="var(--muted)">time →</text>
{badges.map((b) => (
  <text class="cap" x={b.x} y="306" text-anchor="middle" fill="var(--muted)">{b.t}</text>
))}

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .m { font-family: var(--font-mono); }
.dg .branch { font-size: 13px; font-weight: 700; }
.dg .mark { font-size: 12px; font-weight: 700; }
.dg .lbl { font-size: 12px; font-weight: 600; }
.dg .cap { font-size: 11px; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
