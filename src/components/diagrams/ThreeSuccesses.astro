---
/**
 * 모델 호출의 성공을 전송·생성·업무 세 단계로 나눈다. 오른쪽 단계는 왼쪽 단계를
 * 전제하고, 어댑터의 status == "ok"는 둘째 단계까지만 말한다.
 */
const W = 190;
const GAP = 27; // 3 × 190 + 2 × 27 = 624
const Y = 50;
const H_BOX = 96;
const steps = [
  { title: '① 전송 성공', check: 'HTTP 응답을 받았다', fail: '인증 오류 · 시간 초과 · 429', strong: false },
  { title: '② 생성 성공', check: 'completed + 완료된 텍스트', fail: '미완료 · 거절 · 도구 요청', strong: false, tag: 'status == "ok"' },
  { title: '③ 업무 성공', check: '유효한 정책 · 근거 · 상태', fail: '20만 원이라고 답한다', strong: true, tag: 'answered' },
].map((s, i) => ({ ...s, x: 24 + i * (W + GAP) }));
const MID = Y + H_BOX / 2;
const H = Y + H_BOX + 46; // 192
---

<div class="dg">
<svg width="100%" viewBox={`0 0 672 ${H}`} xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="모델 호출의 성공은 전송 성공, 생성 성공, 업무 성공 세 단계다. HTTP 응답을 받은 것이 전송 성공, 완료된 텍스트가 온 것이 생성 성공이고 어댑터의 ok는 여기까지다. 유효한 정책과 근거로 답한 업무 성공은 평가가 정한다">

<defs>
  <marker id="tsEnd" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
    <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--muted)"/>
  </marker>
</defs>

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">세 단계의 성공</text>

{steps.map((s) => (
  <>
    {s.tag && <text class="m" x={s.x + W / 2} y={Y - 9} text-anchor="middle" fill="var(--muted)">{s.tag}</text>}
    <rect x={s.x} y={Y} width={W} height={H_BOX} rx="3" fill="var(--bg-soft)"
          stroke={s.strong ? 'var(--ink)' : 'var(--rule)'} stroke-width={s.strong ? 1.6 : 1}/>
    <text class="box" x={s.x + 14} y={Y + 24} fill="var(--ink)">{s.title}</text>
    <text class="line" x={s.x + 14} y={Y + 48} fill="var(--body)">{s.check}</text>
    <text class="line" x={s.x + 14} y={Y + 76} fill="var(--accent-strong)">{'실패: ' + s.fail}</text>
  </>
))}
{steps.slice(0, -1).map((s, i) => (
  <path d={`M ${s.x + W + 2} ${MID} H ${steps[i + 1].x - 3}`} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#tsEnd)"/>
))}

<text class="cap" x="336" y={H - 12} text-anchor="middle" fill="var(--muted)">오른쪽은 왼쪽을 전제한다. 어댑터가 보증하는 것은 ②까지이고 ③은 평가가 정한다</text>

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .box { font-size: 13px; font-weight: 550; }
.dg .line { font-size: 11px; }
.dg .m { font-family: var(--font-mono); font-size: 10.5px; }
.dg .cap { font-size: 11px; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
