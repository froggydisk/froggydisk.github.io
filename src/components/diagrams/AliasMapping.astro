---
/**
 * 모델 입력의 짧은 별칭 s1이 서버의 대응표를 거쳐 실제 청크와 문서·리비전·문자 구간으로
 * 되돌아가는 경로. 예산에서 빠진 s2를 인용하면 unknown_source다.
 */
const W = 140;
const GAP = 22; // 4 × 140 + 3 × 22 = 626
const Y = 56;
const H_BOX = 60;
const steps = [
  { title: '모델 입력의 별칭', line: 's1', mono: true },
  { title: '이번 요청의 대응표', line: '서버가 보관한다', strong: true },
  { title: '실제 청크 ID', line: '3f9a…', mono: true },
  { title: '문서 · 리비전 · 구간', line: 'edu · v2 · 120–184' },
].map((s, i) => ({ ...s, x: 24 + i * (W + GAP) }));
const MID = Y + H_BOX / 2;
const BAD_Y = 146;
const H = 212;
---

<div class="dg">
<svg width="100%" viewBox={`0 0 672 ${H}`} xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="모델은 s1 같은 짧은 별칭으로 인용하고, 서버가 보관한 이번 요청의 대응표가 별칭을 실제 청크 ID로, 다시 문서 edu 리비전 v2의 문자 구간으로 되돌린다. 예산 때문에 빠진 s2를 인용하면 이번 생성에 준 근거가 아니라 unknown_source로 거부한다">

<defs>
  <marker id="amEnd" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
    <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--muted)"/>
  </marker>
</defs>

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">별칭에서 원문 구간으로</text>

{steps.map((s) => (
  <>
    <rect x={s.x} y={Y} width={W} height={H_BOX} rx="3" fill="var(--bg-soft)"
          stroke={s.strong ? 'var(--ink)' : 'var(--rule)'} stroke-width={s.strong ? 1.6 : 1}/>
    <text class="cap" x={s.x + W / 2} y={Y + 20} text-anchor="middle" fill="var(--muted)">{s.title}</text>
    <text class={s.mono ? 'm' : 'line'} x={s.x + W / 2} y={Y + 42} text-anchor="middle" fill="var(--ink)">{s.line}</text>
  </>
))}
{steps.slice(0, -1).map((s, i) => (
  <path d={`M ${s.x + W + 2} ${MID} H ${steps[i + 1].x - 3}`} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#amEnd)"/>
))}

<!-- 예산에서 빠진 s2 -->
<rect x="24" y={BAD_Y} width="200" height="34" rx="3" fill="none" stroke="var(--rule)" stroke-width="1" stroke-dasharray="4 3"/>
<text class="line" x="124" y={BAD_Y + 21} text-anchor="middle" fill="var(--muted)"><tspan class="m">s2</tspan> · 예산 때문에 빠진 후보</text>
<path d={`M 226 ${BAD_Y + 17} H 262`} fill="none" stroke="var(--accent-strong)" stroke-width="1.2" stroke-dasharray="3 3" marker-end="url(#amEnd)"/>
<circle cx="276" cy={BAD_Y + 17} r="7" fill="var(--accent-strong)"/>
<text class="ic" x="276" y={BAD_Y + 20.5} text-anchor="middle" fill="var(--bg)">✕</text>
<text class="line" x="292" y={BAD_Y + 21} fill="var(--body)"><tspan class="m" fill="var(--ink)">unknown_source</tspan> · 이번 생성에 준 근거가 아니다</text>

<text class="cap" x="336" y={H - 12} text-anchor="middle" fill="var(--muted)">별칭은 요청마다 새로 만든다. 다른 요청의 s1은 다른 문서다. 영구 출처 ID로 저장하지 않는다</text>

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .line { font-size: 11.5px; }
.dg .m { font-family: var(--font-mono); font-size: 11.5px; font-weight: 600; }
.dg .ic { font-size: 9px; font-weight: 700; }
.dg .cap { font-size: 10.5px; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
