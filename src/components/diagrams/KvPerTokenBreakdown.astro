---
// Llama 3.1 8B 토큰 하나가 KV 캐시에 남기는 것을 입체로 그린다.
// 토큰 하나(레이어 32장) → 레이어 한 장(KV 헤드 8쌍) → KV 헤드 하나(K·V 벡터) → 값 하나.
// 점선은 앞 그림에서 진하게 표시한 부분을 꺼내 크게 그렸다는 뜻이다. 깊이 방향은 모두 왼쪽 위(-dx, -dy)로 맞춘다
const deck = Array.from({ length: 31 }, (_, k) => 31 - k);   // 뒤에서부터 그린다
const A = { x: 96, y: 230, w: 150, h: 72 };                    // 맨 앞 레이어
const B = { x: 330, y: 70, w: 200, h: 88, dx: 12, dy: 9 };     // 레이어 한 장
const pairs = Array.from({ length: 8 }, (_, p) => B.y + 3 + p * 11);
const C = { x: 330, w: 200, ky: 214, vy: 238, h: 16, dx: 8, dy: 6 };
const E = { x: 330, y: 300, s: 26, dx: 8, dy: 6 };
const LX = 546;
const face = (x, y, w, h, dx, dy) => ({
  top: `${x},${y} ${x + w},${y} ${x + w - dx},${y - dy} ${x - dx},${y - dy}`,
  left: `${x},${y} ${x - dx},${y - dy} ${x - dx},${y + h - dy} ${x},${y + h}`,
});
const fb = face(B.x, B.y, B.w, B.h, B.dx, B.dy);
const fk = face(C.x, C.ky, C.w, C.h, C.dx, C.dy);
const fv = face(C.x, C.vy, C.w, C.h, C.dx, C.dy);
const fe = face(E.x, E.y, E.s, E.s, E.dx, E.dy);
const hp = pairs[7];   // 꺼내는 헤드 쌍 (맨 아래)
const ax = A.x + A.w / 2 - 34;
---

<div class="dg">
<svg width="100%" viewBox="0 0 672 362" xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="토큰 하나의 KV 캐시는 레이어 32장으로 이루어지고, 레이어 한 장에는 KV 헤드 8쌍이, KV 헤드 하나에는 128칸짜리 키 벡터와 값 벡터가 들어 있다. 한 칸이 2바이트라 모두 곱하면 128KiB다">

<defs>
  <pattern id="kvTokTick" x="0" y="0" width="1.5625" height="10" patternUnits="userSpaceOnUse">
    <rect width="1.05" height="10" fill="var(--muted)" fill-opacity="0.5"/>
  </pattern>
</defs>

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">토큰 하나를 처리하면 메모리에 남는 것 · Llama 3.1 8B</text>

<!-- ① 토큰 하나: 레이어 32장 -->
{deck.map((k) => (
  <rect x={A.x - k * 2.2} y={A.y - k * 1.6} width={A.w} height={A.h} rx="2" fill="var(--bg)" stroke="var(--rule)" stroke-width="1"/>
))}
<rect x={A.x} y={A.y} width={A.w} height={A.h} rx="2" fill="var(--bg-soft)" stroke="var(--ink)" stroke-width="1.6"/>
{Array.from({ length: 8 }, (_, p) => (
  <g>
    <rect x={A.x + 8} y={A.y + 6 + p * 8} width={A.w - 16} height="2.6" fill="var(--muted)" fill-opacity="0.45"/>
    <rect x={A.x + 8} y={A.y + 9 + p * 8} width={A.w - 16} height="2.6" fill="var(--muted)" fill-opacity="0.45"/>
  </g>
))}
<text class="hd" x={ax} y="334" text-anchor="middle" fill="var(--ink)">토큰 하나 · 128KiB</text>
<text class="cap" x={ax} y="351" text-anchor="middle" fill="var(--muted)">레이어 32장 (4KiB × 32)</text>

<!-- ① → ② 연결선 -->
<line x1={A.x + A.w} y1={A.y} x2={B.x - B.dx} y2={B.y - B.dy} stroke="var(--muted)" stroke-width="1" stroke-dasharray="3 3"/>
<line x1={A.x + A.w} y1={A.y + A.h} x2={B.x - B.dx} y2={B.y + B.h - B.dy} stroke="var(--muted)" stroke-width="1" stroke-dasharray="3 3"/>

<!-- ② 레이어 한 장: KV 헤드 8쌍 -->
<polygon points={fb.top} fill="var(--bg-soft)" stroke="var(--ink)" stroke-width="1"/>
<polygon points={fb.left} fill="var(--bg-soft)" stroke="var(--ink)" stroke-width="1"/>
<rect x={B.x} y={B.y} width={B.w} height={B.h} fill="var(--bg)" stroke="var(--ink)" stroke-width="1.2"/>
{pairs.map((y) => (
  <g>
    <rect x={B.x + 6} y={y} width={B.w - 12} height="4" fill="url(#kvTokTick)"/>
    <rect x={B.x + 6} y={y + 4.5} width={B.w - 12} height="4" fill="url(#kvTokTick)"/>
  </g>
))}
<rect x={B.x + 3} y={hp - 1.5} width={B.w - 6} height="11.5" rx="1.5" fill="none" stroke="var(--ink)" stroke-width="1.6"/>
<text class="hd" x={LX} y="92" fill="var(--ink)">레이어 한 장</text>
<text class="m res" x={LX} y="111" fill="var(--ink)">4KiB</text>
<text class="cap" x={LX} y="128" fill="var(--muted)">KV 헤드 8쌍</text>
<text class="cap" x={LX} y="144" fill="var(--muted)">(512B × 8)</text>

<!-- ② → ③ 연결선 -->
<line x1={B.x + 3} y1={hp + 10} x2={C.x - C.dx} y2={C.ky - C.dy} stroke="var(--muted)" stroke-width="1" stroke-dasharray="3 3"/>
<line x1={B.x + B.w - 3} y1={hp + 10} x2={C.x + C.w - C.dx} y2={C.ky - C.dy} stroke="var(--muted)" stroke-width="1" stroke-dasharray="3 3"/>

<!-- ③ KV 헤드 하나: K 벡터 + V 벡터 -->
<polygon points={fk.top} fill="var(--bg-soft)" stroke="var(--ink)" stroke-width="1"/>
<polygon points={fk.left} fill="var(--bg-soft)" stroke="var(--ink)" stroke-width="1"/>
<rect x={C.x} y={C.ky} width={C.w} height={C.h} fill="var(--bg)" stroke="var(--ink)" stroke-width="1.2"/>
<rect x={C.x} y={C.ky} width={C.w} height={C.h} fill="url(#kvTokTick)"/>
<polygon points={fv.top} fill="var(--bg-soft)" stroke="var(--ink)" stroke-width="1"/>
<polygon points={fv.left} fill="var(--bg-soft)" stroke="var(--ink)" stroke-width="1"/>
<rect x={C.x} y={C.vy} width={C.w} height={C.h} fill="var(--bg)" stroke="var(--ink)" stroke-width="1.2"/>
<rect x={C.x} y={C.vy} width={C.w} height={C.h} fill="url(#kvTokTick)"/>
<rect x={C.x} y={C.vy} width="3" height={C.h} fill="var(--ink)"/>
<text class="hd" x={LX} y="200" fill="var(--ink)">KV 헤드 하나</text>
<text class="m res" x={LX} y="227" fill="var(--ink)">K 256B</text>
<text class="m res" x={LX} y="251" fill="var(--ink)">V 256B</text>
<text class="cap" x={LX} y="270" fill="var(--muted)">벡터마다 128칸</text>

<!-- ③ → ④ 연결선 -->
<line x1={C.x} y1={C.vy + C.h} x2={E.x - E.dx} y2={E.y - E.dy} stroke="var(--muted)" stroke-width="1" stroke-dasharray="3 3"/>
<line x1={C.x + 3} y1={C.vy + C.h} x2={E.x + E.s - E.dx} y2={E.y - E.dy} stroke="var(--muted)" stroke-width="1" stroke-dasharray="3 3"/>

<!-- ④ 값 하나 -->
<polygon points={fe.top} fill="var(--bg-soft)" stroke="var(--ink)" stroke-width="1"/>
<polygon points={fe.left} fill="var(--bg-soft)" stroke="var(--ink)" stroke-width="1"/>
<rect x={E.x} y={E.y} width={E.s} height={E.s} fill="var(--bg)" stroke="var(--ink)" stroke-width="1.6"/>
<text class="hd" x={E.x + E.s + 14} y={E.y + 11} fill="var(--ink)">값 하나 · 2B</text>
<text class="cap" x={E.x + E.s + 14} y={E.y + 27} fill="var(--muted)">BF16 숫자 하나 (벡터의 한 칸)</text>


</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .m { font-family: var(--font-mono); }
.dg .res { font-size: 12.5px; font-weight: 600; }
.dg .cap { font-size: 11px; }
.dg .hd { font-size: 12px; font-weight: 700; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
