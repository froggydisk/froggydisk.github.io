---
/**
 * '캐시'라고 부르는 세 가지가 요청 경로의 어디에 있고 무엇을 재사용하는지 보인다.
 * 응답 캐시와 대화 이력은 애플리케이션이, 프롬프트 캐시는 제공자가 소유한다.
 */
const Y = 56;
const H_BOX = 44;
const nodes = [
  { label: '사용자', x: 24, w: 80 },
  { label: '애플리케이션', x: 140, w: 130 },
  { label: '문맥 구성', x: 306, w: 110 },
  { label: '제공자', x: 452, w: 96 },
  { label: '모델', x: 584, w: 64 },
];
const MID = Y + H_BOX / 2;

const CY = 130;
const CH = 54;
const caches = [
  { at: 1, name: '응답 캐시', what: '과거에 만든 결과를 다시 준다', rule: '키에 조직·사용자·권한·문서 판·프롬프트 판이 들어간다', x: 24, w: 250 },
  { at: 2, name: '대화 이력', what: '다음 요청에 필요한 정보를 보관한다', rule: '조직·사용자·세션이 다 일치할 때만 넣는다', x: 290, w: 190 },
  { at: 3, name: '프롬프트 캐시', what: '같은 접두사의 계산을 재사용한다', rule: '적중 여부는 사용량으로 확인한다', x: 496, w: 152 },
];
const H = CY + CH + 24; // 208
---

<div class="dg">
<svg width="100%" viewBox={`0 0 672 ${H}`} xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="캐시라고 부르는 것이 셋 있다. 애플리케이션의 응답 캐시는 과거 결과를 다시 주고, 문맥 구성의 대화 이력은 다음 요청에 필요한 정보를 보관하고, 제공자의 프롬프트 캐시는 같은 접두사의 계산을 재사용한다. 갱신과 권한의 책임이 각각 다르다">

<defs>
  <marker id="cpEnd" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
    <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--muted)"/>
  </marker>
</defs>

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">‘캐시’라고 부르는 세 가지의 자리</text>

{nodes.map((n) => (
  <>
    <rect x={n.x} y={Y} width={n.w} height={H_BOX} rx="3" fill="var(--bg-soft)" stroke="var(--rule)" stroke-width="1"/>
    <text class="box" x={n.x + n.w / 2} y={Y + 27} text-anchor="middle" fill="var(--ink)">{n.label}</text>
  </>
))}
{nodes.slice(0, -1).map((n, i) => (
  <path d={`M ${n.x + n.w + 2} ${MID} H ${nodes[i + 1].x - 3}`} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#cpEnd)"/>
))}

{caches.map((c) => (
  <>
    <path d={`M ${nodes[c.at].x + nodes[c.at].w / 2} ${Y + H_BOX + 2} V ${CY - 3}`} fill="none" stroke="var(--muted)" stroke-width="1.2" stroke-dasharray="3 3" marker-end="url(#cpEnd)"/>
    <rect x={c.x} y={CY} width={c.w} height={CH} rx="3" fill="none" stroke="var(--ink)" stroke-width="1.2"/>
    <text class="name" x={c.x + 10} y={CY + 16} fill="var(--ink)">{c.name}</text>
    <text class="sub" x={c.x + 10} y={CY + 31} fill="var(--body)">{c.what}</text>
    <text class="sub" x={c.x + 10} y={CY + 46} fill="var(--muted)">{c.rule}</text>
  </>
))}

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .box { font-size: 12.5px; font-weight: 550; }
.dg .name { font-size: 11.5px; font-weight: 550; }
.dg .sub { font-size: 10px; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
