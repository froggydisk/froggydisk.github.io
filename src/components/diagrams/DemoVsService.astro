---
/**
 * 데모는 질문·문서 전부·모델·화면 네 단계고, 서비스는 같은 열에 요청 검사·문서 검색·
 * 도구 실행·응답 검증이 더 있다. 두 줄을 같은 열에 맞춰 무엇이 더해지는지 보인다.
 */
const W = 76;
const GAP = 15;
const col = (i: number) => 24 + i * (W + GAP); // 24 … 570, 마지막 오른쪽 끝 646

const DEMO_Y = 52;
const DEMO_H = 46;
const demo = [
  { c: 0, lines: ['질문'] },
  { c: 2, lines: ['문서 전부', '붙이기'] },
  { c: 3, lines: ['모델'] },
  { c: 6, lines: ['화면'] },
].map((d) => ({ ...d, x: col(d.c) }));
const DEMO_MID = DEMO_Y + DEMO_H / 2;

const SVC_Y = 138;
const SVC_H = 74;
const service = [
  { title: '사용자 질문', sub: ['인증된 사용자'], added: false },
  { title: '요청 검사', sub: ['누가 물었나', '허용 범위'], added: true },
  { title: '문서 검색', sub: ['유효한 판', '읽을 권한'], added: true },
  { title: '모델', sub: ['답변 초안', '도구 제안'], added: false },
  { title: '도구 실행', sub: ['사용자 확인', '한 번만'], added: true },
  { title: '응답 검증', sub: ['근거 확인', '도구 결과'], added: true },
  { title: '사용자 응답', sub: ['상태 + 근거'], added: false },
].map((s, i) => ({ ...s, x: col(i) }));
const SVC_MID = SVC_Y + SVC_H / 2;

const H = SVC_Y + SVC_H + 24; // 236
---

<div class="dg">
<svg width="100%" viewBox={`0 0 672 ${H}`} xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="데모는 질문, 문서 전부 붙이기, 모델, 화면 네 단계다. 서비스는 같은 모델을 쓰지만 그 앞에 요청 검사와 문서 검색이, 뒤에 도구 실행과 응답 검증이 더 있다">

<defs>
  <marker id="dvsEnd" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
    <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--muted)"/>
  </marker>
</defs>

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">데모의 네 단계와 서비스의 일곱 단계</text>

<!-- 데모 -->
<text class="cap" x="24" y={DEMO_Y - 10} fill="var(--muted)">데모</text>
<rect x="522" y={DEMO_Y - 19} width="14" height="10" rx="2" fill="var(--bg-soft)" stroke="var(--ink)" stroke-width="1.6"/>
<text class="cap" x="542" y={DEMO_Y - 10} fill="var(--muted)">데모에 없던 결정</text>

{demo.map((d) => (
  <>
    <rect x={d.x} y={DEMO_Y} width={W} height={DEMO_H} rx="3" fill="var(--bg-soft)" stroke="var(--rule)" stroke-width="1"/>
    {d.lines.length === 1
      ? <text class="box" x={d.x + W / 2} y={DEMO_Y + 29} text-anchor="middle" fill="var(--ink)">{d.lines[0]}</text>
      : d.lines.map((l, k) => (
          <text class="box2" x={d.x + W / 2} y={DEMO_Y + 19 + k * 17} text-anchor="middle" fill="var(--ink)">{l}</text>
        ))}
  </>
))}
{demo.slice(0, -1).map((d, i) => (
  <path d={`M ${d.x + W + 2} ${DEMO_MID} H ${demo[i + 1].x - 3}`} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#dvsEnd)"/>
))}

<!-- 서비스 -->
<text class="cap" x="24" y={SVC_Y - 10} fill="var(--muted)">서비스</text>

{service.map((s) => (
  <>
    <rect x={s.x} y={SVC_Y} width={W} height={SVC_H} rx="3" fill="var(--bg-soft)"
          stroke={s.added ? 'var(--ink)' : 'var(--rule)'} stroke-width={s.added ? 1.6 : 1}/>
    <text class="box2" x={s.x + W / 2} y={SVC_Y + 22} text-anchor="middle" fill="var(--ink)">{s.title}</text>
    {s.sub.map((l, k) => (
      <text class="sub" x={s.x + W / 2} y={SVC_Y + 42 + k * 15} text-anchor="middle" fill="var(--muted)">{l}</text>
    ))}
  </>
))}
{service.slice(0, -1).map((s, i) => (
  <path d={`M ${s.x + W + 2} ${SVC_MID} H ${service[i + 1].x - 3}`} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#dvsEnd)"/>
))}

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .box { font-size: 13px; font-weight: 550; }
.dg .box2 { font-size: 12.5px; font-weight: 550; }
.dg .sub { font-size: 10.5px; }
.dg .cap { font-size: 11px; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
