---
/**
 * 조직 → 문서 키 → 리비전(시행 구간) → 청크로 내려가는 식별자 계층.
 * 순번은 문서 키에 붙고, 시행 구간은 시작 포함·끝 제외다.
 */
const ORG = { x: 24, y: 70, w: 100, h: 40 };
const DOC = { x: 160, y: 70, w: 120, h: 40 };
const REV_X = 320;
const REV_W = 170;
const revs = [
  { id: 'v1', range: '2026-01-01 ≤ 날짜 < 2026-09-01', y: 44, chunks: ['3f9a…'] },
  { id: 'v2', range: '2026-09-01 ≤ 날짜', y: 104, chunks: ['b71c…', 'e02d…'] },
];
const CH_X = 526;
const CH_W = 122;
const H = 214;
---

<div class="dg">
<svg width="100%" viewBox={`0 0 672 ${H}`} xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="문서는 조직 hanul과 문서 키 edu의 조합으로 식별하고, 그 아래에 시행 구간을 가진 리비전 v1과 v2가 있고, 리비전마다 검색에 쓰는 청크가 있다. 원본 변경 순번은 문서 키에 붙고, 시행 구간은 시작일을 포함하고 종료일을 제외한다">

<defs>
  <marker id="diEnd" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
    <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--muted)"/>
  </marker>
</defs>

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">문서의 식별자 계층</text>

<text class="cap" x={ORG.x} y={ORG.y - 10} fill="var(--muted)">조직</text>
<rect x={ORG.x} y={ORG.y} width={ORG.w} height={ORG.h} rx="3" fill="var(--bg-soft)" stroke="var(--rule)" stroke-width="1"/>
<text class="m" x={ORG.x + ORG.w / 2} y={ORG.y + 25} text-anchor="middle" fill="var(--ink)">hanul</text>

<path d={`M ${ORG.x + ORG.w + 2} ${ORG.y + 20} H ${DOC.x - 3}`} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#diEnd)"/>

<text class="cap" x={DOC.x} y={DOC.y - 10} fill="var(--muted)">문서 키 · 권한과 갱신의 단위</text>
<rect x={DOC.x} y={DOC.y} width={DOC.w} height={DOC.h} rx="3" fill="var(--bg-soft)" stroke="var(--ink)" stroke-width="1.6"/>
<text class="m" x={DOC.x + DOC.w / 2} y={DOC.y + 25} text-anchor="middle" fill="var(--ink)">edu</text>
<text class="cap" x={DOC.x} y={DOC.y + DOC.h + 16} fill="var(--muted)">순번 12 · 스냅샷 지문</text>

<!-- 리비전 -->
<text class="cap" x={REV_X} y="34" fill="var(--muted)">리비전 · 시행 구간</text>
{revs.map((r) => (
  <>
    <path d={`M ${DOC.x + DOC.w + 2} ${DOC.y + 20} H ${REV_X - 16} V ${r.y + 20} H ${REV_X - 3}`} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#diEnd)"/>
    <rect x={REV_X} y={r.y} width={REV_W} height="40" rx="3" fill="var(--bg-soft)" stroke="var(--rule)" stroke-width="1"/>
    <text class="m" x={REV_X + 12} y={r.y + 17} fill="var(--ink)">{r.id}</text>
    <text class="sub" x={REV_X + 12} y={r.y + 32} fill="var(--muted)">{r.range}</text>
    {r.chunks.map((c, k) => (
      <>
        <path d={`M ${REV_X + REV_W + 2} ${r.y + 20} H ${CH_X - 12} V ${r.y + 4 + k * 26 + 9} H ${CH_X - 3}`} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#diEnd)"/>
        <rect x={CH_X} y={r.y + 4 + k * 26 - 2} width={CH_W} height="22" rx="3" fill="var(--bg)" stroke="var(--rule)" stroke-width="1"/>
        <text class="m" x={CH_X + CH_W / 2} y={r.y + 4 + k * 26 + 13} text-anchor="middle" fill="var(--body)">{`청크 ${c}`}</text>
      </>
    ))}
  </>
))}
<text class="cap" x={CH_X} y="34" fill="var(--muted)">청크 · 검색과 인용의 단위</text>

<text class="cap" x="24" y={H - 12} fill="var(--body)">같은 문서의 구간이 겹치면 수집에서 거부한다. 순번은 수집 계층이 매긴 원본 변경 순서다</text>

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .m { font-family: var(--font-mono); font-size: 11.5px; font-weight: 600; }
.dg .sub { font-size: 10px; }
.dg .cap { font-size: 10.5px; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
