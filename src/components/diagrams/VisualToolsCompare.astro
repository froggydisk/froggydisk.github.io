---
// 4개 도구를 추상화 수준 순서로 세로 배열한다.
// 가로 4단이면 920px가 필요해 본문(672)을 넘긴다.
const tools = [
  {
    name: 'Playwright', kind: '브라우저 연결', gives: '실시간 렌더링 피드백', hue: 5,
    chips: [{ t: 'gstack /browse', mono: true }],
  },
  {
    name: 'Applitools / Percy', kind: '시각 회귀 테스트', gives: '스크린샷 베이스라인 비교', hue: 3,
    chips: [{ t: '픽셀 비교' }, { t: 'AI 비교', accent: true }],
  },
  {
    name: 'data-testid 레이어', kind: '시맨틱 식별자', gives: '명시적 UI 계약', hue: 4,
    chips: [{ t: 'ts-morph → Claude API', t2: '→ Playwright 스펙', mono: true }],
  },
  {
    name: 'Momentic', kind: 'Intent 로케이터', gives: '자연어 UI 요소 탐색', hue: 2,
    chips: [{ t: '셀렉터 유지보수 불필요' }],
  },
];
const ROW = 60, GAP = 8, TOP = 40;
const ys = tools.map((_, i) => TOP + i * (ROW + GAP));
const H = ys[ys.length - 1] + ROW + 36;
---

<div class="vt">
<svg width="100%" viewBox={`0 0 672 ${H}`} xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="에이전트 시각 검증 도구 네 가지를 추상화 수준 순서로 비교한 표">

<defs>
  <marker id="vtAxis" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
    <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--muted)"/>
  </marker>
</defs>

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">에이전트 시각 검증 도구</text>

<!-- 추상화 축 -->
<line x1="40" y1={TOP + 6} x2="40" y2={ys[3] + ROW - 2} stroke="var(--rule)" stroke-width="1" marker-end="url(#vtAxis)"/>
<text class="cap" x="22" y={(TOP + ys[3] + ROW) / 2} text-anchor="middle" fill="var(--muted)"
      transform={`rotate(-90 22 ${(TOP + ys[3] + ROW) / 2})`}>추상화 수준</text>

{tools.map((t, i) => (
  <g>
    <rect x={60} y={ys[i]} width={588} height={ROW} rx={3} fill="none" stroke="var(--rule)" stroke-width="1"/>
    <line x1={60.5} y1={ys[i] + 10} x2={60.5} y2={ys[i] + ROW - 10} stroke={`var(--dg-${t.hue})`} stroke-width="3"/>

    <text class="name" x={78} y={ys[i] + 26} fill={`var(--dg-${t.hue}-ink)`}>{t.name}</text>
    <text class="cap" x={78} y={ys[i] + 43} fill="var(--muted)">{t.kind}</text>
    <text class="gives" x={262} y={ys[i] + 34} fill="var(--body)">{t.gives}</text>

    {t.chips.length === 2 ? t.chips.map((c, j) => (
      <g>
        <rect x={444 + j * 100} y={ys[i] + 15} width={92} height={30} rx={3}
              fill={c.accent ? 'var(--dg-1-soft)' : 'var(--bg-soft)'}
              stroke={c.accent ? 'var(--dg-1)' : 'var(--rule)'} stroke-width="1"/>
        <text class="chip" x={490 + j * 100} y={ys[i] + 34} text-anchor="middle"
              fill={c.accent ? 'var(--dg-1-ink)' : 'var(--muted)'}>{c.t}</text>
      </g>
    )) : (
      <g>
        <rect x={444} y={ys[i] + 12} width={192} height={36} rx={3} fill="var(--bg-soft)" stroke="var(--rule)" stroke-width="1"/>
        {t.chips[0].t2 ? (
          <g>
            <text class={t.chips[0].mono ? 'm chip2' : 'chip2'} x={540} y={ys[i] + 26} text-anchor="middle" fill="var(--muted)">{t.chips[0].t}</text>
            <text class={t.chips[0].mono ? 'm chip2' : 'chip2'} x={540} y={ys[i] + 39} text-anchor="middle" fill="var(--muted)">{t.chips[0].t2}</text>
          </g>
        ) : (
          <text class={t.chips[0].mono ? 'm chip' : 'chip'} x={540} y={ys[i] + 34} text-anchor="middle" fill="var(--muted)">{t.chips[0].t}</text>
        )}
      </g>
    )}
  </g>
))}

</svg>
</div>

<style>
.vt { margin: 2.4rem 0; }
.vt svg { display: block; width: 100%; height: auto; }
.vt text { font-family: var(--font-sans); }
.vt .m { font-family: var(--font-mono); }
.vt .name { font-size: 13.5px; font-weight: 700; }
.vt .gives { font-size: 11.5px; }
.vt .chip { font-size: 11px; }
.vt .chip2 { font-size: 9.5px; }
.vt .cap { font-size: 11px; }
.vt .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .vt { overflow-x: auto; }
  .vt svg { min-width: 560px; }
}
</style>
