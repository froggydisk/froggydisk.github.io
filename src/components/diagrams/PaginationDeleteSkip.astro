---
const page1 = ['1000000', '999999', '999998', '999997', '999996'];
const offsetPage2 = ['999994', '999993', '999992', '999991', '999990'];
const keysetPage2 = ['999995', '999994', '999993', '999992', '999991'];
const xs = [116, 206, 296, 386, 476, 566];
const W = 82;
---

<div class="dg">
<svg width="100%" viewBox="0 0 672 330" xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="페이지 1의 행이 삭제되면 OFFSET은 999995를 건너뛰어 영영 반환하지 않고, KEYSET은 그대로 반환한다">

<defs>
  <marker id="skipArrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
    <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--accent)"/>
  </marker>
</defs>

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">페이지 1에 있던 행이 삭제되면</text>

<!-- ── t1 ── -->
<text class="m row" x="104" y="60" text-anchor="end" fill="var(--ink)">t1 · page 1</text>
<text class="m cap" x="104" y="75" text-anchor="end" fill="var(--muted)">LIMIT 5</text>
{page1.map((id, i) => (
  <g>
    <rect x={xs[i]} y={44} width={W} height={30} rx={3}
          fill={i === 2 ? 'var(--accent)' : 'var(--bg-soft)'}
          fill-opacity={i === 2 ? 0.12 : 1}
          stroke={i === 2 ? 'var(--accent)' : 'var(--rule)'}
          stroke-width={i === 2 ? 1.5 : 1}/>
    <text class="m val" x={xs[i] + W / 2} y={64} text-anchor="middle"
          font-weight={i === 2 ? 700 : 400}
          fill={i === 2 ? 'var(--accent-strong)' : 'var(--body)'}>{id}</text>
  </g>
))}
<text class="cap" x={xs[2] + W / 2} y={90} text-anchor="middle" fill="var(--accent-strong)">↑ 곧 삭제될 행</text>

<!-- ── t2 ── -->
<text class="m row" x="104" y="126" text-anchor="end" fill="var(--accent-strong)">t2 · DELETE</text>
<line x1="116" y1="122" x2="644" y2="122" stroke="var(--accent)" stroke-width="1" stroke-dasharray="4 4" marker-end="url(#skipArrow)"/>
<text x="382" y="113" text-anchor="middle" font-size="12" fill="var(--accent-strong)">999998 삭제 → 뒤의 행이 한 칸씩 당겨진다</text>

<!-- ── t3 offset ── -->
<text class="m row" x="104" y="168" text-anchor="end" fill="var(--accent-strong)">t3 · OFFSET 5</text>
<text class="m cap" x="104" y="183" text-anchor="end" fill="var(--muted)">page 2</text>

<rect x={xs[0]} y={152} width={W} height={30} rx={3} fill="none" stroke="var(--accent)" stroke-width="1" stroke-dasharray="3 3"/>
<text class="m val" x={xs[0] + W / 2} y={172} text-anchor="middle" fill="var(--accent-strong)" opacity="0.7">999995</text>
<line x1={xs[0] + 12} y1={167} x2={xs[0] + W - 12} y2={167} stroke="var(--accent)" stroke-width="1"/>
<text class="cap" x={xs[0] + W / 2} y={198} text-anchor="middle" fill="var(--accent-strong)">OFFSET이 건너뛴 행</text>

{offsetPage2.map((id, i) => (
  <g>
    <rect x={xs[i + 1]} y={152} width={W} height={30} rx={3} fill="var(--bg-soft)" stroke="var(--rule)" stroke-width="1"/>
    <text class="m val" x={xs[i + 1] + W / 2} y={172} text-anchor="middle">{id}</text>
  </g>
))}

<!-- ── t3 keyset ── -->
<text class="m row" x="104" y="254" text-anchor="end" fill="var(--ink)">t3 · KEYSET</text>
<text class="m cap" x="104" y="269" text-anchor="end" fill="var(--muted)">cursor = 999996</text>
{keysetPage2.map((id, i) => (
  <g>
    <rect x={xs[i]} y={238} width={W} height={30} rx={3} fill="none" stroke="var(--ink)"
          stroke-width={i === 0 ? 1.8 : 1}/>
    <text class="m val" x={xs[i] + W / 2} y={258} text-anchor="middle" fill="var(--ink)"
          font-weight={i === 0 ? 700 : 400}>{id}</text>
  </g>
))}
<text class="cap" x={xs[0] + W / 2} y={284} text-anchor="middle" fill="var(--ink)">그대로 나온다</text>

<line x1="116" y1="300" x2="644" y2="300" stroke="var(--rule)" stroke-width="1"/>
<text class="cap" x="382" y="319" text-anchor="middle" fill="var(--muted)">999995는 page 1에도 page 2에도 없다 · 에러 없이 사라진다</text>

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .m { font-family: var(--font-mono); }
.dg .val { font-size: 11px; }
.dg .cap { font-size: 11px; }
.dg .row { font-size: 12px; font-weight: 700; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
