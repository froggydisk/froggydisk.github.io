---
/**
 * 모델 출력이 통과해야 하는 검사 세 겹과, 그 뒤에 남는 의미 평가.
 * 두 예시 출력 A·B가 각각 어느 겹에서 걸리는지 아래에 표시한다.
 */
const W = 130;
const GAP = 34; // 4 × 130 + 3 × 34 = 622
const Y = 50;
const H_BOX = 56;
const stages = [
  { title: 'JSON 문법', sub: '파싱된다 · 중복 키 없음' },
  { title: '스키마', sub: '필드 · 타입 · 추가 속성 금지', strong: true },
  { title: '업무 규칙', sub: '상태 ↔ 필드 · 인용 · 길이', strong: true },
  { title: '의미', sub: '답이 맞는가 · 별도 평가', dashed: true },
].map((s, i) => ({ ...s, x: 24 + i * (W + GAP) }));
const MID = Y + H_BOX / 2;

const EX_Y = 140;
const examples = [
  { at: 1, tag: 'A', text: ['{"answer": "…",', ' "sources": "교육비 안내"}'], why: '필드 이름·타입이 다르다' },
  { at: 2, tag: 'B', text: ['{"status": "answered",', ' "citations": [], …}'], why: 'answered인데 인용이 비었다' },
];
const H = 244;
---

<div class="dg">
<svg width="100%" viewBox={`0 0 672 ${H}`} xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="출력은 JSON 문법 검사, 스키마 검사, 업무 규칙 검사를 차례로 통과해야 하고, 그 뒤에도 답이 맞는지는 별도 평가다. 필드 이름이 다른 출력 A는 스키마에서, answered인데 인용이 빈 출력 B는 업무 규칙에서 걸린다">

<defs>
  <marker id="tchEnd" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
    <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--muted)"/>
  </marker>
</defs>

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">세 겹의 검사와 그 뒤의 의미 평가</text>

{stages.map((s) => (
  <>
    <rect x={s.x} y={Y} width={W} height={H_BOX} rx="3" fill={s.dashed ? 'none' : 'var(--bg-soft)'}
          stroke={s.strong ? 'var(--ink)' : 'var(--rule)'} stroke-width={s.strong ? 1.6 : 1} stroke-dasharray={s.dashed ? '4 3' : undefined}/>
    <text class="box" x={s.x + W / 2} y={Y + 24} text-anchor="middle" fill="var(--ink)">{s.title}</text>
    <text class="sub" x={s.x + W / 2} y={Y + 43} text-anchor="middle" fill="var(--muted)">{s.sub}</text>
  </>
))}
{stages.slice(0, -1).map((s, i) => (
  <path d={`M ${s.x + W + 2} ${MID} H ${stages[i + 1].x - 3}`} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#tchEnd)"/>
))}

{examples.map((e) => {
  const sx = stages[e.at].x;
  return (
    <>
      <path d={`M ${sx + W / 2} ${Y + H_BOX + 2} V ${EX_Y - 12}`} fill="none" stroke="var(--accent-strong)" stroke-width="1.2" stroke-dasharray="3 3"/>
      <circle cx={sx + W / 2} cy={EX_Y - 12} r="7" fill="var(--accent-strong)"/>
      <text class="ic" x={sx + W / 2} y={EX_Y - 8.5} text-anchor="middle" fill="var(--bg)">✕</text>
      <text class="tag" x={sx - 40} y={EX_Y + 14} fill="var(--ink)">{e.tag}</text>
      {e.text.map((l, k) => (
        <text class="m" x={sx - 24} y={EX_Y + 14 + k * 14} fill="var(--body)">{l}</text>
      ))}
      <text class="sub" x={sx - 24} y={EX_Y + 48} fill="var(--accent-strong)">{e.why}</text>
    </>
  );
})}

<text class="sub" x={stages[3].x + W / 2} y={EX_Y + 14} text-anchor="middle" fill="var(--muted)">셋을 다 통과해도</text>
<text class="sub" x={stages[3].x + W / 2} y={EX_Y + 30} text-anchor="middle" fill="var(--muted)">정답인지는 아직 모른다</text>

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .box { font-size: 12.5px; font-weight: 550; }
.dg .sub { font-size: 10.5px; }
.dg .tag { font-size: 12px; font-weight: 600; }
.dg .m { font-family: var(--font-mono); font-size: 10px; }
.dg .ic { font-size: 9px; font-weight: 700; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
