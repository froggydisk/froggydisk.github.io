---
/**
 * CPU 안의 세 요소가 내부 버스로 이어지고, 밖으로는 주소·데이터·제어 버스가
 * 주기억장치까지 이어진다. 세 버스의 방향이 서로 다르다는 것을 화살표로 보인다.
 */
const CPU = { x: 24, y: 44, w: 300, h: 204 }; // 24..324 · 44..248
const IB_X = 64; // 내부 버스가 서는 세로선

const UNIT_X = 92;
const UNIT_W = 212;
const UNIT_H = 44;
const units = [
  { label: 'ALU · 산술논리연산장치', y: 76 },
  { label: '레지스터 Set', y: 132 },
  { label: '제어 유닛', y: 188 },
].map((u) => ({ ...u, mid: u.y + UNIT_H / 2 }));

const MEM = { x: 548, y: 96, w: 100, h: 116 };

const BUS_L = CPU.x + CPU.w + 4; // 328
const BUS_R = MEM.x - 4; // 544
const buses = [
  { label: '주소 버스 (단방향)', y: 110, both: false },
  { label: '데이터 버스 (양방향)', y: 154, both: true },
  { label: '제어 버스 (단방향)', y: 198, both: false },
];

const H = CPU.y + CPU.h + 24; // 272
---

<div class="dg">
<svg width="100%" viewBox={`0 0 672 ${H}`} xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="CPU 안에서 ALU와 레지스터, 제어 유닛이 내부 버스로 이어지고, 밖으로는 주소 버스가 단방향, 데이터 버스가 양방향, 제어 버스가 단방향으로 주기억장치와 연결된다">

<defs>
  <marker id="cbEnd" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
    <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--ink)"/>
  </marker>
  <marker id="cbStart" viewBox="0 0 10 10" refX="1" refY="5" markerWidth="6" markerHeight="6" orient="auto">
    <path d="M 10 0 L 0 5 L 10 10 z" fill="var(--ink)"/>
  </marker>
</defs>

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">CPU의 구조와 세 갈래 버스</text>

<!-- CPU 틀 -->
<rect x={CPU.x} y={CPU.y} width={CPU.w} height={CPU.h} rx="3" fill="none" stroke="var(--rule)" stroke-width="1"/>
<text class="ttl" x={CPU.x + CPU.w - 12} y="64" text-anchor="end" fill="var(--muted)">CPU</text>
<text class="cap" x={IB_X} y="70" text-anchor="middle" fill="var(--muted)">내부 버스</text>

<!-- 내부 버스와 세 요소 -->
<path d={`M ${IB_X} ${units[0].mid} V ${units[2].mid}`} fill="none" stroke="var(--ink)" stroke-width="1.3"/>
{units.map((u) => (
  <>
    <path d={`M ${IB_X} ${u.mid} H ${UNIT_X}`} fill="none" stroke="var(--ink)" stroke-width="1.3"/>
    <rect x={UNIT_X} y={u.y} width={UNIT_W} height={UNIT_H} rx="3" fill="var(--bg-soft)" stroke="var(--ink)" stroke-width="1.4"/>
    <text class="box" x={UNIT_X + UNIT_W / 2} y={u.y + 28} text-anchor="middle" fill="var(--ink)">{u.label}</text>
  </>
))}

<!-- 주기억장치 -->
<rect x={MEM.x} y={MEM.y} width={MEM.w} height={MEM.h} rx="3" fill="var(--bg-soft)" stroke="var(--rule)" stroke-width="1"/>
<text class="box" x={MEM.x + MEM.w / 2} y={MEM.y + MEM.h / 2 + 5} text-anchor="middle" fill="var(--ink)">주기억장치</text>

<!-- 세 갈래 버스 -->
{buses.map((b) => (
  <>
    <text class="cap" x={BUS_L + 8} y={b.y - 9} fill="var(--muted)">{b.label}</text>
    <path d={`M ${BUS_L} ${b.y} H ${BUS_R}`} fill="none" stroke="var(--ink)" stroke-width="1.3"
          marker-end="url(#cbEnd)" marker-start={b.both ? 'url(#cbStart)' : undefined}/>
  </>
))}

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .box { font-size: 13px; font-weight: 550; }
.dg .cap { font-size: 11px; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
