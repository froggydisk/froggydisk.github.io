---
/**
 * 모의 전송 테스트가 실제로 실행하는 경로. SDK의 직렬화와 파싱, 어댑터의 분류는 진짜고
 * HTTP 전송 한 칸만 미리 정한 응답으로 바꾼다.
 */
const W = 108;
const GAP = 21;
const Y = 56;
const H_BOX = 64;
const steps = [
  { title: 'generate', sub: '요청을 만든다', mono: true },
  { title: 'SDK', sub: '요청 직렬화' },
  { title: '모의 전송', sub: '미리 정한 응답', fake: true },
  { title: 'SDK', sub: '응답 파싱' },
  { title: 'normalize', sub: '상태 분류', mono: true },
].map((s, i) => ({ ...s, x: 24 + i * (W + GAP) }));
const MID = Y + H_BOX / 2;

const NOTE_Y = Y + H_BOX + 30; // 150
const notes = [
  { ok: true, text: 'SDK가 요청을 직렬화하고 응답을 파싱하는 경로는 실제로 실행된다' },
  { ok: false, text: '모델이 계산한 응답이 아니다. 한국어 품질·비용·지연은 여기서 못 본다' },
].map((n, i) => ({ ...n, y: NOTE_Y + i * 24 }));
const H = notes[1].y + 22; // 196
---

<div class="dg">
<svg width="100%" viewBox={`0 0 672 ${H}`} xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="모의 전송 테스트는 generate가 만든 요청을 실제 SDK가 직렬화하고, HTTP 전송 한 칸만 미리 정한 응답으로 바꾼 뒤, 실제 SDK가 파싱하고 normalize가 분류하는 경로를 실행한다. 모델이 계산한 응답은 아니다">

<defs>
  <marker id="mtEnd" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
    <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--muted)"/>
  </marker>
</defs>

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">모의 전송 테스트가 실행하는 경로</text>

{steps.map((s) => (
  <>
    <text class="cap" x={s.x + W / 2} y={Y - 9} text-anchor="middle" fill={s.fake ? 'var(--accent-strong)' : 'var(--muted)'}>{s.fake ? '가짜' : '실제'}</text>
    <rect x={s.x} y={Y} width={W} height={H_BOX} rx="3" fill={s.fake ? 'none' : 'var(--bg-soft)'}
          stroke={s.fake ? 'var(--accent-strong)' : 'var(--rule)'} stroke-width={s.fake ? 1.4 : 1} stroke-dasharray={s.fake ? '4 3' : undefined}/>
    <text class={s.mono ? 'm' : 'box'} x={s.x + W / 2} y={Y + 28} text-anchor="middle" fill="var(--ink)">{s.title}</text>
    <text class="line" x={s.x + W / 2} y={Y + 48} text-anchor="middle" fill="var(--muted)">{s.sub}</text>
  </>
))}
{steps.slice(0, -1).map((s, i) => (
  <path d={`M ${s.x + W + 2} ${MID} H ${steps[i + 1].x - 3}`} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#mtEnd)"/>
))}

{notes.map((n) => (
  <>
    <circle cx="31" cy={n.y - 4} r="7" fill={n.ok ? 'var(--ink)' : 'var(--accent-strong)'}/>
    <text class="ic" x="31" y={n.y - 0.5} text-anchor="middle" fill="var(--bg)">{n.ok ? '✓' : '✕'}</text>
    <text class="note" x="46" y={n.y} fill="var(--body)">{n.text}</text>
  </>
))}

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .box { font-size: 12.5px; font-weight: 550; }
.dg .m { font-family: var(--font-mono); font-size: 12px; font-weight: 600; }
.dg .line { font-size: 11px; }
.dg .note { font-size: 11px; }
.dg .ic { font-size: 9px; font-weight: 700; }
.dg .cap { font-size: 11px; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
