---
/**
 * 토큰 수라고 부르는 세 값이 요청의 다른 시점에, 다른 출처에서 나온다는 것을 보인다.
 * 사전 추정치 · 계수 결과 · 실제 사용량은 같은 필드에 덮어쓰지 않는다.
 */
const W = 190;
const GAP = 27;
const Y = 50;
const H_BOX = 96;
const stops = [
  { when: '요청 전', name: '사전 추정치', src: '로컬 토크나이저 · 문자 수', use: '크기를 가늠한다' },
  { when: '생성 직전', name: '계수 결과', src: 'responses.input_tokens.count', use: '예산 판정에 쓴다', mono: true, strong: true },
  { when: '생성 후', name: '실제 사용량', src: '응답의 usage', use: '비용을 기록한다' },
].map((s, i) => ({ ...s, x: 24 + i * (W + GAP) }));
const MID = Y + H_BOX / 2;
const H = Y + H_BOX + 46; // 192
---

<div class="dg">
<svg width="100%" viewBox={`0 0 672 ${H}`} xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="토큰 수에는 세 값이 있다. 요청 전에 로컬 토크나이저나 문자 수로 가늠한 사전 추정치, 생성 직전에 계수 API가 돌려준 계수 결과, 생성 후 응답의 usage에 실린 실제 사용량이다. 시점과 출처가 달라 같은 필드에 덮어쓰지 않는다">

<defs>
  <marker id="tcEnd" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
    <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--muted)"/>
  </marker>
</defs>

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">토큰 수라고 부르는 세 값</text>

{stops.map((s) => (
  <>
    <text class="cap" x={s.x + W / 2} y={Y - 9} text-anchor="middle" fill="var(--muted)">{s.when}</text>
    <rect x={s.x} y={Y} width={W} height={H_BOX} rx="3" fill="var(--bg-soft)"
          stroke={s.strong ? 'var(--ink)' : 'var(--rule)'} stroke-width={s.strong ? 1.6 : 1}/>
    <text class="box" x={s.x + 14} y={Y + 24} fill="var(--ink)">{s.name}</text>
    <text class={s.mono ? 'm' : 'line'} x={s.x + 14} y={Y + 48} fill="var(--body)">{s.src}</text>
    <text class="line" x={s.x + 14} y={Y + 76} fill="var(--muted)">{s.use}</text>
  </>
))}
{stops.slice(0, -1).map((s, i) => (
  <path d={`M ${s.x + W + 2} ${MID} H ${stops[i + 1].x - 3}`} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#tcEnd)"/>
))}

<text class="cap" x="336" y={H - 12} text-anchor="middle" fill="var(--muted)">시점과 출처가 다르다. 셋을 한 필드에 덮어쓰면 어느 값을 보고 있는지 알 수 없다</text>

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .box { font-size: 13px; font-weight: 550; }
.dg .line { font-size: 11px; }
.dg .m { font-family: var(--font-mono); font-size: 10px; }
.dg .cap { font-size: 11px; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
