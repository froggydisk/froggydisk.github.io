---
/**
 * '공개 모델'을 내려받을 때 실제로 손에 들어오는 것과 따로 확인해야 하는 것을 나누고,
 * 라이선스가 한 곳이 아니라 네 곳에 따로 있다는 것을 보인다.
 */
const Y = 50;
const H_BOX = 100;
const boxes = [
  { x: 24, w: 300, title: '내려받으면 손에 들어오는 것', items: ['가중치 (추론에 필요한 숫자)', '토크나이저 · 설정 파일', '채팅 템플릿'], ok: true },
  { x: 348, w: 300, title: '따로 확인해야 하는 것', items: ['학습 데이터 · 정제 과정', '학습 코드 · 재현 설정', '사용 조건 (LICENSE)'], ok: false },
];
const LY = 186;
const LW = 144;
const LGAP = 16;
const licenses = ['추론 라이브러리', '모델 저장소', '데이터셋', '변환된 가중치'].map((l, i) => ({ l, x: 24 + i * (LW + LGAP) }));
const H = LY + 30 + 24; // 240
---

<div class="dg">
<svg width="100%" viewBox={`0 0 672 ${H}`} xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="공개 모델을 내려받으면 가중치와 토크나이저, 설정, 채팅 템플릿이 들어온다. 학습 데이터와 학습 코드, 사용 조건은 따로 확인한다. 라이선스는 추론 라이브러리, 모델 저장소, 데이터셋, 변환된 가중치 네 곳에 따로 있다">

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">‘공개 모델’에서 공개된 것</text>

{boxes.map((b) => (
  <>
    <rect x={b.x} y={Y} width={b.w} height={H_BOX} rx="3" fill={b.ok ? 'var(--bg-soft)' : 'none'}
          stroke={b.ok ? 'var(--ink)' : 'var(--rule)'} stroke-width={b.ok ? 1.4 : 1} stroke-dasharray={b.ok ? undefined : '4 3'}/>
    <text class="box" x={b.x + 14} y={Y + 24} fill="var(--ink)">{b.title}</text>
    {b.items.map((it, k) => (
      <>
        <circle cx={b.x + 20} cy={Y + 44 + k * 20} r="6" fill={b.ok ? 'var(--ink)' : 'var(--muted)'}/>
        <text class="ic" x={b.x + 20} y={Y + 47 + k * 20} text-anchor="middle" fill="var(--bg)">{b.ok ? '✓' : '?'}</text>
        <text class="line" x={b.x + 34} y={Y + 48 + k * 20} fill="var(--body)">{it}</text>
      </>
    ))}
  </>
))}

<text class="cap" x="24" y={LY - 10} fill="var(--muted)">라이선스는 네 곳에 따로 있다. 프로그램의 LICENSE 하나로 전체를 판단하지 않는다</text>
{licenses.map((c) => (
  <>
    <rect x={c.x} y={LY} width={LW} height="30" rx="3" fill="var(--bg-soft)" stroke="var(--rule)" stroke-width="1"/>
    <text class="chip" x={c.x + LW / 2} y={LY + 19} text-anchor="middle" fill="var(--ink)">{c.l}</text>
  </>
))}

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .box { font-size: 12.5px; font-weight: 550; }
.dg .line { font-size: 11px; }
.dg .chip { font-size: 11.5px; font-weight: 550; }
.dg .ic { font-size: 8px; font-weight: 700; }
.dg .cap { font-size: 11px; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
