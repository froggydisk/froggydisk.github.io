<div class="sys-layers">
<svg width="100%" viewBox="0 0 680 290" xmlns="http://www.w3.org/2000/svg">

<!-- Layer 5: 판정하기 (top) -->
<rect x="100" y="10" width="480" height="42" rx="8" fill="var(--sl-l5)" stroke="var(--sl-l5-border)" stroke-width="1"/>
<text x="140" y="28" font-family="'Pretendard', -apple-system, sans-serif" font-size="11" font-weight="600" fill="var(--sl-l5-text)">판정하기</text>
<text x="140" y="44" font-family="'SF Mono', 'Consolas', monospace" font-size="9" fill="var(--sl-dim)">assertion, skip reason, validation result</text>

<!-- Layer 4: 실행하기 -->
<rect x="100" y="60" width="480" height="42" rx="8" fill="var(--sl-l4)" stroke="var(--sl-l4-border)" stroke-width="1"/>
<text x="140" y="78" font-family="'Pretendard', -apple-system, sans-serif" font-size="11" font-weight="600" fill="var(--sl-l4-text)">실행하기</text>
<text x="140" y="94" font-family="'SF Mono', 'Consolas', monospace" font-size="9" fill="var(--sl-dim)">generated spec</text>

<!-- Layer 3: 준비하기 -->
<rect x="100" y="110" width="480" height="52" rx="8" fill="var(--sl-l3)" stroke="var(--sl-l3-border)" stroke-width="1"/>
<text x="140" y="130" font-family="'Pretendard', -apple-system, sans-serif" font-size="11" font-weight="600" fill="var(--sl-l3-text)">준비하기</text>
<text x="140" y="146" font-family="'SF Mono', 'Consolas', monospace" font-size="9" fill="var(--sl-dim)">precondition manifest, fixture catalog, precondition→fixture mapping</text>

<!-- Layer 2: 이해하기 -->
<rect x="100" y="170" width="480" height="42" rx="8" fill="var(--sl-l2)" stroke="var(--sl-l2-border)" stroke-width="1"/>
<text x="140" y="188" font-family="'Pretendard', -apple-system, sans-serif" font-size="11" font-weight="600" fill="var(--sl-l2-text)">이해하기</text>
<text x="140" y="204" font-family="'SF Mono', 'Consolas', monospace" font-size="9" fill="var(--sl-dim)">scenario, tc-schema, ui-action-manifest</text>

<!-- Layer 1: 찾기 (bottom) -->
<rect x="100" y="220" width="480" height="42" rx="8" fill="var(--sl-l1)" stroke="var(--sl-l1-border)" stroke-width="1"/>
<text x="140" y="238" font-family="'Pretendard', -apple-system, sans-serif" font-size="11" font-weight="600" fill="var(--sl-l1-text)">찾기</text>
<text x="140" y="254" font-family="'SF Mono', 'Consolas', monospace" font-size="9" fill="var(--sl-dim)">data-testid, selector</text>

<!-- Caption -->
<text x="340" y="282" text-anchor="middle" font-family="'Pretendard', -apple-system, sans-serif" font-size="10" font-weight="600" fill="var(--sl-dim)" letter-spacing="0.08em">SYSTEM LAYERS — 5계층 구조</text>

</svg>
</div>

<style>
.sys-layers {
  /* 판정하기 - rose */
  --sl-l5: var(--dg-1);
  --sl-l5-border: var(--dg-1);
  --sl-l5-text: var(--dg-1-ink);
  /* 실행하기 - teal */
  --sl-l4: var(--dg-4);
  --sl-l4-border: var(--dg-4);
  --sl-l4-text: var(--dg-4-ink);
  /* 준비하기 - sky */
  --sl-l3: var(--dg-3);
  --sl-l3-border: var(--dg-3);
  --sl-l3-text: var(--dg-3-ink);
  /* 이해하기 - lime */
  --sl-l2: var(--dg-2);
  --sl-l2-border: var(--dg-2);
  --sl-l2-text: var(--dg-2-ink);
  /* 찾기 - lavender */
  --sl-l1: var(--dg-5);
  --sl-l1-border: var(--dg-5);
  --sl-l1-text: var(--dg-5-ink);

  --sl-dim: var(--muted);
}
@media (max-width: 700px) {
  .sys-layers { overflow-x: auto; }
  .sys-layers svg { min-width: 560px; }
}
</style>
