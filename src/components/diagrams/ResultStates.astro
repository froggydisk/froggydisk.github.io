---
/**
 * 어댑터 normalize가 제공자 응답을 여섯 상태 중 하나로 분류하는 순서.
 * 네 질문을 내려가며 '아니오'면 오른쪽 상태로 빠지고, 다 통과하면 ok다.
 * interrupted는 스트림 전용이라 아래 캡션에 둔다.
 */
const QX = 24;
const QW = 250;
const QH = 44;
const SX = 330;
const SW = 318;
const TOP = 44;
const STEP = 70;

const rows = [
  { q: 'HTTP 응답을 받았나', state: 'upstream_error', tell: '전송·인증·요청·서버 실패. 분류 코드만 남긴다' },
  { q: '응답 상태가 completed인가', state: 'incomplete', tell: '텍스트가 있어도 비운다' },
  { q: '거절(refusal) 콘텐츠 없이 답했나', state: 'refused', tell: '일반 답변과 분리한다' },
  { q: '완료된 assistant 텍스트가 있나', state: 'unexpected_output', tell: '출력 없음 · 도구 요청 · 모르는 형태 · 잘못된 JSON' },
].map((r, i) => ({ ...r, y: TOP + i * STEP }));

const FINAL_Y = TOP + rows.length * STEP; // 324
const QMID = QX + QW / 2;
const H = FINAL_Y + QH + 44; // 412
---

<div class="dg">
<svg width="100%" viewBox={`0 0 672 ${H}`} xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="어댑터는 HTTP 응답을 못 받으면 upstream_error, 응답 상태가 completed가 아니면 incomplete, 거절 콘텐츠가 있으면 refused, 완료된 텍스트가 없으면 unexpected_output, 넷을 다 통과하면 ok로 분류한다. 스트림이 완료 이벤트 없이 끝나면 interrupted다">

<defs>
  <marker id="rsEnd" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
    <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--muted)"/>
  </marker>
</defs>

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">normalize가 응답을 나누는 순서</text>

{rows.map((r) => (
  <>
    <rect x={QX} y={r.y} width={QW} height={QH} rx="3" fill="var(--bg-soft)" stroke="var(--rule)" stroke-width="1"/>
    <text class="q" x={QMID} y={r.y + 27} text-anchor="middle" fill="var(--ink)">{r.q}</text>

    <text class="cap" x={(QX + QW + SX) / 2} y={r.y + QH / 2 - 7} text-anchor="middle" fill="var(--muted)">아니오</text>
    <path d={`M ${QX + QW + 2} ${r.y + QH / 2} H ${SX - 3}`} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#rsEnd)"/>

    <rect x={SX} y={r.y} width={SW} height={QH} rx="3" fill="none" stroke="var(--rule)" stroke-width="1"/>
    <text class="m" x={SX + 12} y={r.y + 18} fill="var(--ink)">{r.state}</text>
    <text class="tell" x={SX + 12} y={r.y + 34} fill="var(--body)">{r.tell}</text>

    <text class="cap" x={QMID + 9} y={r.y + QH + 18} fill="var(--muted)">예</text>
    <path d={`M ${QMID} ${r.y + QH + 2} V ${r.y + STEP - 3}`} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#rsEnd)"/>
  </>
))}

<rect x={QX} y={FINAL_Y} width={QW} height={QH} rx="3" fill="var(--bg-soft)" stroke="var(--ink)" stroke-width="1.6"/>
<text class="m" x={QX + 12} y={FINAL_Y + 18} fill="var(--ink)">ok</text>
<text class="tell" x={QX + 12} y={FINAL_Y + 34} fill="var(--body)">텍스트 · 사용량 · 식별자를 돌려준다</text>

<text class="tell" x={SX + 12} y={FINAL_Y + 27} fill="var(--muted)">스트림이 완료 이벤트 없이 끝나면 <tspan class="m" fill="var(--ink)">interrupted</tspan></text>

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .q { font-size: 12.5px; font-weight: 550; }
.dg .m { font-family: var(--font-mono); font-size: 12px; font-weight: 600; }
.dg .tell { font-size: 11px; }
.dg .cap { font-size: 11px; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
