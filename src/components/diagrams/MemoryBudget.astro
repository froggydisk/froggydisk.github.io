---
/**
 * 파라미터 596,049,920개의 가중치가 자료형에 따라 차지하는 크기. float32는 실측(파라미터 바이트 합),
 * 16비트·4비트는 같은 개수로 계산한 값이다. 아래 줄은 프로세스 메모리가 가중치보다 큰 이유다.
 */
const PARAMS = 596049920;
const GIB = 1024 ** 3;
const LABEL_X = 24;
const BAR_X = 150;
const BAR_MAX = 420; // float32 = 420px
const BAR_H = 22;
const rows = [
  { dtype: 'float32', bytes: 4, measured: true },
  { dtype: '16비트', bytes: 2 },
  { dtype: '4비트', bytes: 0.5 },
].map((r, i) => {
  const size = PARAMS * r.bytes;
  return { ...r, y: 52 + i * 34, gib: (size / GIB).toFixed(2), w: (BAR_MAX * r.bytes) / 4 };
});

const PY = 176;
const PH = 26;
const parts = [
  { label: '가중치', w: 200, known: true },
  { label: '토크나이저 · 라이브러리', w: 130 },
  { label: '중간 연산', w: 90 },
  { label: '생성 캐시', w: 90 },
  { label: '로딩 임시 복사본', w: 114 },
];
let px = 24;
const placed = parts.map((p) => { const o = { ...p, x: px }; px += p.w; return o; });
const H = PY + PH + 46; // 248
---

<div class="dg">
<svg width="100%" viewBox={`0 0 672 ${H}`} xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="파라미터 596,049,920개를 float32로 올리면 파라미터 텐서 합이 약 2.22GiB다. 같은 개수를 16비트로 저장하면 1.11GiB, 4비트면 0.28GiB로 계산된다. 프로세스 전체 메모리에는 토크나이저와 라이브러리, 중간 연산, 생성 캐시, 로딩 임시 복사본이 더 들어가서 가중치 크기만으로 장비를 고르면 부족하다">

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">파라미터 596,049,920개의 가중치 크기</text>

{rows.map((r) => (
  <>
    <text class="m" x={LABEL_X} y={r.y + 16} fill="var(--ink)">{r.dtype}</text>
    <rect x={BAR_X} y={r.y} width={r.w} height={BAR_H} rx="2"
          fill={r.measured ? 'var(--ink)' : 'var(--bg-soft)'} stroke={r.measured ? 'var(--ink)' : 'var(--rule)'} stroke-width="1"/>
    <text class="val" x={BAR_X + r.w + 8} y={r.y + 16} fill={r.measured ? 'var(--ink)' : 'var(--muted)'}>{`${r.gib} GiB`}<tspan class="cap" fill="var(--muted)">{r.measured ? '  실측' : '  계산값'}</tspan></text>
  </>
))}

<text class="cap" x="24" y={PY - 10} fill="var(--muted)">프로세스 메모리 = 가중치 + 그 밖의 것들 (측정하지 않았다)</text>
{placed.map((p) => (
  <>
    <rect x={p.x} y={PY} width={p.w} height={PH} fill={p.known ? 'var(--ink)' : 'none'} stroke={p.known ? 'var(--ink)' : 'var(--rule)'} stroke-width="1" stroke-dasharray={p.known ? undefined : '4 3'}/>
    <text class="seg" x={p.x + p.w / 2} y={PY + 17} text-anchor="middle" fill={p.known ? 'var(--bg)' : 'var(--muted)'}>{p.label}</text>
  </>
))}
<text class="cap" x="24" y={PY + PH + 24} fill="var(--body)">입력이 길어지고 동시 요청이 늘면 오른쪽 칸들이 커진다. “0.6B니까 2.22GiB면 된다”로 장비를 고르면 부족하다</text>

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .m { font-family: var(--font-mono); font-size: 11.5px; font-weight: 600; }
.dg .val { font-family: var(--font-mono); font-size: 11px; }
.dg .seg { font-size: 10.5px; font-weight: 500; }
.dg .cap { font-size: 10.5px; font-family: var(--font-sans); }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
