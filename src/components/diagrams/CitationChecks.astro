---
/**
 * 인용 검증의 세 단계. 출처 식별자와 원문 구절은 문자열 검사로 확인하고,
 * 주장을 뒷받침하는지는 검증기 밖의 의미 평가다. 아래 예는 앞의 둘을 통과하고 셋째에서 틀린다.
 */
const W = 190;
const GAP = 27;
const Y = 50;
const H_BOX = 92;
const steps = [
  { title: '① 출처 식별자', check: '이번 생성에 넘긴 문서인가', note: '예산 때문에 빠진 문서는 근거가 아니다' },
  { title: '② 원문 구절', check: 'quote가 그 문서에 그대로 있나', note: '연속 문자열 · 의역은 거부' },
  { title: '③ 주장 지지', check: '인용이 답변을 뒷받침하나', note: '의미 평가 · 검증기 밖', dashed: true },
].map((s, i) => ({ ...s, x: 24 + i * (W + GAP) }));
const MID = Y + H_BOX / 2;

const EX_Y = 176;
const H = 232;
---

<div class="dg">
<svg width="100%" viewBox={`0 0 672 ${H}`} xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="인용 검증은 세 단계다. 출처 식별자가 이번 생성에 넘긴 문서인지, 인용 구절이 그 문서에 그대로 있는지는 문자열로 검사한다. 인용이 답변의 주장을 뒷받침하는지는 의미 평가라 검증기 밖이다. 분기당 30만 원을 정확히 인용하고 매월 50만 원이라고 답하면 앞의 둘은 통과하고 셋째에서 틀린다">

<defs>
  <marker id="ccEnd" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
    <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--muted)"/>
  </marker>
</defs>

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">인용 검증의 세 단계</text>

{steps.map((s) => (
  <>
    <rect x={s.x} y={Y} width={W} height={H_BOX} rx="3" fill={s.dashed ? 'none' : 'var(--bg-soft)'}
          stroke={s.dashed ? 'var(--rule)' : 'var(--ink)'} stroke-width={s.dashed ? 1 : 1.4} stroke-dasharray={s.dashed ? '4 3' : undefined}/>
    <text class="box" x={s.x + 14} y={Y + 24} fill="var(--ink)">{s.title}</text>
    <text class="line" x={s.x + 14} y={Y + 48} fill="var(--body)">{s.check}</text>
    <text class="line" x={s.x + 14} y={Y + 72} fill="var(--muted)">{s.note}</text>
  </>
))}
{steps.slice(0, -1).map((s, i) => (
  <path d={`M ${s.x + W + 2} ${MID} H ${steps[i + 1].x - 3}`} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#ccEnd)"/>
))}

<!-- 예: 앞의 둘은 통과, 셋째에서 틀림 -->
<text class="line" x="24" y={EX_Y} fill="var(--body)">인용 “분기당 30만 원이다” · 답변 “매월 50만 원이다”</text>
{steps.map((s, i) => (
  <>
    <circle cx={s.x + W / 2} cy={EX_Y + 22} r="7" fill={i < 2 ? 'var(--ink)' : 'var(--accent-strong)'}/>
    <text class="ic" x={s.x + W / 2} y={EX_Y + 25.5} text-anchor="middle" fill="var(--bg)">{i < 2 ? '✓' : '✕'}</text>
  </>
))}
<text class="cap" x="336" y={EX_Y + 46} text-anchor="middle" fill="var(--muted)">그래서 통과를 contract_valid라고 부르고 truth_verified라고 부르지 않는다</text>

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .box { font-size: 13px; font-weight: 550; }
.dg .line { font-size: 11px; }
.dg .cap { font-size: 11px; }
.dg .ic { font-size: 9px; font-weight: 700; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
