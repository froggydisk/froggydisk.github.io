---
/**
 * 같은 요청 하나가 단계마다 다른 지표로 채점된다. 검색 후보에서 업무 성공까지 일곱 자리에
 * 무엇을 재는지 적는다. 한 단계의 점수가 다음 단계를 보증하지 않는다.
 */
const BX = 24;
const BW = 210;
const BH = 36;
const TOP = 44;
const STEP = 50;
const steps = [
  { label: '검색 후보', metric: 'Recall@k · MRR', note: '정답 없는 질문은 별도 집계' },
  { label: '최종 문맥', metric: '정답 근거가 실제로 들어갔나', note: '예산 때문에 빠진 것을 잡는다' },
  { label: '생성 완료', metric: '정상 종료 · 출력 한도 · 연결 중단', note: '' },
  { label: '출력 형식', metric: '필수 필드 · 상태 · 인용 구조', note: '' },
  { label: '답변 · 인용 정확성', metric: '주장별 지지 · 모순 · 누락', note: '문자열 존재와 의미 지지를 분리', strong: true },
  { label: '보류 적절성', metric: '답변 가능 / 불가능별 오판', note: '전부 보류해도 점수가 나오는 지표는 금물' },
  { label: '업무 성공', metric: '최종 DB 상태 · 중복 · 권한', note: '', strong: true },
].map((s, i) => ({ ...s, y: TOP + i * STEP }));
const MIDX = BX + BW / 2;
const NX = BX + BW + 22;
const H = steps[6].y + BH + 24; // 418
---

<div class="dg">
<svg width="100%" viewBox={`0 0 672 ${H}`} xmlns="http://www.w3.org/2000/svg" fill="var(--body)" role="img"
     aria-label="한 요청은 검색 후보의 Recall@k와 MRR, 최종 문맥에 정답 근거가 들어갔는지, 생성 완료, 출력 형식, 주장별 답변과 인용 정확성, 답변 가능 여부별 보류 적절성, 최종 DB 상태의 업무 성공 순으로 단계마다 다른 지표로 채점된다. 한 단계의 점수가 다음 단계를 보증하지 않는다">

<defs>
  <marker id="mlEnd" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
    <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--muted)"/>
  </marker>
</defs>

<text class="ttl" x="336" y="18" text-anchor="middle" fill="var(--muted)">한 요청, 일곱 자리의 채점</text>

{steps.map((s, i) => (
  <>
    <rect x={BX} y={s.y} width={BW} height={BH} rx="3" fill="var(--bg-soft)" stroke={s.strong ? 'var(--ink)' : 'var(--rule)'} stroke-width={s.strong ? 1.6 : 1}/>
    <text class="box" x={MIDX} y={s.y + 23} text-anchor="middle" fill="var(--ink)">{s.label}</text>
    <text class="metric" x={NX} y={s.y + (s.note ? 16 : 23)} fill="var(--body)">{s.metric}</text>
    {s.note && <text class="note" x={NX} y={s.y + 31} fill="var(--muted)">{s.note}</text>}
    {i < steps.length - 1 && <path d={`M ${MIDX} ${s.y + BH + 2} V ${s.y + STEP - 3}`} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#mlEnd)"/>}
  </>
))}

</svg>
</div>

<style>
.dg { margin: 2.4rem 0; }
.dg svg { display: block; width: 100%; height: auto; }
.dg text { font-family: var(--font-sans); }
.dg .box { font-size: 12px; font-weight: 550; }
.dg .metric { font-size: 11.5px; }
.dg .note { font-size: 10px; }
.dg .ttl { font-size: 11.5px; letter-spacing: 0.09em; }
@media (max-width: 700px) {
  .dg { overflow-x: auto; }
  .dg svg { min-width: 560px; }
}
</style>
