---
---
<div class="diagram-zoom">
  <div class="diagram-zoom__content">
    <slot />
  </div>
  <!-- 오버레이는 dialog 요소다. .wrapper(z-index:1)에 갇힌 div로는 z-index를 얼마로 줘도
       형제인 .navbar(z-index:3)를 못 넘어서, 확대 화면이 헤더 아래로 깔리고 닫기 버튼이
       햄버거 아이콘의 히트 영역에 먹혔다. showModal()로 띄운 dialog는 top layer라
       조상 스택 컨텍스트와 무관하게 헤더 위에 그려진다. Esc 닫기도 공짜로 얻는다. -->
  <dialog class="diagram-zoom__overlay" aria-label="다이어그램 확대">
    <div class="diagram-zoom__bar">
      <button class="diagram-zoom__close" type="button" aria-label="닫기">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
    </div>
    <div class="diagram-zoom__scroll">
      <div class="diagram-zoom__zoomed"></div>
    </div>
  </dialog>
</div>

<style>
.diagram-zoom {
  position: relative;
}

@media screen and (max-width: 768px) {
  .diagram-zoom__content {
    cursor: zoom-in;
  }
}

.diagram-zoom__overlay {
  /* dialog 기본 스타일(테두리·패딩·auto 폭·중앙 마진)을 전부 걷어낸다 */
  margin: 0;
  padding: 0;
  border: 0;
  max-width: none;
  max-height: none;
  width: 100%;
  height: 100%;
  background: transparent;
  color: #fff;
  overflow: hidden;
}
.diagram-zoom__overlay[open] {
  display: flex;
  flex-direction: column;
}
.diagram-zoom__overlay::backdrop {
  background: rgba(0, 0, 0, 0.85);
  -webkit-backdrop-filter: blur(4px);
  backdrop-filter: blur(4px);
}

/* 닫기 버튼은 다이어그램과 같은 평면에 겹쳐두지 않는다.
   전용 행을 두면 확대된 그림의 우상단을 가리는 일도 없다. */
.diagram-zoom__bar {
  flex: none;
  display: flex;
  justify-content: flex-end;
  padding: 8px 10px 0;
  padding-top: max(8px, env(safe-area-inset-top));
}

.diagram-zoom__close {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.22);
  border-radius: 50%;
  color: #fff;
  cursor: pointer;
  opacity: 0.85;
  -webkit-tap-highlight-color: transparent;
}
.diagram-zoom__close:hover {
  opacity: 1;
}
.diagram-zoom__close:active {
  transform: scale(0.92);
}

.diagram-zoom__scroll {
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: auto;
  -webkit-overflow-scrolling: touch;
  padding: 12px 16px 20px;
  padding-bottom: max(20px, env(safe-area-inset-bottom));
}

.diagram-zoom__zoomed {
  width: max(90vw, 600px);
  margin: auto;
}

.diagram-zoom__zoomed :global(svg) {
  width: 100%;
  height: auto;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const isMobile = () => window.innerWidth <= 768;

  document.querySelectorAll('.diagram-zoom').forEach((wrapper) => {
    const content = wrapper.querySelector('.diagram-zoom__content') as HTMLElement;
    const overlay = wrapper.querySelector('.diagram-zoom__overlay') as HTMLDialogElement;
    const scroll = wrapper.querySelector('.diagram-zoom__scroll') as HTMLElement;
    const zoomed = wrapper.querySelector('.diagram-zoom__zoomed') as HTMLElement;
    const closeBtn = wrapper.querySelector('.diagram-zoom__close') as HTMLElement;

    if (!content || !overlay || !scroll || !zoomed || !closeBtn) return;

    const close = () => {
      if (overlay.open) overlay.close();
    };

    content.addEventListener('click', () => {
      if (!isMobile()) return;
      zoomed.innerHTML = content.innerHTML;
      if (typeof overlay.showModal === 'function') {
        overlay.showModal();
      } else {
        overlay.setAttribute('open', '');
      }
      document.body.style.overflow = 'hidden';
    });

    closeBtn.addEventListener('click', close);

    // 그림 바깥(여백)을 눌러도 닫힌다
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay || e.target === scroll) close();
    });

    // Esc 로 닫히는 경로도 여기로 모인다
    overlay.addEventListener('close', () => {
      document.body.style.overflow = '';
      zoomed.innerHTML = '';
    });
  });
});
</script>
