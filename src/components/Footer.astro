---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-row">
    <a class="letter-image" href="/resume/">
      <div class="animated-mail">
        <div class="back-fold"></div>
        <div class="letter">
          <div class="letter-title"></div>
          <div class="letter-context"></div>
          <div class="letter-stamp"><div class="letter-stamp-inner"></div></div>
        </div>
        <div class="top-fold"></div>
        <div class="body"></div>
        <div class="left-fold"></div>
      </div>
      <span class="letter-label">resume</span>
    </a>
    <span class="footer-sep" aria-hidden="true">&middot;</span>
    <a class="footer_item" href="/privacy-policy/">개인정보처리방침</a>
  </div>
  <small class="footer_copyright">
    &copy; {year} &middot; Powered by <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>
  </small>
</footer>
