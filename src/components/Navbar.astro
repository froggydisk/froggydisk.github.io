---
import { Icon } from 'astro-icon/components';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const menus = [
  { title: 'Home', url: '/', external: false },
  { title: 'Archive', url: '/archive/', external: false },
  { title: 'Projects', url: '/projects/', external: false },
];
---

<div class="navbar" role="navigation">
  <nav class="menu">
    <button id="menu-toggle" class="menu-icon" aria-label="Menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 512 512">
        <path d="M64,384H448V341.33H64Zm0-106.67H448V234.67H64ZM64,128v42.67H448V128Z" />
      </svg>
    </button>
    <a id="mode">
      <Icon name="lucide:sun" class="mode-sunny" size={22} />
      <Icon name="ph:moon" class="mode-moon" size={22} style="stroke: currentColor; stroke-width: 4px;" />
    </a>
    <div class="trigger">
      <div class="trigger-container">
        {menus.map((menu) => (
          menu.external ? (
            <a class="menu-link" href={menu.url} target="_blank" rel="noopener">{menu.title}</a>
          ) : (
            <a class:list={['menu-link', { active: currentPath === menu.url }]} href={menu.url}>{menu.title}</a>
          )
        ))}
        <a class="menu-link rss" href="https://github.com/froggydisk">
          <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 16 16" fill="currentColor">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
          </svg>
        </a>
      </div>
    </div>
  </nav>
</div>

<script>
  const menu = document.querySelector('.menu')!;
  const toggle = document.getElementById('menu-toggle')!;
  const wrapper = document.querySelector('.wrapper');

  // 메뉴 토글
  toggle.addEventListener('click', () => {
    const isOpen = menu.classList.toggle('menu-open');
    if (isOpen) {
      wrapper?.classList.add('blurry');
    } else {
      wrapper?.classList.remove('blurry');
    }
  });

  // 모드 전환: 리로드 없이 제자리에서 바꾼다.
  // (예전엔 location.reload()를 했다. 속성 하나 바꾸면 되는 일에 전체 내비게이션 비용을 냈다.)
  const lamp = document.getElementById('mode');
  let switchTimer: number | undefined;

  lamp?.addEventListener('click', () => {
    const next = localStorage.getItem('theme') === 'dark' ? 'light' : 'dark';
    localStorage.setItem('theme', next);

    // 색 전환용 트랜지션은 이 순간에만 붙인다. 단, 클래스 추가와 테마 변경이
    // 같은 tick에 일어나면 브라우저가 "트랜지션이 있던 이전 상태"를 본 적이 없어서
    // 애니메이션이 걸리지 않는다. offsetWidth를 읽어 스타일을 한 번 확정시킨다.
    document.body.classList.add('theme-switching');
    void document.body.offsetWidth;

    window.clearTimeout(switchTimer);
    switchTimer = window.setTimeout(() => {
      document.body.classList.remove('theme-switching');
    }, 220);

    if (next === 'dark') {
      document.body.setAttribute('data-theme', 'dark');
    } else {
      document.body.removeAttribute('data-theme');
    }

    document
      .getElementById('theme-color-meta')
      ?.setAttribute('content', next === 'dark' ? '#191816' : '#faf9f5');

    // 별 배경처럼 JS로 테마에 반응해야 하는 쪽에 알린다
    document.dispatchEvent(new CustomEvent('themechange', { detail: { theme: next } }));
  });
</script>
