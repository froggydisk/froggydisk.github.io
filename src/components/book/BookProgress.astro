---
// 본문 읽은 비율을 상단 얇은 선으로 보여준다. 책에서는 남은 분량 감각이 있어야 한다.
---

<div class="book-progress" aria-hidden="true"><span id="book-progress-bar"></span></div>

<script>
  // 스크롤 리스너는 문서 수명 내내 하나만 둔다. 요소는 매 페이지 새로 찾는다.
  if (!(window as any).__bookProgress) {
    (window as any).__bookProgress = true;

    let queued = false;

    const paint = () => {
      queued = false;
      const bar = document.getElementById('book-progress-bar');
      const body = document.querySelector<HTMLElement>('.book-body');
      if (!bar || !body) return;

      // 스크롤할 것이 없으면 진행률은 의미가 없다. 0으로 두고 선을 감춘다.
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const start = body.offsetTop;
      const span = body.offsetHeight - window.innerHeight * 0.5;
      if (scrollable < 40 || span <= 0) {
        bar.style.transform = 'scaleX(0)';
        return;
      }

      // 본문 시작부터 끝까지를 0~100%로 본다 (문서 전체 높이가 아니라)
      const ratio = (window.scrollY - start) / span;
      bar.style.transform = `scaleX(${Math.min(1, Math.max(0, ratio))})`;
    };

    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(paint);
    };

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    document.addEventListener('astro:page-load', schedule);
    schedule();
  }
</script>
