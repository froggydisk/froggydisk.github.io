---
import { Icon } from 'astro-icon/components';
---

<div class="support-link-btn">
  <a
    class="w-btn"
    href="https://buymeacoffee.com/froggydisk"
    target="_blank"
    rel="noopener noreferrer"
  >
    <span>Buy me a coffee</span>
    <Icon name="lucide:coffee" size={15} />
  </a>
</div>

<style>
  .support-link-btn {
    text-align: center;
    margin-top: 4.5rem;
  }
  .w-btn,
  :global(.page-content) .w-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.7em 1.4em;
    font-family: inherit;
    font-size: 13.5px;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--accent-strong);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 999px;
    box-shadow: none;
    cursor: pointer;
    text-decoration: none;
    transition: border-color 0.18s ease, color 0.18s ease, background-color 0.18s ease;
  }
  .w-btn:hover,
  :global(.page-content) .w-btn:hover {
    border-color: var(--accent);
    background-color: rgba(204, 120, 92, 0.07);
    color: var(--accent-strong);
    text-decoration: none;
  }
  /* 본문 링크 규칙이 붙이는 외부링크 화살표는 이 버튼에서 제외 */
  :global(.page-content) .w-btn[target="_blank"]::after {
    content: none;
  }
  :global(body[data-theme="dark"]) .w-btn:hover {
    background-color: rgba(217, 131, 106, 0.1);
  }
</style>
