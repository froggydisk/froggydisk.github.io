---
// giscus 댓글.
//
// 예전에는 <script src="giscus.app/client.js" async> 를 그대로 박아뒀다. async 라도
// 요청 자체는 페이지 로드와 함께 나가서, 글을 끝까지 읽지 않는 대부분의 방문자가
// 쓰지도 않는 서드파티 위젯(iframe + 그 안의 리소스)을 내려받았다.
// 댓글은 글 맨 아래에 있으니 거기까지 내려온 사람에게만 불러온다.
---

<section class="comments" id="comments"></section>

<style>
  /* 위젯이 뒤늦게 들어오면서 본문을 밀지 않도록 자리를 미리 잡아둔다 */
  .comments {
    min-height: 150px;
  }
</style>

<script>
  const mount = document.getElementById('comments');

  if (mount) {
    const GISCUS_ORIGIN = 'https://giscus.app';

    // 라이트가 기본 테마인데 전에는 transparent_dark 가 하드코딩돼 있었다
    const themeFor = () =>
      document.body.getAttribute('data-theme') === 'dark' ? 'transparent_dark' : 'light';

    let loaded = false;

    function load() {
      if (loaded) return;
      loaded = true;

      const script = document.createElement('script');
      script.src = `${GISCUS_ORIGIN}/client.js`;
      script.async = true;
      script.crossOrigin = 'anonymous';

      const config: Record<string, string> = {
        repo: 'froggydisk/comment-manager',
        'repo-id': 'R_kgDOG7o-zQ',
        category: 'Announcements',
        'category-id': 'DIC_kwDOG7o-zc4CN6cA',
        mapping: 'pathname',
        'reactions-enabled': '0',
        'emit-metadata': '0',
        'input-position': 'bottom',
        theme: themeFor(),
        lang: 'ko',
      };
      for (const [key, value] of Object.entries(config)) {
        script.setAttribute(`data-${key}`, value);
      }

      mount!.appendChild(script);
    }

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries[0].isIntersecting) return;
          load();
          io.disconnect();
        },
        // 도착하기 조금 전에 미리 불러와서 기다림이 보이지 않게 한다
        { rootMargin: '400px' }
      );
      io.observe(mount);
    } else {
      load();
    }

    // 테마 토글이 더 이상 페이지를 리로드하지 않으므로 iframe 에 직접 알려야 한다
    document.addEventListener('themechange', () => {
      const frame = mount.querySelector('iframe.giscus-frame') as HTMLIFrameElement | null;
      frame?.contentWindow?.postMessage(
        { giscus: { setConfig: { theme: themeFor() } } },
        GISCUS_ORIGIN
      );
    });
  }
</script>
